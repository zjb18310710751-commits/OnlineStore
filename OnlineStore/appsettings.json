{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=OnlineStore_Main;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Database": {
    "RetryCount": 3,
    "MaxRetryDelaySeconds": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Initialization": {
    "RunOnStartup": true,
    "ApplyMigrationsOnStartup": true,
    "InitializationRetryCount": 2,
    "InitializationRetryDelaySeconds": 2,
    "FailFastOnInitializationFailure": false,
    "SeedSampleCatalogOnEmpty": true,
    "AdminEmail": "",
    "AdminPassword": "",
    "SeedDemoData": false,
    "DemoBuyerEmail": "",
    "DemoBuyerPassword": ""
  },
  "Storage": {
    "UploadsPath": ""
  },
  "Session": {
    "Provider": "Memory",
    "SchemaName": "dbo",
    "TableName": "SessionCache"
  },
  "Security": {
    "AuthenticationRateLimit": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Email": {
    "Provider": "Smtp",
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "SenderEmail": "",
    "SenderName": "Online Store",
    "Username": "",
    "Password": "",
    "ApiKey": ""
  }
}
