@model ProductListViewModel
@{
    ViewData["Title"] = Loc["Home"].Value;
}
<section class="hero text-white">
    <div class="container py-5 text-center">
        <h1 class="display-5 fw-bold">@Loc["HeroTitle"]</h1>
        <p class="lead mb-4">@Loc["HeroSubtitle"]</p>
        <form asp-controller="Products" asp-action="Index" method="get" class="d-flex mb-4" style="max-width:480px;margin:0 auto;">
            <input class="form-control form-control-lg me-2" type="search" name="searchTerm" placeholder="@Loc["SearchPlaceholder"]" aria-label="Search" />
            <button class="btn search-btn-amazon btn-lg" type="submit"><i class="bi bi-search"></i></button>
        </form>
        <a class="btn btn-primary btn-lg px-4" asp-controller="Products" asp-action="Index">@Loc["StartShopping"]</a>
    </div>
</section>

@if (Model.SaleItems.Count > 0)
{
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 mb-0"><i class="bi bi-lightning-charge-fill text-danger me-1"></i>@Loc["LimitedTimeDiscount"]</h2>
        </div>
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
            @foreach (var product in Model.SaleItems)
            {
                <partial name="_ProductCard" model="@product" />
            }
        </div>
    </div>
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">@Loc["NewArrivals"]</h2>
        <a asp-controller="Products" asp-action="Index" class="btn btn-sm btn-outline-primary">@Loc["ViewAll"]</a>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="alert alert-light border text-center py-5">@Loc["NoProducts"]</div>
    }
    else
    {
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
            @foreach (var product in Model.Items)
            {
                <partial name="_ProductCard" model="@product" />
            }
        </div>
    }
</div>
