@model ProductListViewModel
@{
    ViewData["Title"] = Loc["Home"].Value;
}
@await Component.InvokeAsync("HeroCarousel")
<section class="sf-product-section sf-container sf-home-products">
    <div class="sf-section-heading"><h2>@Loc["NewArrivals"]</h2><a asp-controller="Products" asp-action="Index" asp-route-sortBy="newest">@Loc["ViewAll"] <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
    @if (Model.Items.Count == 0)
    {
        <p class="sf-empty">@Loc["NoProducts"]</p>
    }
    else
    {
        <div class="row row-cols-2 row-cols-lg-4 sf-product-grid">
            @foreach (var product in Model.Items) { <partial name="_ProductCard" model="@product" /> }
        </div>
    }
</section>
@if (Model.SaleItems.Count > 0)
{
    <section class="sf-product-section sf-container">
        <div class="sf-section-heading"><h2>@Loc["LimitedTimeDiscount"]</h2><a asp-controller="Products" asp-action="Index">@Loc["ViewAll"] <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
        <div class="row row-cols-2 row-cols-lg-4 sf-product-grid">
            @foreach (var product in Model.SaleItems) { <partial name="_ProductCard" model="@product" /> }
        </div>
    </section>
}
@section Scripts {
    <script src="~/js/hero-carousel.js" asp-append-version="true"></script>
}
