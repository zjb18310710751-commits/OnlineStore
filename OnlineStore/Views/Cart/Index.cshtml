@model Cart
@{
    ViewData["Title"] = Loc["ShoppingCart"].Value;
}
<div class="container coupon-wallet-page member-cart-page">
    <header class="coupon-wallet-header">
        <div>
            <p class="coupon-wallet-eyebrow">@L10n.Text("账户中心", "Member account")</p>
            <h1>@Loc["ShoppingCart"]</h1>
            <p>@L10n.Text("确认商品与数量，然后继续结算。", "Review your items and quantities before checkout.")</p>
        </div>
        <div class="coupon-wallet-count">
            <strong>@Model.TotalItems</strong>
            <span>@L10n.Text("件商品", "items")</span>
        </div>
    </header>

    @if (Model.Items.Count == 0)
    {
        <section class="coupon-wallet-empty">
            <i class="bi bi-cart-x"></i>
            <h2>@Loc["EmptyCart"]</h2>
            <p>@L10n.Text("购物车还是空的，去看看今天的精选商品。", "Your cart is empty. Explore today's picks.")</p>
            <a asp-controller="Products" asp-action="Index" class="sf-button">@Loc["ContinueShopping"]</a>
        </section>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card cart-products-card member-cart-products-card">
                    <div class="cart-product-grid cart-product-header" aria-hidden="true">
                        <div>@Loc["Products"]</div>
                        <div>@Loc["Price"]</div>
                        <div>@Loc["Quantity"]</div>
                        <div class="text-end">@Loc["Subtotal"]</div>
                    </div>
                    <ul class="list-group list-group-flush">
                        @foreach (var item in Model.Items)
                        {
                            var quantityErrorId = $"cartQuantityError_{item.ProductId}_{item.SkuId ?? 0}";
                            <li class="list-group-item cart-product-row">
                                <div class="cart-product-grid">
                                    <div class="cart-product-main">
                                        <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId" class="d-block cart-thumb d-flex align-items-center justify-content-center">
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-image"></i>
                                            }
                                        </a>
                                        <div class="cart-product-info">
                                            <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId" class="fw-semibold text-decoration-none text-dark">@L10n.Text(item.Name, item.NameEn)</a>
                                            @if (!string.IsNullOrEmpty(item.Color) || !string.IsNullOrEmpty(item.Spec))
                                            {
                                                <div class="text-muted small mt-1">@Loc["Spec"]：@L10n.Text(item.Color ?? "", item.ColorEn) @L10n.Text(item.Spec ?? "", item.SpecEn)</div>
                                            }
                                            <div class="text-muted small">@Loc["StockLimit", item.Stock]</div>
                                        </div>
                                    </div>

                                    <div class="cart-price">
                                        <span class="cart-mobile-label">@Loc["Price"]</span>
                                        <span>¥@item.Price.ToString("F2")</span>
                                    </div>

                                    <div class="cart-quantity">
                                        <span class="cart-mobile-label">@Loc["Quantity"]</span>
                                        <div class="cart-quantity-controls">
                                            <form asp-controller="Cart" asp-action="Update" method="post" class="cart-quantity-form" novalidate>
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <input type="hidden" name="skuId" value="@item.SkuId" />
                                                <input type="number" name="quantity" class="form-control form-control-sm cart-quantity-input text-center"
                                                       value="@item.Quantity" min="1" max="@item.Stock" step="1" inputmode="numeric"
                                                       required aria-describedby="@quantityErrorId" aria-label="@Loc["Quantity"].Value" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary">@Loc["Update"]</button>
                                                <button type="submit" class="btn btn-sm btn-link text-danger cart-remove-button"
                                                        formaction="@Url.Action("Remove", "Cart")">
                                                    @Loc["Remove"]
                                                </button>
                                            </form>
                                            <div id="@quantityErrorId" class="text-danger small cart-quantity-error d-none" role="alert">
                                                @Loc["CartQuantityRequired"]
                                            </div>
                                        </div>
                                    </div>

                                    <div class="cart-line-total text-end">
                                        <span class="cart-mobile-label">@Loc["Subtotal"]</span>
                                        <span class="price">¥@item.LineTotal.ToString("F2")</span>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
                <form asp-controller="Cart" asp-action="Clear" method="post" class="mt-2"
                      data-confirm="@Loc["ConfirmClearCart"].Value" onsubmit="return confirm(this.dataset.confirm);">
                    <button type="submit" class="btn btn-link text-muted p-0 text-decoration-none">
                        @Loc["ClearCart"]
                    </button>
                </form>
            </div>

            <div class="col-lg-4">
                <div class="card cart-summary-card member-cart-summary-card">
                    <div class="card-header fw-semibold">@Loc["OrderSummary"]</div>
                    <div class="card-body">
                        <div class="cart-summary-line">
                            <span>@Loc["Subtotal"]</span>
                            <span>¥@Model.Total.ToString("F2")</span>
                        </div>
                        <div class="cart-summary-line">
                            <span>@Loc["ShippingFee"]</span>
                            <span>@Loc["FreeShipping"]</span>
                        </div>
                        <div class="cart-summary-line cart-summary-total">
                            <span>@Loc["Total"]</span>
                            <span class="price fs-5">¥@Model.Total.ToString("F2")</span>
                        </div>
                        <a asp-controller="Orders" asp-action="Checkout" class="btn btn-amazon btn-lg w-100 mt-4"><i class="bi bi-bag-check me-1"></i>@Loc["Checkout"]</a>
                        <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">@Loc["ContinueShopping"]</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.cart-quantity-form').forEach(function (form) {
                var input = form.querySelector('input[name="quantity"]');
                var error = document.getElementById(input.getAttribute('aria-describedby'));

                input.addEventListener('input', function () {
                    input.classList.remove('is-invalid');
                    if (error) error.classList.add('d-none');
                });

                form.addEventListener('submit', function (event) {
                    if (event.submitter && event.submitter.hasAttribute('formaction')) {
                        return;
                    }

                    var rawValue = input.value.trim();
                    var quantity = Number(rawValue);
                    if (!rawValue || !Number.isInteger(quantity) || quantity < 1) {
                        event.preventDefault();
                        input.classList.add('is-invalid');
                        if (error) error.classList.remove('d-none');
                        input.focus();
                    }
                });
            });
        });
    </script>
}
