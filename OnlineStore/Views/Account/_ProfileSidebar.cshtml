@model ProfileSidebarViewModel
<aside class="profile-sidebar">
    <div class="card shadow-sm profile-sidebar-card mb-3">
        <div class="card-body text-center">
            <div class="profile-avatar mx-auto mb-3">
                <i class="bi bi-person"></i>
            </div>
            <h2 class="h5 mb-1">@Model.DisplayName</h2>
            <div class="text-muted small text-break">@Model.Email</div>
            <div class="text-muted small mt-2 text-break">@Model.UserName</div>
        </div>
    </div>

    <div class="list-group profile-nav shadow-sm">
        <a asp-controller="Account" asp-action="Profile"
           class="list-group-item list-group-item-action @(Model.ActiveSection == "basic" ? "active" : "")">
            <i class="bi bi-person-lines-fill me-2"></i>@Loc["BasicPersonalInformation"]
        </a>
        <a asp-controller="Account" asp-action="ChangePassword"
           class="list-group-item list-group-item-action @(Model.ActiveSection == "password" ? "active" : "")">
            <i class="bi bi-shield-lock me-2"></i>@Loc["ChangePassword"]
        </a>
        <a asp-controller="Account" asp-action="ChangeAddress"
           class="list-group-item list-group-item-action @(Model.ActiveSection == "address" ? "active" : "")">
            <i class="bi bi-geo-alt me-2"></i>@Loc["ChangeAddress"]
        </a>
    </div>
</aside>
