@model ProfileViewModel
@{
    ViewData["Title"] = Loc["Profile"].Value;
}
<div class="container py-4">
    <div class="row g-4">
        <div class="col-lg-3">
            <partial name="_ProfileSidebar" model="Model" />
        </div>
        <div class="col-lg-9">
            <section class="card shadow-sm profile-section-card">
                <div class="card-header bg-white">
                    <div class="profile-section-heading">
                        <div>
                            <h1 class="profile-section-title">@Loc["BasicPersonalInformation"]</h1>
                            <p class="profile-section-subtitle mb-0">@Loc["BasicPersonalInformationHint"]</p>
                        </div>
                        <span class="badge bg-light text-dark border">@Loc["ProfileDetails"]</span>
                    </div>
                </div>
                <div class="card-body">
                    <form method="post" asp-controller="Account" asp-action="Profile">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="UserName" class="form-label">@Loc["UsernameLabel"]</label>
                                <input asp-for="UserName" class="form-control profile-readonly-input" disabled />
                                <div class="form-text">@Loc["UsernameImmutableHint"]</div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label">@Loc["EmailAddress"]</label>
                                <input asp-for="Email" class="form-control profile-readonly-input" disabled />
                                <div class="form-text">@Loc["EmailImmutableHint"]</div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label">@Loc["FirstName"]</label>
                                <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label">@Loc["LastName"]</label>
                                <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="PhoneNumber" class="form-label">@Loc["PhoneNumber"]</label>
                                <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            <button type="submit" class="btn btn-primary">@Loc["Save"]</button>
                        </div>
                    </form>
                </div>
            </section>
        </div>
    </div>
</div>
