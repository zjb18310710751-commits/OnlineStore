@model ChangePasswordViewModel
@{
    ViewData["Title"] = Loc["ChangePassword"].Value;
}
<div class="container py-4 profile-account-page">
    <div class="row g-4">
        <div class="col-lg-3">
            <partial name="_ProfileSidebar" model="Model" />
        </div>
        <div class="col-lg-9">
            <section class="card shadow-sm profile-section-card profile-account-panel">
                <div class="card-header bg-white">
                    <h1 class="profile-section-title">@Loc["ChangePassword"]</h1>
                    <p class="profile-section-subtitle mb-0">@Loc["ChangePasswordHint"]</p>
                </div>
                <div class="card-body">
                    <form method="post" asp-controller="Account" asp-action="ChangePassword">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="RegisteredEmail" class="form-label">@Loc["RegisteredEmailAddress"]</label>
                            <div class="input-group">
                                <input asp-for="RegisteredEmail" class="form-control" autocomplete="email" />
                                <button type="button" class="btn btn-outline-primary"
                                        data-send-code-url="@Url.Action("SendProfileEmailCode", "Account")"
                                        data-send-code-purpose="profile-email"
                                        data-send-code-channel="email"
                                        data-send-code-target="#RegisteredEmail"
                                        data-send-code-status="#profileEmailCodeStatus"
                                        data-send-code-success="@Loc["SendCodeSuccess"].Value"
                                        data-send-code-failed="@Loc["SendCodeFailed"].Value"
                                        data-send-code-invalid="@Loc["InvalidEmail"].Value"
                                        data-send-code-label="@Loc["SendVerificationCode"].Value"
                                        data-send-code-demo="@Loc["DemoCode"].Value">@Loc["SendVerificationCode"]</button>
                            </div>
                            <div id="profileEmailCodeStatus" class="form-text"></div>
                            <span asp-validation-for="RegisteredEmail" class="text-danger small"></span>
                            <div class="form-text">@Loc["RegisteredEmailHint"]</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="VerificationCode" class="form-label">@Loc["VerificationCode"]</label>
                            <input asp-for="VerificationCode" class="form-control" inputmode="numeric" maxlength="6" autocomplete="one-time-code" />
                            <span asp-validation-for="VerificationCode" class="text-danger small"></span>
                            <div class="form-text">@Loc["VerificationCodeHint"]</div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="NewPassword" class="form-label">@Loc["NewPassword"]</label>
                                <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label">@Loc["ConfirmPassword"]</label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="form-text mt-2">@Loc["RegisterHint"]</div>

                        <div class="d-flex justify-content-end mt-4">
                            <button type="submit" class="btn btn-primary">@Loc["UpdatePassword"]</button>
                        </div>
                    </form>
                </div>
            </section>
        </div>
    </div>
</div>
