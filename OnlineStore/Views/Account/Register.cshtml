@model RegisterViewModel
@{
    ViewData["Title"] = Loc["RegisterTitle"].Value;
    var isPhone = false;
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h4 mb-3 text-center">@Loc["RegisterTitle"]</h1>

                    <ul class="nav nav-pills nav-fill mb-3" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(isPhone ? "" : "active")" id="email-register-tab" data-bs-toggle="pill" data-bs-target="#email-register" type="button" role="tab" aria-selected="@(!isPhone)">@Loc["EmailRegister"]</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="phone-register-tab" type="button" role="tab" aria-selected="false" disabled
                                    title="@L10n.Text("短信验证暂不可用，请使用邮箱注册。", "SMS verification is unavailable. Please register with email.")">@Loc["PhoneRegister"]</button>
                        </li>
                    </ul>

                    <form id="registerForm" method="post" asp-controller="Account" asp-action="Register">
                        <input type="hidden" id="RegisterBy" name="RegisterBy" value="email" />
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="tab-content">
                            <div class="tab-pane fade @(isPhone ? "" : "show active")" id="email-register" role="tabpanel" aria-labelledby="email-register-tab">
                                <div class="mb-3">
                                    <label asp-for="Email" class="form-label">@Loc["Email"]</label>
                                    <div class="input-group">
                                        <input asp-for="Email" class="form-control" autocomplete="username" />
                                        <button type="button" class="btn btn-outline-primary"
                                                data-send-code-url="@Url.Action("SendCode", "Account")"
                                                data-send-code-purpose="register"
                                                data-send-code-channel="email"
                                                data-send-code-target="#Email"
                                                data-send-code-status="#emailSendCodeStatus"
                                                data-send-code-success="@Loc["SendCodeSuccess"].Value"
                                                data-send-code-failed="@Loc["SendCodeFailed"].Value"
                                                data-send-code-invalid="@Loc["InvalidEmail"].Value"
                                                data-send-code-label="@Loc["SendVerificationCode"].Value"
                                                data-send-code-demo="@Loc["DemoCode"].Value">@Loc["SendVerificationCode"]</button>
                                    </div>
                                    <div id="emailSendCodeStatus" class="form-text"></div>
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="tab-pane fade @(isPhone ? "show active" : "")" id="phone-register" role="tabpanel" aria-labelledby="phone-register-tab">
                                <div class="mb-3">
                                    <label asp-for="PhoneNumber" class="form-label">@Loc["PhoneNumber"]</label>
                                    <div class="input-group">
                                        <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" />
                                        <button type="button" class="btn btn-outline-primary"
                                                data-send-code-url="@Url.Action("SendCode", "Account")"
                                                data-send-code-purpose="register"
                                                data-send-code-channel="sms"
                                                data-send-code-target="#PhoneNumber"
                                                data-send-code-status="#phoneSendCodeStatus"
                                                data-send-code-success="@Loc["SendCodeSuccess"].Value"
                                                data-send-code-failed="@Loc["SendCodeFailed"].Value"
                                                data-send-code-invalid="@Loc["InvalidPhone"].Value"
                                                data-send-code-label="@Loc["SendVerificationCode"].Value"
                                                data-send-code-demo="@Loc["DemoCode"].Value">@Loc["SendVerificationCode"]</button>
                                    </div>
                                    <div id="phoneSendCodeStatus" class="form-text"></div>
                                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="VerificationCode" class="form-label">@Loc["VerificationCode"]</label>
                            <input asp-for="VerificationCode" class="form-control" autocomplete="one-time-code" />
                            <span asp-validation-for="VerificationCode" class="text-danger small"></span>
                        </div>
                        <div class="row g-3 mb-1">
                            <div class="col-6">
                                <label asp-for="FirstName" class="form-label">@Loc["FirstName"]</label>
                                <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-6">
                                <label asp-for="LastName" class="form-label">@Loc["LastName"]</label>
                                <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@Loc["Address"]</label>
                            <button type="button" class="register-address-trigger"
                                    data-bs-toggle="modal" data-bs-target="#registerAddressModal">
                                <span id="registerAddressSummary">
                                    @(string.IsNullOrWhiteSpace(Model.Address) ? Loc["AddAddress"].Value : Model.Address)
                                </span>
                                <i class="bi bi-chevron-right"></i>
                            </button>
                            <input asp-for="Address" id="registerAddressHidden" type="hidden" autocomplete="street-address" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">@Loc["Password"]</label>
                            <input asp-for="Password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">@Loc["ConfirmPassword"]</label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">@Loc["Register"]</button>
                    </form>
                </div>
            </div>
            <p class="text-center small mt-3">
                @Loc["HaveAccount"] <a asp-controller="Account" asp-action="Login">@Loc["Login"]</a>
            </p>
            <p class="text-center text-muted small mt-2">@Loc["RegisterHint"]</p>
        </div>
    </div>
</div>

<div class="modal fade address-modal register-address-modal" id="registerAddressModal" tabindex="-1"
     aria-labelledby="registerAddressModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <span class="address-modal-kicker">@Loc["AddressDetails"]</span>
                    <h2 class="modal-title" id="registerAddressModalTitle">@Loc["AddAddress"]</h2>
                    <p class="address-modal-subtitle mb-0">@Loc["RegisterAddressHint"]</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Loc["Cancel"]"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-12">
                        <label for="registerAddressLine1" class="form-label">
                            @Loc["AddressLine1"] <span class="address-required">*</span>
                        </label>
                        <input asp-for="AddressLine1" id="registerAddressLine1" form="registerForm" maxlength="200" class="form-control address-form-control"
                               autocomplete="address-line1"
                               placeholder="@Loc["AddressLine1"]" />
                    </div>
                    <div class="col-12">
                        <label for="registerAddressLine2" class="form-label">@Loc["AddressLine2Optional"]</label>
                        <input asp-for="AddressLine2" id="registerAddressLine2" form="registerForm" maxlength="200" class="form-control address-form-control"
                               autocomplete="address-line2"
                               placeholder="@Loc["AddressLine2Optional"]" />
                    </div>
                    <div class="col-6 col-md-4">
                        <label for="registerAddressCity" class="form-label">
                            @Loc["City"] <span class="address-required">*</span>
                        </label>
                        <input asp-for="City" id="registerAddressCity" form="registerForm" maxlength="100" class="form-control address-form-control"
                               autocomplete="address-level2"
                               placeholder="@Loc["City"]" />
                    </div>
                    <div class="col-6 col-md-4">
                        <label for="registerAddressPostal" class="form-label">
                            @Loc["PostalCode"] <span class="address-required">*</span>
                        </label>
                        <input asp-for="PostalCode" id="registerAddressPostal" form="registerForm" maxlength="100" class="form-control address-form-control"
                               autocomplete="postal-code"
                               placeholder="@Loc["PostalCode"]" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="registerAddressCountry" class="form-label">
                            @Loc["Country"] <span class="address-required">*</span>
                        </label>
                        <input asp-for="Country" id="registerAddressCountry" form="registerForm" maxlength="100" class="form-control address-form-control"
                               autocomplete="country-name"
                               placeholder="@Loc["Country"]" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn address-modal-cancel" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                <button type="button" id="registerAddressSave" class="btn btn-primary address-modal-save">
                    <i class="bi bi-check2 me-1"></i>@Loc["UpdateAddress"]
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('#email-register-tab, #phone-register-tab').forEach(function (btn) {
                btn.addEventListener('shown.bs.tab', function () {
                    var registerBy = document.getElementById('RegisterBy');
                    if (registerBy) {
                        registerBy.value = btn.id === 'email-register-tab' ? 'email' : 'phone';
                    }
                });
            });

            var addressModal = document.getElementById('registerAddressModal');
            document.getElementById('registerAddressSave').addEventListener('click', function () {
                var parts = [
                    document.getElementById('registerAddressLine1').value,
                    document.getElementById('registerAddressLine2').value,
                    document.getElementById('registerAddressCity').value,
                    document.getElementById('registerAddressPostal').value,
                    document.getElementById('registerAddressCountry').value
                ].map(function (value) { return value.trim(); }).filter(Boolean);

                document.getElementById('registerAddressHidden').value = parts.join(', ');
                document.getElementById('registerAddressSummary').textContent = parts.join(', ') || '@Loc["AddAddress"]';
                bootstrap.Modal.getOrCreateInstance(addressModal).hide();
            });
        });
    </script>
}
