@model RegisterViewModel
@{
    ViewData["Title"] = Loc["RegisterTitle"].Value;
}
<div class="account-auth-page">
    <div class="account-auth-panel">
        <header class="account-auth-header">
            <a class="account-auth-wordmark" asp-controller="Home" asp-action="Index" aria-label="ZHY">ZHY.</a>
            <h1 class="account-auth-title">@L10n.Text("创建你的账户，收藏喜欢的好物。", "Create your account and start saving favourites.")</h1>
            <p class="account-auth-subtitle">@L10n.Text("填写信息并验证邮箱，订单与常用地址会自动同步。", "Fill in your details and verify your email. Orders and saved addresses will stay in sync.")</p>
        </header>

        <form id="registerForm" class="account-auth-form" method="post" asp-controller="Account" asp-action="Register">
            <input type="hidden" id="RegisterBy" name="RegisterBy" value="email" />
            <div asp-validation-summary="All" class="text-danger"></div>

            <div>
                <label asp-for="Email" class="account-auth-label">@Loc["Email"]</label>
                <div class="input-group">
                    <input asp-for="Email" class="form-control account-auth-control" autocomplete="username" />
                    <button type="button" class="btn btn-outline-primary account-auth-code-button"
                            data-send-code-url="@Url.Action("SendCode", "Account")"
                            data-send-code-purpose="register"
                            data-send-code-channel="email"
                            data-send-code-target="#Email"
                            data-send-code-status="#emailSendCodeStatus"
                            data-send-code-success="@Loc["SendCodeSuccess"].Value"
                            data-send-code-failed="@Loc["SendCodeFailed"].Value"
                            data-send-code-invalid="@Loc["InvalidEmail"].Value"
                            data-send-code-label="@Loc["SendVerificationCode"].Value"
                            data-send-code-demo="@Loc["DemoCode"].Value">@Loc["SendVerificationCode"]</button>
                </div>
                <div id="emailSendCodeStatus" class="form-text"></div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="account-auth-code-field">
                <label asp-for="VerificationCode" class="account-auth-label">@Loc["VerificationCode"]</label>
                <input asp-for="VerificationCode" class="form-control account-auth-control" inputmode="numeric" maxlength="6" autocomplete="one-time-code" />
                <span asp-validation-for="VerificationCode" class="text-danger small"></span>
            </div>

            <div class="row g-3">
                <div class="col-6">
                    <label asp-for="FirstName" class="account-auth-label">@Loc["FirstName"]</label>
                    <input asp-for="FirstName" class="form-control account-auth-control" autocomplete="given-name" />
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>
                <div class="col-6">
                    <label asp-for="LastName" class="account-auth-label">@Loc["LastName"]</label>
                    <input asp-for="LastName" class="form-control account-auth-control" autocomplete="family-name" />
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>
            </div>

            <div>
                <label asp-for="Password" class="account-auth-label">@Loc["Password"]</label>
                <div class="password-field">
                    <input asp-for="Password" class="form-control account-auth-control" autocomplete="new-password" />
                    <button type="button" class="password-toggle" data-password-target="Password"
                            data-show-label="@L10n.Text("显示密码", "Show password")"
                            data-hide-label="@L10n.Text("隐藏密码", "Hide password")"
                            aria-label="@L10n.Text("显示密码", "Show password")" aria-pressed="false">
                        <i class="bi bi-eye" aria-hidden="true"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="account-auth-label">@Loc["ConfirmPassword"]</label>
                <div class="password-field">
                    <input asp-for="ConfirmPassword" class="form-control account-auth-control" autocomplete="new-password" />
                    <button type="button" class="password-toggle" data-password-target="ConfirmPassword"
                            data-show-label="@L10n.Text("显示密码", "Show password")"
                            data-hide-label="@L10n.Text("隐藏密码", "Hide password")"
                            aria-label="@L10n.Text("显示密码", "Show password")" aria-pressed="false">
                        <i class="bi bi-eye" aria-hidden="true"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <div>
                <label class="account-auth-label">@Loc["Address"]</label>
                <button type="button" class="account-auth-address-trigger"
                        data-bs-toggle="modal" data-bs-target="#registerAddressModal">
                    <span id="registerAddressSummary">
                        @(string.IsNullOrWhiteSpace(Model.Address) ? Loc["AddAddress"].Value : Model.Address)
                    </span>
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </button>
                <input asp-for="Address" id="registerAddressHidden" type="hidden" autocomplete="street-address" />
                <span asp-validation-for="Address" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary account-auth-submit">@Loc["Register"]</button>
            <p class="account-auth-hint">@Loc["RegisterHint"]</p>
        </form>

        <p class="account-auth-footer">
            @Loc["HaveAccount"] <a asp-controller="Account" asp-action="Login">@Loc["Login"]</a>
        </p>
    </div>
</div>

<div class="modal fade address-modal register-address-modal" id="registerAddressModal" tabindex="-1"
     aria-labelledby="registerAddressModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <span class="address-modal-kicker">@Loc["AddressDetails"]</span>
                    <h2 class="modal-title" id="registerAddressModalTitle">@Loc["AddAddress"]</h2>
                    <p class="address-modal-subtitle mb-0">@Loc["RegisterAddressHint"]</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Loc["Cancel"]"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-12">
                        <label for="registerAddressLine1" class="form-label">
                            @Loc["AddressLine1"] <span class="address-required">*</span>
                        </label>
                        <input asp-for="AddressLine1" id="registerAddressLine1" form="registerForm" maxlength="200" class="form-control address-form-control"
                               autocomplete="address-line1"
                               placeholder="@Loc["AddressLine1"]" />
                    </div>
                    <div class="col-12">
                        <label for="registerAddressLine2" class="form-label">@Loc["AddressLine2Optional"]</label>
                        <input asp-for="AddressLine2" id="registerAddressLine2" form="registerForm" maxlength="200" class="form-control address-form-control"
                               autocomplete="address-line2"
                               placeholder="@Loc["AddressLine2Optional"]" />
                    </div>
                    <div class="col-6 col-md-4">
                        <label for="registerAddressCity" class="form-label">
                            @Loc["City"] <span class="address-required">*</span>
                        </label>
                        <input asp-for="City" id="registerAddressCity" form="registerForm" maxlength="100" class="form-control address-form-control"
                               autocomplete="address-level2"
                               placeholder="@Loc["City"]" />
                    </div>
                    <div class="col-6 col-md-4">
                        <label for="registerAddressPostal" class="form-label">
                            @Loc["PostalCode"] <span class="address-required">*</span>
                        </label>
                        <input asp-for="PostalCode" id="registerAddressPostal" form="registerForm" maxlength="100" class="form-control address-form-control"
                               autocomplete="postal-code"
                               placeholder="@Loc["PostalCode"]" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="registerAddressCountry" class="form-label">
                            @Loc["Country"] <span class="address-required">*</span>
                        </label>
                        <input asp-for="Country" id="registerAddressCountry" form="registerForm" maxlength="100" class="form-control address-form-control"
                               autocomplete="country-name"
                               placeholder="@Loc["Country"]" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn address-modal-cancel" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                <button type="button" id="registerAddressSave" class="btn btn-primary address-modal-save">
                    <i class="bi bi-check2 me-1"></i>@Loc["UpdateAddress"]
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var addressModal = document.getElementById('registerAddressModal');
            document.getElementById('registerAddressSave').addEventListener('click', function () {
                var parts = [
                    document.getElementById('registerAddressLine1').value,
                    document.getElementById('registerAddressLine2').value,
                    document.getElementById('registerAddressCity').value,
                    document.getElementById('registerAddressPostal').value,
                    document.getElementById('registerAddressCountry').value
                ].map(function (value) { return value.trim(); }).filter(Boolean);

                document.getElementById('registerAddressHidden').value = parts.join(', ');
                document.getElementById('registerAddressSummary').textContent = parts.join(', ') || '@Loc["AddAddress"]';
                bootstrap.Modal.getOrCreateInstance(addressModal).hide();
            });
        });
    </script>
}
