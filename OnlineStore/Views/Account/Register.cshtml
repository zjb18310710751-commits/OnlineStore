@model RegisterViewModel
@{
    ViewData["Title"] = Loc["RegisterTitle"].Value;
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h4 mb-3 text-center">@Loc["RegisterTitle"]</h1>
                    <form method="post" asp-controller="Account" asp-action="Register">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">@Loc["Email"]</label>
                            <div class="input-group">
                                <input asp-for="Email" class="form-control" autocomplete="username" />
                                <button type="button" class="btn btn-outline-primary"
                                        data-send-code-url="@Url.Action("SendCode", "Account")"
                                        data-send-code-purpose="register"
                                        data-send-code-email="#Email"
                                        data-send-code-status="#sendCodeStatus"
                                        data-send-code-success="@Loc["SendCodeSuccess"].Value"
                                        data-send-code-failed="@Loc["SendCodeFailed"].Value"
                                        data-send-code-invalid="@Loc["InvalidEmail"].Value"
                                        data-send-code-label="@Loc["SendVerificationCode"].Value">@Loc["SendVerificationCode"]</button>
                            </div>
                            <div id="sendCodeStatus" class="form-text"></div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="VerificationCode" class="form-label">@Loc["VerificationCode"]</label>
                            <input asp-for="VerificationCode" class="form-control" autocomplete="one-time-code" />
                            <span asp-validation-for="VerificationCode" class="text-danger small"></span>
                        </div>
                        <div class="row g-3 mb-1">
                            <div class="col-6">
                                <label asp-for="FirstName" class="form-label">@Loc["FirstName"]</label>
                                <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-6">
                                <label asp-for="LastName" class="form-label">@Loc["LastName"]</label>
                                <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Address" class="form-label">@Loc["Address"]</label>
                            <input asp-for="Address" class="form-control" autocomplete="street-address" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label">@Loc["PhoneNumber"]</label>
                            <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">@Loc["Password"]</label>
                            <input asp-for="Password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">@Loc["ConfirmPassword"]</label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">@Loc["Register"]</button>
                    </form>
                </div>
            </div>
            <p class="text-center small mt-3">
                @Loc["HaveAccount"] <a asp-controller="Account" asp-action="Login">@Loc["Login"]</a>
            </p>
            <p class="text-center text-muted small mt-2">@Loc["RegisterHint"]</p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
