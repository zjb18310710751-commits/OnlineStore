@model LoginViewModel
@{
    ViewData["Title"] = Loc["Login"].Value;
    var returnUrl = ViewData["ReturnUrl"] as string;
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h4 mb-3 text-center">@Loc["AdminLogin"]</h1>
                    <form method="post" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">@Loc["Email"]</label>
                            <input asp-for="Email" class="form-control" autocomplete="username" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">@Loc["Password"]</label>
                            <input asp-for="Password" class="form-control" autocomplete="current-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="form-check mb-3">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label">@Loc["RememberMe"]</label>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">@Loc["Login"]</button>
                    </form>
                </div>
            </div>
            <p class="text-center text-muted small mt-3">@Loc["LoginHint"]</p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
