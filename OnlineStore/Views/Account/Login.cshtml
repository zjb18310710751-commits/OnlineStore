@model LoginViewModel
@{
    ViewData["Title"] = Loc["Login"].Value;
    var returnUrl = ViewData["ReturnUrl"] as string;
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h4 mb-3 text-center">@Loc["Login"]</h1>
                    <form method="post" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">@Loc["EmailOrPhone"]</label>
                            <input asp-for="Email" class="form-control" autocomplete="username" placeholder="@Loc["EmailOrPhone"]" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">@Loc["Password"]</label>
                            <input asp-for="Password" class="form-control" autocomplete="current-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="form-check mb-3">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label">@Loc["RememberMe"]</label>
                        </div>
                        <div class="form-check mb-3">
                            <input asp-for="RememberCredentials" class="form-check-input" />
                            <label asp-for="RememberCredentials" class="form-check-label">@Loc["RememberCredentials"]</label>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">@Loc["Login"]</button>
                        <div class="text-end mt-2">
                            <a asp-controller="Account" asp-action="ForgotPassword" class="small text-muted">@Loc["ForgotPassword"]</a>
                        </div>
                    </form>
                </div>
            </div>
            <p class="text-center small mt-3">
                @Loc["NoAccount"] <a asp-controller="Account" asp-action="Register">@Loc["Register"]</a>
            </p>
            <p class="text-center small mt-2">
                <a asp-area="Admin" asp-controller="Account" asp-action="Login"><i class="bi bi-shield-lock me-1"></i>@Loc["AdminLogin"]</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
