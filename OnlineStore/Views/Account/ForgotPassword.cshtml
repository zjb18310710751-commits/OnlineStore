@model ForgotPasswordViewModel
@{
    ViewData["Title"] = Loc["ForgotPassword"].Value;
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h4 mb-3 text-center">@Loc["ForgotPassword"]</h1>
                    <form method="post" asp-controller="Account" asp-action="ForgotPassword">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">@Loc["Email"]</label>
                            <div class="input-group">
                                <input asp-for="Email" class="form-control" autocomplete="username" />
                                <button type="button" class="btn btn-outline-primary"
                                        data-send-code-url="@Url.Action("SendCode", "Account")"
                                        data-send-code-purpose="reset"
                                        data-send-code-email="#Email"
                                        data-send-code-status="#sendCodeStatus"
                                        data-send-code-success="@Loc["SendCodeSuccess"].Value"
                                        data-send-code-failed="@Loc["SendCodeFailed"].Value"
                                        data-send-code-invalid="@Loc["InvalidEmail"].Value"
                                        data-send-code-label="@Loc["SendVerificationCode"].Value"
                                        data-send-code-demo="@Loc["DemoCode"].Value">@Loc["SendVerificationCode"]</button>
                            </div>
                            <div id="sendCodeStatus" class="form-text"></div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="VerificationCode" class="form-label">@Loc["VerificationCode"]</label>
                            <input asp-for="VerificationCode" class="form-control" autocomplete="one-time-code" />
                            <span asp-validation-for="VerificationCode" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label">@Loc["NewPassword"]</label>
                            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">@Loc["ConfirmPassword"]</label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">@Loc["ResetPassword"]</button>
                    </form>
                </div>
            </div>
            <p class="text-center small mt-3">
                <a asp-controller="Account" asp-action="Login">@Loc["Login"]</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
