@model ForgotPasswordViewModel
@{
    ViewData["Title"] = Loc["ForgotPassword"].Value;
}
<div class="account-auth-page">
    <div class="account-auth-panel">
        <header class="account-auth-header">
            <a class="account-auth-wordmark" asp-controller="Home" asp-action="Index" aria-label="ZHY">ZHY.</a>
            <h1 class="account-auth-title">@L10n.Text("找回你的账户密码。", "Recover access to your account.")</h1>
            <p class="account-auth-subtitle">@L10n.Text("输入注册邮箱，我们会发送验证码帮你重置密码。", "Enter your registered email and we will send you a code to reset your password.")</p>
        </header>

        <form class="account-auth-form" method="post" asp-controller="Account" asp-action="ForgotPassword">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div>
                <label asp-for="Email" class="account-auth-label">@Loc["Email"]</label>
                <div class="input-group">
                    <input asp-for="Email" class="form-control account-auth-control" autocomplete="username" />
                    <button type="button" class="btn btn-outline-primary account-auth-code-button"
                            data-send-code-url="@Url.Action("SendCode", "Account")"
                            data-send-code-purpose="reset"
                            data-send-code-channel="email"
                            data-send-code-target="#Email"
                            data-send-code-status="#sendCodeStatus"
                            data-send-code-success="@Loc["SendCodeSuccess"].Value"
                            data-send-code-failed="@Loc["SendCodeFailed"].Value"
                            data-send-code-invalid="@Loc["InvalidEmail"].Value"
                            data-send-code-label="@Loc["SendVerificationCode"].Value"
                            data-send-code-demo="@Loc["DemoCode"].Value">@Loc["SendVerificationCode"]</button>
                </div>
                <div id="sendCodeStatus" class="form-text"></div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="account-auth-code-field">
                <label asp-for="VerificationCode" class="account-auth-label">@Loc["VerificationCode"]</label>
                <input asp-for="VerificationCode" class="form-control account-auth-control" inputmode="numeric" maxlength="6" autocomplete="one-time-code" />
                <span asp-validation-for="VerificationCode" class="text-danger small"></span>
            </div>

            <div>
                <label asp-for="NewPassword" class="account-auth-label">@Loc["NewPassword"]</label>
                <div class="password-field">
                    <input asp-for="NewPassword" class="form-control account-auth-control" autocomplete="new-password" />
                    <button type="button" class="password-toggle" data-password-target="NewPassword"
                            data-show-label="@L10n.Text("显示密码", "Show password")"
                            data-hide-label="@L10n.Text("隐藏密码", "Hide password")"
                            aria-label="@L10n.Text("显示密码", "Show password")" aria-pressed="false">
                        <i class="bi bi-eye" aria-hidden="true"></i>
                    </button>
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="account-auth-label">@Loc["ConfirmPassword"]</label>
                <div class="password-field">
                    <input asp-for="ConfirmPassword" class="form-control account-auth-control" autocomplete="new-password" />
                    <button type="button" class="password-toggle" data-password-target="ConfirmPassword"
                            data-show-label="@L10n.Text("显示密码", "Show password")"
                            data-hide-label="@L10n.Text("隐藏密码", "Hide password")"
                            aria-label="@L10n.Text("显示密码", "Show password")" aria-pressed="false">
                        <i class="bi bi-eye" aria-hidden="true"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary account-auth-submit">@Loc["ResetPassword"]</button>
        </form>

        <p class="account-auth-footer">
            <a asp-controller="Account" asp-action="Login">@Loc["Login"]</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
