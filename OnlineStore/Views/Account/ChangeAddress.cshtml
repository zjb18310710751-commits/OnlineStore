@model AddressViewModel
@{
    ViewData["Title"] = Loc["ChangeAddress"].Value;
    var editorTitle = Model.Id.HasValue ? Loc["EditDeliveryAddress"].Value : Loc["AddAddress"].Value;
    var embedded = ViewData["Embedded"] as bool? == true;
}

<div class="@(embedded ? "p-2 p-md-3" : "container py-4 profile-account-page")">
    <div class="row g-4">
        @if (!embedded)
        {
            <div class="col-lg-3">
                <partial name="_ProfileSidebar" model="Model" />
            </div>
        }
        <div class="@(embedded ? "col-12" : "col-lg-9")">
            <section class="card shadow-sm profile-section-card @(embedded ? "" : "profile-account-panel")" aria-labelledby="addressBookTitle"
                     data-has-addresses="@(Model.Addresses.Count > 0 ? "true" : "false")">
                <div class="card-header bg-white">
                    <div class="profile-section-heading address-section-heading">
                        <div>
                            <h1 id="addressBookTitle" class="profile-section-title">@Loc["AddressBookTitle"]</h1>
                            <p class="profile-section-subtitle mb-0">@Loc["AddressBookHint"]</p>
                        </div>
                        <button type="button" class="btn btn-primary address-book-primary-action"
                                data-address-add>
                            <i class="bi bi-plus-lg me-2"></i>@Loc["AddAddress"]
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="address-book-grid">
                        @if (Model.Addresses.Count > 0)
                        {
                            @foreach (var address in Model.Addresses)
                            {
                                <article class="delivery-address-card @(address.IsDefault ? "is-primary" : "")">
                                <div class="delivery-address-card-top">
                                    @if (address.IsDefault)
                                    {
                                        <span class="delivery-address-primary">
                                            <i class="bi bi-check2-circle me-1"></i>@Loc["PrimaryAddress"]
                                        </span>
                                    }
                                </div>

                                <div class="delivery-address-person">
                                    <h2>@address.RecipientName</h2>
                                    @if (!string.IsNullOrWhiteSpace(address.PhoneNumber))
                                    {
                                        <div class="delivery-address-phone">
                                            <i class="bi bi-telephone"></i>
                                            <span>@address.PhoneNumber</span>
                                        </div>
                                    }
                                </div>

                                <div class="delivery-address-divider"></div>

                                <dl class="delivery-address-details">
                                    <div>
                                        <dt>@Loc["AddressLine1"]</dt>
                                        <dd>
                                            @address.AddressLine1
                                            @if (!string.IsNullOrWhiteSpace(address.AddressLine2))
                                            {
                                                <span class="d-block">@address.AddressLine2</span>
                                            }
                                        </dd>
                                    </div>
                                    <div>
                                        <dt>@Loc["City"]</dt>
                                        <dd>@(string.IsNullOrWhiteSpace(address.City) ? "—" : address.City)</dd>
                                    </div>
                                    <div>
                                        <dt>@Loc["PostalCode"]</dt>
                                        <dd><span class="delivery-address-code">@(string.IsNullOrWhiteSpace(address.PostalCode) ? "—" : address.PostalCode)</span></dd>
                                    </div>
                                    <div>
                                        <dt>@Loc["Country"]</dt>
                                        <dd>@(string.IsNullOrWhiteSpace(address.Country) ? "—" : address.Country)</dd>
                                    </div>
                                </dl>

                                <div class="delivery-address-divider"></div>

                                <footer class="delivery-address-card-footer">
                                    <div class="delivery-address-status">
                                        @if (address.IsDefault)
                                        {
                                            <span class="delivery-address-active">
                                                <i class="bi bi-check-circle me-1"></i>@Loc["ActiveDelivery"]
                                            </span>
                                        }
                                        else
                                        {
                                            <form method="post" asp-controller="Account" asp-action="SetDefaultAddress">
                                                <input type="hidden" name="id" value="@address.Id" />
                                                <input type="hidden" name="embedded" value="@(embedded ? "true" : "false")" />
                                                <button type="submit" class="btn address-default-btn">
                                                    @Loc["SetAsDefaultAddress"]
                                                </button>
                                            </form>
                                        }
                                    </div>
                                    <div class="delivery-address-actions">
                                        @if (embedded)
                                        {
                                            <button type="button" class="btn address-use-btn"
                                                    data-use-address
                                                    data-address-id="@address.Id"
                                                    data-address-recipient="@address.RecipientName"
                                                    data-address-phone="@address.PhoneNumber"
                                                    data-address-line1="@address.AddressLine1"
                                                    data-address-line2="@address.AddressLine2"
                                                    data-address-city="@address.City"
                                                    data-address-postal="@address.PostalCode"
                                                    data-address-country="@address.Country">
                                                @Loc["UseAddress"]
                                            </button>
                                        }
                                        <button type="button" class="btn address-action-btn"
                                                data-address-edit
                                                data-address-id="@address.Id"
                                                data-address-recipient="@address.RecipientName"
                                                data-address-phone="@address.PhoneNumber"
                                                data-address-line1="@address.AddressLine1"
                                                data-address-line2="@address.AddressLine2"
                                                data-address-city="@address.City"
                                                data-address-postal="@address.PostalCode"
                                                data-address-country="@address.Country"
                                                data-address-default="@(address.IsDefault ? "true" : "false")">
                                            @Loc["Edit"]
                                        </button>
                                        <button type="button" class="btn address-action-btn address-action-danger"
                                                data-address-delete data-address-id="@address.Id">
                                            @Loc["Delete"]
                                        </button>
                                    </div>
                                </footer>
                                </article>
                            }
                        }
                        else
                        {
                            <div class="delivery-address-empty">
                                <span class="delivery-address-empty-icon">
                                    <i class="bi bi-geo-alt"></i>
                                </span>
                                <h2>@Loc["NoAddressTitle"]</h2>
                                <p>@Loc["NoAddressHint"]</p>
                                <button type="button" class="btn btn-primary" data-address-add>
                                    <i class="bi bi-plus-lg me-2"></i>@Loc["AddAddress"]
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

<div class="modal fade address-modal" id="addressEditorModal" tabindex="-1"
     aria-labelledby="addressEditorTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <form method="post" asp-controller="Account" asp-action="ChangeAddress" id="addressEditorForm">
                <input asp-for="Id" type="hidden" />
                <input type="hidden" name="embedded" value="@(embedded ? "true" : "false")" />
                <div class="modal-header">
                    <div>
                        <span class="address-modal-kicker">@Loc["AddressDetails"]</span>
                        <h2 class="modal-title" id="addressEditorTitle">@editorTitle</h2>
                        <p class="address-modal-subtitle mb-0">@Loc["EditAddressHint"]</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Loc["Cancel"]"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="RecipientName" class="form-label">
                                @Loc["RecipientName"] <span class="address-required">*</span>
                            </label>
                            <input asp-for="RecipientName" class="form-control address-form-control"
                                   autocomplete="name" placeholder="@Loc["RecipientName"]" />
                            <span asp-validation-for="RecipientName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label">
                                @Loc["PhoneNumber"] <span class="address-required">*</span>
                            </label>
                            <input asp-for="PhoneNumber" class="form-control address-form-control"
                                   autocomplete="tel" placeholder="@Loc["PhoneNumber"]" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Address" class="form-label">
                                @Loc["AddressLine1"] <span class="address-required">*</span>
                            </label>
                            <input asp-for="Address" class="form-control address-form-control"
                                   autocomplete="address-line1" placeholder="@Loc["AddressLine1"]" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="AddressLine2" class="form-label">@Loc["AddressLine2Optional"]</label>
                            <input asp-for="AddressLine2" class="form-control address-form-control"
                                   autocomplete="address-line2" placeholder="@Loc["AddressLine2Optional"]" />
                        </div>
                        <div class="col-6 col-md-4">
                            <label asp-for="City" class="form-label">
                                @Loc["City"] <span class="address-required">*</span>
                            </label>
                            <input asp-for="City" class="form-control address-form-control"
                                   autocomplete="address-level2" placeholder="@Loc["City"]" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                        <div class="col-6 col-md-4">
                            <label asp-for="PostalCode" class="form-label">
                                @Loc["PostalCode"] <span class="address-required">*</span>
                            </label>
                            <input asp-for="PostalCode" class="form-control address-form-control"
                                   autocomplete="postal-code" placeholder="@Loc["PostalCode"]" />
                            <span asp-validation-for="PostalCode" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="Country" class="form-label">
                                @Loc["Country"] <span class="address-required">*</span>
                            </label>
                            <input asp-for="Country" class="form-control address-form-control"
                                   autocomplete="country-name" placeholder="@Loc["Country"]" />
                            <span asp-validation-for="Country" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label class="address-default-check">
                                <input asp-for="IsDefault" class="form-check-input" />
                                <span>@Loc["SetAsDefaultAddress"]</span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn address-modal-cancel" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                    <button type="submit" class="btn btn-primary address-modal-save">
                        <i class="bi bi-check2 me-1"></i>@Loc["UpdateAddress"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (Model.Addresses.Count > 0)
{
    <div class="modal fade address-modal address-delete-modal" id="addressDeleteModal" tabindex="-1"
         aria-labelledby="addressDeleteTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-controller="Account" asp-action="DeleteAddress">
                    <input type="hidden" name="id" id="addressDeleteId" />
                    <input type="hidden" name="embedded" value="@(embedded ? "true" : "false")" />
                    <div class="modal-body">
                        <span class="address-delete-icon"><i class="bi bi-trash3"></i></span>
                        <h2 class="modal-title" id="addressDeleteTitle">@Loc["DeleteAddressTitle"]</h2>
                        <p class="address-delete-copy">@Loc["DeleteAddressConfirm"]</p>
                    </div>
                    <div class="modal-footer address-delete-footer">
                        <button type="button" class="btn address-modal-cancel" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                        <button type="submit" class="btn address-delete-confirm">
                            <i class="bi bi-trash3 me-1"></i>@Loc["Delete"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const editorModal = document.getElementById('addressEditorModal');
            const editorForm = document.getElementById('addressEditorForm');
            const editorTitle = document.getElementById('addressEditorTitle');
            const hasAddresses = document.querySelector('[data-has-addresses]')?.dataset.hasAddresses === 'true';
            const addTitle = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc["AddAddress"].Value));
            const editTitle = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc["EditDeliveryAddress"].Value));

            function setField(name, value) {
                const field = editorForm?.elements.namedItem(name);
                if (field) {
                    field.value = value || '';
                }
            }

            function openEditor() {
                bootstrap.Modal.getOrCreateInstance(editorModal).show();
            }

            document.querySelectorAll('[data-address-add]').forEach(function (button) {
                button.addEventListener('click', function () {
                    editorForm?.reset();
                    setField('Id', '');
                    editorTitle.textContent = addTitle;
                    const defaultField = editorForm?.querySelector('#IsDefault');
                    if (defaultField) {
                        defaultField.checked = !hasAddresses;
                    }
                    openEditor();
                });
            });

            document.querySelectorAll('[data-address-edit]').forEach(function (button) {
                button.addEventListener('click', function () {
                    editorForm?.reset();
                    editorTitle.textContent = editTitle;
                    setField('Id', button.dataset.addressId);
                    setField('RecipientName', button.dataset.addressRecipient);
                    setField('PhoneNumber', button.dataset.addressPhone);
                    setField('Address', button.dataset.addressLine1);
                    setField('AddressLine2', button.dataset.addressLine2);
                    setField('City', button.dataset.addressCity);
                    setField('PostalCode', button.dataset.addressPostal);
                    setField('Country', button.dataset.addressCountry);
                    const defaultField = editorForm?.querySelector('#IsDefault');
                    if (defaultField) {
                        defaultField.checked = button.dataset.addressDefault === 'true';
                    }
                    openEditor();
                });
            });

            document.querySelectorAll('[data-use-address]').forEach(function (button) {
                button.addEventListener('click', function () {
                    window.parent.postMessage({
                        type: 'checkout-select-address',
                        address: {
                            id: button.dataset.addressId,
                            recipientName: button.dataset.addressRecipient,
                            phoneNumber: button.dataset.addressPhone,
                            addressLine1: button.dataset.addressLine1,
                            addressLine2: button.dataset.addressLine2,
                            city: button.dataset.addressCity,
                            postalCode: button.dataset.addressPostal,
                            country: button.dataset.addressCountry
                        }
                    }, window.location.origin);
                });
            });

            const deleteModal = document.getElementById('addressDeleteModal');
            const deleteId = document.getElementById('addressDeleteId');
            document.querySelectorAll('[data-address-delete]').forEach(function (button) {
                button.addEventListener('click', function () {
                    if (deleteId) {
                        deleteId.value = button.dataset.addressId;
                    }
                    bootstrap.Modal.getOrCreateInstance(deleteModal).show();
                });
            });

            @if (!ViewData.ModelState.IsValid)
            {
                <text>openEditor();</text>
            }
        });
    </script>
}
