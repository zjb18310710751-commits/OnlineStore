@model int
<a class="nav-link sf-cart-link position-relative" asp-controller="Cart" asp-action="Index" title="@Loc["Cart"].Value" aria-label="@Loc["Cart"] (@Model)">
    <svg class="sf-nav-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M3 5h2.2l1.7 9.5h9.5l2.1-7H6.1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
        <path d="m9.7 8.7 4 4m0-4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        <circle cx="9.1" cy="18.2" r="1.6" stroke="currentColor" stroke-width="1.5"></circle>
        <circle cx="16.2" cy="18.2" r="1.6" stroke="currentColor" stroke-width="1.5"></circle>
    </svg>
    @if (Model > 0)
    {
        <span class="sf-nav-count" aria-hidden="true">
            @(Model > 99 ? "99+" : Model.ToString())
        </span>
    }
</a>
