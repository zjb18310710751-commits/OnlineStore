@model int
<a class="nav-link sf-cart-link position-relative" asp-controller="Cart" asp-action="Index" title="@Loc["Cart"].Value" aria-label="@Loc["Cart"] (@Model)">
    <i class="bi bi-bag" aria-hidden="true"></i>
    @if (Model > 0)
    {
        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
            @(Model > 99 ? "99+" : Model.ToString())
        </span>
    }
</a>
