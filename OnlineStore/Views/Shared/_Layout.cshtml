@inject ICategoryService CategoryService
@inject IFavoriteService FavoriteService
@inject IOrderService OrderService
@inject ICouponService CouponService
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager
@{
    var categories = (await CategoryService.GetAllAsync()).ToList();
    var currentUser = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;
    var favoriteCount = currentUser is null ? 0 : await FavoriteService.CountAsync(currentUser.Id);
    var deliveredItemCount = currentUser is null ? 0 : await OrderService.GetDeliveredItemCountAsync(currentUser.Id);
    var availableCouponCount = currentUser is null
        ? 0
        : (await CouponService.GetCustomerCouponsAsync(currentUser.Id))
            .Count(item => item.Status == CouponWalletStatus.Available);
    var isAdmin = User.IsInRole("Admin");
    var isZh = CultureInfo.CurrentUICulture.Name.StartsWith("zh", StringComparison.OrdinalIgnoreCase);
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var embeddedLayout = ViewData["Embedded"] as bool? == true;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isHomePage = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase) &&
        string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
    var isCatalogPage = string.Equals(currentController, "Products", StringComparison.OrdinalIgnoreCase) &&
        string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is null ? Loc["Brand"].Value : $"{ViewData["Title"]} - {Loc["Brand"].Value}")</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/storefront.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/category-navigation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hero-carousel.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/catalog.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/coupons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ui-feedback.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="storefront ui-feedback-scope @(embeddedLayout ? "ui-feedback-embedded" : "") d-flex flex-column min-vh-100">
    <a class="sf-skip-link" href="#main-content">@L10n.Text("跳至主要内容", "Skip to content")</a>
    @if (!embeddedLayout)
    {
        <header class="sf-header">
            <nav class="sf-nav" aria-label="@L10n.Text("产品分类导航", "Product category navigation")">
                <div class="sf-container sf-nav-inner">
                    <div class="sf-brand-nav">
                        <a class="sf-wordmark" asp-controller="Home" asp-action="Index" aria-label="ZHY · @Loc["Home"]">ZHY.</a>
                        <div class="sf-quick-links">
                            <a class="sf-quick-link" asp-controller="Home" asp-action="Index" aria-current="@(isHomePage ? "page" : null)">Home</a>
                            @if (!isCatalogPage)
                            {
                                <a class="sf-quick-link sf-quick-link-catalog" asp-controller="Products" asp-action="Index">@Loc["AllProducts"]</a>
                            }
                        </div>
                    </div>
                    @await Component.InvokeAsync("CategoryNavigation")
                    <div class="sf-nav-tools">
                        <form asp-controller="Products" asp-action="Index" method="get" class="sf-search" role="search">
                            <button type="submit" aria-label="@Loc["Search"]"><i class="bi bi-search" aria-hidden="true"></i></button>
                            <input type="search" name="searchTerm" placeholder="@Loc["Search"]" aria-label="@Loc["SearchPlaceholder"]" value="@Context.Request.Query["searchTerm"]" />
                        </form>
                        <a class="sf-icon-link sf-favorite-link sf-nav-favorites position-relative"
                           asp-controller="Favorites" asp-action="Index"
                           title="@Loc["MyFavorites"]"
                           aria-label="@Loc["MyFavorites"] (@favoriteCount)">
                            <i class="bi bi-heart" aria-hidden="true"></i>
                            @if (favoriteCount > 0)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                    @(favoriteCount > 99 ? "99+" : favoriteCount.ToString())
                                </span>
                            }
                        </a>
                        @await Component.InvokeAsync("CartSummary")
                        <div class="dropdown">
                            <button class="sf-icon-link" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@Loc["Profile"]">
                                @if (!string.IsNullOrEmpty(currentUser?.AvatarUrl))
                                {
                                    <img src="@currentUser.AvatarUrl" class="sf-avatar" alt="" />
                                }
                                else
                                {
                                    <i class="bi bi-person" aria-hidden="true"></i>
                                }
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">@Loc["Profile"]</a></li>
                                    <li>
                                        <a class="dropdown-item sf-account-link" asp-controller="Orders" asp-action="MyOrders">
                                            <span>@Loc["MyOrders"]</span>
                                            @if (deliveredItemCount > 0)
                                            {
                                                <span class="sf-count-badge" aria-label="@L10n.Text($"{deliveredItemCount} 件商品已送达", $"{deliveredItemCount} delivered items")">@deliveredItemCount</span>
                                            }
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Login">@Loc["Login"]</a></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Register">@Loc["Register"]</a></li>
                                }
                                <li>
                                    <a class="dropdown-item sf-account-link" asp-controller="Favorites" asp-action="Index">
                                        <span>@Loc["MyFavorites"]</span>
                                        @if (favoriteCount > 0)
                                        {
                                            <span class="sf-count-badge" aria-label="@L10n.Text($"{favoriteCount} 件收藏", $"{favoriteCount} favourites")">@favoriteCount</span>
                                        }
                                    </a>
                                </li>
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <li>
                                        <a class="dropdown-item sf-account-link" asp-controller="Coupons" asp-action="Index">
                                            <span>@Loc["MyCoupons"]</span>
                                            @if (availableCouponCount > 0)
                                            {
                                                <span class="sf-count-badge" aria-label="@L10n.Text($"{availableCouponCount} 张可用优惠券", $"{availableCouponCount} available coupons")">@availableCouponCount</span>
                                            }
                                        </a>
                                    </li>
                                }
                                @if (!isCatalogPage)
                                {
                                    <li><a class="dropdown-item" asp-controller="Products" asp-action="Index">@Loc["AllProducts"]</a></li>
                                }
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    @if (isAdmin)
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">@Loc["AdminPanel"]</a></li>
                                    }
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="dropdown-item">@Loc["Logout"]</button></form></li>
                                }
                            </ul>
                        </div>
                        <form asp-controller="Language" asp-action="Set" method="post" class="sf-language-form">
                            <input type="hidden" name="culture" value="@(isZh ? "en" : "zh-CN")" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit" class="sf-language" aria-label="@(isZh ? "Switch to English" : "切换到中文")">@(isZh ? "EN" : "中文")</button>
                        </form>
                    </div>
                </div>
            </nav>
        </header>
    }
    <main id="main-content" class="flex-grow-1" tabindex="-1">
        <partial name="~/Views/Shared/_FeedbackMessages.cshtml" />
        @RenderBody()
    </main>
    @if (!embeddedLayout)
    {
        <footer class="sf-footer">
            <div class="sf-container">
                <div class="sf-footer-grid">
                    <div class="sf-footer-brand"><a class="sf-wordmark" asp-controller="Home" asp-action="Index">ZHY.</a><p>@L10n.Text("为日常，选更好的。", "A little better. Every day.")</p></div>
                    <div>
                        <h2>@Loc["ShopByCategory"]</h2>
                        <ul>
                            @foreach (var category in categories)
                            {
                                <li><a asp-controller="Products" asp-action="Index" asp-route-categoryId="@category.Id">@L10n.Name(category)</a></li>
                            }
                        </ul>
                    </div>
                    <div><h2>@L10n.Text("你的商店", "Your store")</h2><ul><li><a asp-controller="Account" asp-action="Profile">@Loc["Profile"]</a></li><li><a asp-controller="Orders" asp-action="MyOrders">@Loc["MyOrders"]</a></li><li><a asp-controller="Favorites" asp-action="Index">@Loc["MyFavorites"]</a></li><li><a asp-controller="Coupons" asp-action="Index">@Loc["MyCoupons"]</a></li><li><a asp-controller="Cart" asp-action="Index">@Loc["Cart"]</a></li></ul></div>
                </div>
                <div class="sf-footer-bottom"><span>&copy; @DateTime.Now.Year ZHY · @Loc["Brand"]</span><span>@L10n.Text("发现喜欢，留住日常。", "Find your everyday favourites.")</span></div>
            </div>
        </footer>
    }
    <partial name="~/Views/Shared/_ConfirmDialog.cshtml" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/ui-feedback.js" asp-append-version="true"></script>
    <script src="~/js/confirm-dialog.js" asp-append-version="true"></script>
    <script src="~/js/catalog.js" asp-append-version="true"></script>
    <script src="~/js/category-navigation.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
