@model Product
<div class="col">
    <article class="product-card sf-product-card">
        <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id" class="product-thumb">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="product-thumb-img" alt="@L10n.Name(Model)" loading="lazy" width="600" height="600" />
            }
            else
            {
                <span class="sf-image-empty"><i class="bi bi-image" aria-hidden="true"></i><span>@L10n.Text("暂无图片", "Image unavailable")</span></span>
            }
        </a>
        <div class="sf-product-info">
            @if (Model.IsOnSale)
            {
                <p class="sf-product-note">@Loc["LimitedTimeDiscount"]</p>
            }
            <h3 class="sf-product-title"><a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id">@L10n.Name(Model)</a></h3>
            <p class="sf-product-category">@L10n.Name(Model.Categories.FirstOrDefault())</p>
            <div class="sf-product-price">
                <span>¥@Model.Price.ToString("F2")</span>
                @if (Model.IsOnSale)
                {
                    <del>¥@Model.OriginalPrice!.Value.ToString("F2")</del>
                    <span class="sf-product-discount">@Loc["DiscountPercent", Model.DiscountPercent ?? 0]</span>
                }
            </div>
            @if (Model.Stock > 0)
            {
                <form asp-controller="Cart" asp-action="Add" method="post" class="sf-product-action">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <input type="hidden" name="quantity" value="1" />
                    <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                    <button type="submit" aria-label="@Loc["AddToCart"] · @L10n.Name(Model)"><span>@Loc["AddToCart"]</span><i class="bi bi-plus-lg" aria-hidden="true"></i></button>
                </form>
            }
            else
            {
                <p class="sf-sold-out">@Loc["OutOfStock"]</p>
            }
        </div>
    </article>
</div>
