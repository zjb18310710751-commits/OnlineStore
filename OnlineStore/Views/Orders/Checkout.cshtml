@model CheckoutViewModel
@{
    ViewData["Title"] = Loc["Checkout"].Value;
}
<div class="container py-4">
    <h1 class="h3 mb-4">@Loc["Checkout"]</h1>

    <form id="checkoutForm" asp-controller="Orders" asp-action="Checkout" method="post">
        <input asp-for="AddressId" type="hidden" id="AddressId" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center gap-2 flex-wrap">
                        <span class="fw-semibold">@Loc["DeliveryInformation"]</span>
                        <button type="button" class="btn btn-sm btn-outline-primary"
                                data-bs-toggle="modal" data-bs-target="#switchAddressModal">
                            <i class="bi bi-arrow-repeat me-1"></i>@Loc["SwitchAddress"]
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="UserName" class="form-label">@Loc["Receiver"]</label>
                                <input asp-for="UserName" class="form-control" autocomplete="name" />
                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label">@Loc["PhoneNumber"]</label>
                                <input asp-for="Phone" class="form-control" autocomplete="tel" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Address" class="form-label">@Loc["AddressLine1"]</label>
                                <input asp-for="Address" class="form-control" autocomplete="address-line1" />
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="AddressLine2" class="form-label">@Loc["AddressLine2Optional"]</label>
                                <input asp-for="AddressLine2" class="form-control" autocomplete="address-line2" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="City" class="form-label">@Loc["City"]</label>
                                <input asp-for="City" class="form-control" autocomplete="address-level2" />
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="PostalCode" class="form-label">@Loc["PostalCode"]</label>
                                <input asp-for="PostalCode" class="form-control" autocomplete="postal-code" />
                                <span asp-validation-for="PostalCode" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Country" class="form-label">@Loc["Country"]</label>
                                <input asp-for="Country" class="form-control" autocomplete="country-name" />
                                <span asp-validation-for="Country" class="text-danger small"></span>
                            </div>
                            @if (!Model.HasSavedAddresses)
                            {
                                <div class="col-12">
                                    <label class="checkout-save-address">
                                        <input asp-for="SaveAsDefaultAddress" class="form-check-input" />
                                        <span>
                                            <span class="checkout-save-address-title">@Loc["SaveAddressAsDefault"]</span>
                                            <span class="checkout-save-address-hint">@Loc["SaveAddressAsDefaultHint"]</span>
                                        </span>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-header bg-white fw-semibold">@Loc["Payment"]</div>
                    <div class="card-body">
                        <label class="checkout-payment-option">
                            <input asp-for="PaymentMethod" id="paymentCash" type="radio" value="cash_on_delivery" class="form-check-input" />
                            <span>
                                <span class="checkout-payment-title"><i class="bi bi-cash-coin me-2"></i>@Loc["CashOnDelivery"]</span>
                                <span class="checkout-payment-hint">@Loc["CashOnDeliveryHint"]</span>
                            </span>
                        </label>
                        <label class="checkout-payment-option">
                            <input asp-for="PaymentMethod" id="paymentCard" type="radio" value="card_demo" class="form-check-input" />
                            <span>
                                <span class="checkout-payment-title"><i class="bi bi-credit-card me-2"></i>@Loc["CardPaymentDemo"]</span>
                                <span class="checkout-payment-hint">@Loc["CardPaymentHint"]</span>
                            </span>
                        </label>
                        <label class="checkout-payment-option">
                            <input asp-for="PaymentMethod" id="paymentTransfer" type="radio" value="bank_transfer_demo" class="form-check-input" />
                            <span>
                                <span class="checkout-payment-title"><i class="bi bi-bank me-2"></i>@Loc["BankTransferDemo"]</span>
                                <span class="checkout-payment-hint">@Loc["BankTransferHint"]</span>
                            </span>
                        </label>

                        <div class="mt-4">
                            <label asp-for="OrderNotes" class="form-label">@Loc["OrderNotesOptional"]</label>
                            <textarea asp-for="OrderNotes" class="form-control" rows="3" maxlength="500" placeholder="@Loc["OrderNotesPlaceholder"]"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card checkout-summary-card shadow-sm">
                    <div class="card-header bg-white fw-semibold">@Loc["YourOrder"]</div>
                    <div class="card-body">
                        <ul class="list-unstyled mb-3">
                            @foreach (var item in Model.Items)
                            {
                                <li class="checkout-order-item">
                                    <div>
                                        <div>@L10n.Text(item.Name, item.NameEn)</div>
                                        @if (!string.IsNullOrEmpty(item.Color) || !string.IsNullOrEmpty(item.Spec))
                                        {
                                            <small class="text-muted d-block">
                                                @L10n.Text(item.Color ?? "", item.ColorEn) @L10n.Text(item.Spec ?? "", item.SpecEn)
                                            </small>
                                        }
                                        <small class="text-muted">× @item.Quantity</small>
                                    </div>
                                    <span class="text-nowrap">¥@item.LineTotal.ToString("F2")</span>
                                </li>
                            }
                        </ul>

                        <div class="border-top pt-3 checkout-coupon-panel">
                            <div class="checkout-coupon-title">
                                <span>@Loc["AvailableCoupons"]</span>
                                <a asp-controller="Coupons" asp-action="Index">@Loc["ViewMyCoupons"]</a>
                            </div>
                            @if (Model.AvailableCoupons.Count > 0)
                            {
                                <div class="checkout-coupon-heading">
                                    <span>@Loc["AvailableCouponCount", Model.AvailableCoupons.Count]</span>
                                    <span>@Loc["BestCouponHint"]</span>
                                </div>
                                <div class="checkout-coupon-list" aria-label="@Loc["AvailableCoupons"]">
                                    @foreach (var coupon in Model.AvailableCoupons)
                                    {
                                        <button type="button"
                                                class="checkout-coupon-option @(coupon.IsSelected ? "is-selected" : "")"
                                                aria-pressed="@(coupon.IsSelected ? "true" : "false")"
                                                data-apply-coupon="@coupon.Code">
                                            <span class="checkout-coupon-option-top">
                                                <span class="checkout-coupon-radio" aria-hidden="true"></span>
                                                <strong>@(string.IsNullOrWhiteSpace(coupon.CampaignName) ? Loc["Coupon"].Value : coupon.CampaignName)</strong>
                                                @if (coupon.IsBest)
                                                {
                                                    <span class="checkout-coupon-best">@Loc["BestCoupon"]</span>
                                                }
                                            </span>
                                            <span class="checkout-coupon-option-rule">
                                                @if (coupon.FreeShipping)
                                                {
                                                    @Loc["FreeShippingDiscount"]
                                                }
                                                else if (coupon.DiscountType == CouponDiscountType.Percent)
                                                {
                                                    @Loc["PercentCouponBenefit", coupon.DiscountValue.ToString("0.##")]
                                                }
                                                else
                                                {
                                                    @Loc["FixedCouponBenefit", coupon.DiscountValue.ToString("F2")]
                                                }
                                            </span>
                                            <span class="checkout-coupon-option-meta">
                                                @if (coupon.CalculatedDiscount > 0)
                                                {
                                                    <span>@Loc["CouponSavings", coupon.CalculatedDiscount.ToString("F2")]</span>
                                                }
                                                <span>@Loc["CouponEnds", coupon.EndDate.ToString("yyyy-MM-dd")]</span>
                                            </span>
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="checkout-coupon-empty">@Loc["NoAvailableCoupons"]</p>
                            }
                            <input asp-for="CouponCode" id="couponCode" type="hidden" />
                            <div class="d-flex justify-content-end align-items-start gap-2">
                                <div id="couponStatus" class="checkout-coupon-status small" role="status"></div>
                                <button type="button" id="couponClear" class="checkout-coupon-clear">@Loc["RemoveCoupon"]</button>
                            </div>
                            <span asp-validation-for="CouponCode" class="text-danger small"></span>
                        </div>

                        <div class="mt-3">
                            <div class="checkout-total-row">
                                <span>@Loc["Subtotal"]</span>
                                <span id="subtotalText">¥@Model.Total.ToString("F2")</span>
                            </div>
                            <div id="couponDiscountRow" class="checkout-total-row text-success @(Model.DiscountAmount > 0 ? string.Empty : "d-none")">
                                <span>@Loc["Discount"]</span>
                                <span id="couponDiscountText">-¥@Model.DiscountAmount.ToString("F2")</span>
                            </div>
                            <div id="couponShippingRow" class="checkout-total-row text-success @(Model.FreeShippingCoupon ? string.Empty : "d-none")">
                                <span>@Loc["CouponBenefit"]</span>
                                <span>@Loc["FreeShippingDiscount"]</span>
                            </div>
                            <div class="checkout-total-row">
                                <span>@Loc["ShippingFee"]</span>
                                <span id="shippingAmountText">@(Model.ShippingFee > 0 ? $"¥{Model.ShippingFee:F2}" : Loc["FreeShipping"].Value)</span>
                            </div>
                            <div class="checkout-total-row checkout-grand-total">
                                <span>@Loc["Total"]</span>
                                <span id="payableTotalText" class="text-danger" data-base-total="@((Model.Total + Model.ShippingFee).ToString("F2"))">¥@Model.PayableTotal.ToString("F2")</span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-amazon btn-lg w-100 mt-4">
                            <i class="bi bi-bag-check me-1"></i>@Loc["SubmitOrder"]
                        </button>
                        <a asp-controller="Cart" asp-action="Index" class="btn btn-link w-100 mt-1">@Loc["BackToCart"]</a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<div class="modal fade checkout-address-modal" id="switchAddressModal" tabindex="-1"
     aria-labelledby="switchAddressTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title" id="switchAddressTitle">@Loc["SelectDeliveryAddress"]</h2>
                    <p class="modal-subtitle text-muted small mb-0">@Loc["SelectDeliveryAddressHint"]</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Loc["Cancel"]"></button>
            </div>
            <div class="modal-body p-0">
                <iframe id="addressBookFrame"
                        src="@Url.Action("ChangeAddress", "Account", new { embedded = true })"
                        title="@Loc["AddressBookTitle"]"
                        class="checkout-address-frame"
                        loading="lazy"></iframe>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var couponInput = document.getElementById('couponCode');
            var statusEl = document.getElementById('couponStatus');
            var discountRow = document.getElementById('couponDiscountRow');
            var discountText = document.getElementById('couponDiscountText');
            var shippingRow = document.getElementById('couponShippingRow');
            var shippingAmountText = document.getElementById('shippingAmountText');
            var payableText = document.getElementById('payableTotalText');
            var clearButton = document.getElementById('couponClear');

            function formatMoney(value) {
                return '¥' + Number(value).toFixed(2);
            }

            function selectCouponButton(code) {
                document.querySelectorAll('[data-apply-coupon]').forEach(function (button) {
                    var selected = button.getAttribute('data-apply-coupon') === code;
                    button.classList.toggle('is-selected', selected);
                    button.setAttribute('aria-pressed', selected ? 'true' : 'false');
                });
            }

            function showCoupon(data) {
                payableText.textContent = formatMoney(data.payable);
                discountText.textContent = '-' + formatMoney(data.discount);
                discountRow.classList.toggle('d-none', !(data.discount > 0));
                shippingRow.classList.toggle('d-none', !data.freeShipping);
                shippingAmountText.textContent = data.shipping > 0
                    ? formatMoney(data.shipping)
                    : '@Loc["FreeShipping"]';
                statusEl.classList.remove('text-danger');
                statusEl.textContent = '';
                selectCouponButton(data.code || '');
            }

            function showCouponError(message) {
                statusEl.textContent = message || '';
                statusEl.classList.add('text-danger');
                statusEl.classList.remove('text-success');
                discountRow.classList.add('d-none');
                shippingRow.classList.add('d-none');
                payableText.textContent = formatMoney(payableText.getAttribute('data-base-total'));
                shippingAmountText.textContent = '@(Model.ShippingFee > 0 ? $"¥{Model.ShippingFee:F2}" : Loc["FreeShipping"].Value)';
                selectCouponButton('');
            }

            function applyCoupon(code) {
                couponInput.value = code || '';
                statusEl.textContent = '';

                fetch('@Url.Action("PreviewCoupon", "Orders")?couponCode=' + encodeURIComponent(code), {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(function (response) { return response.json(); })
                .then(function (data) {
                    if (data.ok) {
                        couponInput.value = data.code || code || '';
                        showCoupon(data);
                    } else {
                        showCouponError(data.error);
                    }
                })
                .catch(function () {
                    showCouponError('@Loc["CouponPreviewFailed"]');
                });
            }

            document.querySelectorAll('[data-apply-coupon]').forEach(function (button) {
                button.addEventListener('click', function () {
                    applyCoupon(button.getAttribute('data-apply-coupon'));
                });
            });

            clearButton.addEventListener('click', function () {
                couponInput.value = '';
                statusEl.textContent = '';
                statusEl.classList.remove('text-danger');
                discountRow.classList.add('d-none');
                shippingRow.classList.add('d-none');
                payableText.textContent = formatMoney(payableText.getAttribute('data-base-total'));
                shippingAmountText.textContent = '@(Model.ShippingFee > 0 ? $"¥{Model.ShippingFee:F2}" : Loc["FreeShipping"].Value)';
                selectCouponButton('');
            });

            var switchAddressModal = document.getElementById('switchAddressModal');
            window.addEventListener('message', function (event) {
                if (event.origin !== window.location.origin ||
                    !event.data ||
                    event.data.type !== 'checkout-select-address') {
                    return;
                }

                var address = event.data.address || {};
                function setValue(name, value) {
                    var input = document.getElementById(name);
                    if (input) {
                        input.value = value || '';
                    }
                }

                setValue('AddressId', address.id);
                setValue('UserName', address.recipientName);
                setValue('Phone', address.phoneNumber);
                setValue('Address', address.addressLine1);
                setValue('AddressLine2', address.addressLine2);
                setValue('City', address.city);
                setValue('PostalCode', address.postalCode);
                setValue('Country', address.country);

                var modal = bootstrap.Modal.getOrCreateInstance(switchAddressModal);
                modal.hide();
            });
        });
    </script>
}
