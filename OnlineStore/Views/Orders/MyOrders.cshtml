@model IReadOnlyList<Order>
@{
    ViewData["Title"] = Loc["MyOrders"].Value;
    var myReviews = ViewBag.MyReviews as IDictionary<string, Review> ?? new Dictionary<string, Review>();
    var itemPreviews = ViewData["OrderItemPreviews"] as IReadOnlyDictionary<int, OrderItemPreviewViewModel>
        ?? new Dictionary<int, OrderItemPreviewViewModel>();
}
@section Styles {
    <link rel="stylesheet" href="~/css/member-orders.css" asp-append-version="true" />
}
@functions {
    string StatusBadge(string status) => "bg-white text-dark border";
}
<div class="container coupon-wallet-page member-orders-page">
    <header class="coupon-wallet-header">
        <div>
            <p class="coupon-wallet-eyebrow">@L10n.Text("账户中心", "Member account")</p>
            <h1>@Loc["MyOrders"]</h1>
            <p>@L10n.Text("查看订单、物流进度与售后状态。", "Review orders, delivery progress and after-sales status.")</p>
        </div>
        <div class="coupon-wallet-count">
            <strong>@Model.Count</strong>
            <span>@L10n.Text("笔订单", "orders")</span>
        </div>
    </header>

    <div id="orderAlert" class="alert d-none"></div>

    @if (Model.Count == 0)
    {
        <section class="coupon-wallet-empty">
            <i class="bi bi-inbox"></i>
            <h2>@Loc["NoOrders"]</h2>
            <p>@L10n.Text("还没有订单记录，去看看今天的精选商品。", "You have no orders yet. Explore today's picks.")</p>
            <a asp-controller="Products" asp-action="Index" class="sf-button">@Loc["ContinueShopping"]</a>
        </section>
    }
    else
    {
        <div class="card member-orders-card">
            <div class="list-group list-group-flush">
                @foreach (var o in Model)
                {
                    <div class="list-group-item member-order-item" data-order-id="@o.Id">
                        <div class="member-order-heading">
                            <div>
                                <span class="text-muted member-order-meta me-2">@Loc["OrderNo"]：@o.OrderNo</span>
                                <span class="text-muted member-order-meta">@o.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                                @if (!string.IsNullOrWhiteSpace(o.Carrier) && !string.IsNullOrWhiteSpace(o.TrackingNumber))
                                {
                                    <div class="member-order-meta mt-1">
                                        @L10n.Text("承运商", "Carrier")：@L10n.Carrier(o.Carrier) ·
                                        @L10n.Text("运单号", "Tracking")：<span class="font-monospace">@o.TrackingNumber</span>
                                    </div>
                                }
                                else if (o.Status == OrderStatus.PendingShipment && o.ExpectedDispatchAt.HasValue)
                                {
                                    <div class="member-order-meta mt-1">
                                        @L10n.Text("预计发货", "Dispatch by") @o.ExpectedDispatchAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                    </div>
                                }
                                <div class="member-order-meta mt-1">
                                    @Loc["Payment"]：@L10n.PaymentMethod(o.PaymentMethod)
                                    @if (o.ShippingAmount > 0)
                                    {
                                        <span> · @Loc["ShippingFee"]：¥@o.ShippingAmount.ToString("F2")</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(o.OrderNotes))
                                {
                                    <div class="member-order-meta mt-1">@L10n.Text("备注", "Notes")：@o.OrderNotes</div>
                                }
                            </div>
                            <span class="badge member-order-status @StatusBadge(o.Status)">@L10n.Status(o.Status)</span>
                        </div>

                        <ul class="list-unstyled member-order-lines mb-2">
                            @foreach (var i in o.Items)
                            {
                                var productName = L10n.Text(i.ProductName, i.ProductNameEn);
                                var preview = itemPreviews.GetValueOrDefault(i.Id) ?? new OrderItemPreviewViewModel(null, false);
                                <li class="member-order-line">
                                    <div class="member-order-product">
                                        <div class="member-order-product-image">
                                            @if (!string.IsNullOrWhiteSpace(preview.ImageUrl))
                                            {
                                                <img src="@preview.ImageUrl" alt="@productName" width="112" height="112" loading="lazy"
                                                     onerror="this.hidden=true; this.nextElementSibling.hidden=false;" />
                                            }
                                            <span class="member-order-image-empty" hidden="@(!string.IsNullOrWhiteSpace(preview.ImageUrl))">
                                                <i class="bi bi-image" aria-hidden="true"></i>
                                                <span>@L10n.Text("暂无图片", "No photo")</span>
                                            </span>
                                        </div>
                                        <div class="member-order-product-info">
                                            <h2 class="member-order-product-name">
                                                @if (preview.CanViewProduct)
                                                {
                                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@i.ProductId">@productName</a>
                                                }
                                                else
                                                {
                                                    @productName
                                                }
                                            </h2>
                                            @if (!string.IsNullOrEmpty(i.Color) || !string.IsNullOrEmpty(i.Spec))
                                            {
                                                <p class="member-order-product-options">
                                                    @if (!string.IsNullOrEmpty(i.Color))
                                                    {
                                                        <span>@L10n.Text("颜色", "Colour")：@L10n.Text(i.Color, i.ColorEn)</span>
                                                    }
                                                    @if (!string.IsNullOrEmpty(i.Spec))
                                                    {
                                                        <span>@L10n.Text("规格", "Size / spec")：@L10n.Text(i.Spec, i.SpecEn)</span>
                                                    }
                                                </p>
                                            }
                                            <p class="member-order-product-quantity">@L10n.Text("数量", "Quantity") <strong>× @i.Quantity</strong></p>
                                        </div>
                                        <div class="member-order-product-amount">
                                            <span>@L10n.Text("商品小计", "Item subtotal")</span>
                                            <strong>¥@i.LineTotal.ToString("F2")</strong>
                                        </div>
                                    </div>
                                    @if (myReviews.TryGetValue($"{o.Id}:{i.ProductId}", out var myReview) && myReview is not null)
                                    {
                                        <div class="member-order-my-review">
                                            <div class="member-order-my-review-head">
                                                <strong>@L10n.Text("我的评价", "My review")</strong>
                                                <span class="member-order-review-stars" aria-label="@L10n.Text($"{myReview.Rating} 分", $"{myReview.Rating} out of 5")">
                                                    @string.Concat(Enumerable.Repeat("★", myReview.Rating))@string.Concat(Enumerable.Repeat("☆", 5 - myReview.Rating))
                                                </span>
                                                <time datetime="@myReview.CreatedAt.ToString("o")">@myReview.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</time>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(myReview.Comment))
                                            {
                                                <p>@myReview.Comment</p>
                                            }
                                            else
                                            {
                                                <p class="text-muted">@L10n.Text("未填写文字评价。", "No written comment.")</p>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(myReview.ImageUrl))
                                            {
                                                <a href="@myReview.ImageUrl" target="_blank" rel="noopener" class="member-order-review-image">@L10n.Text("查看评价图片", "View review photo")</a>
                                            }
                                        </div>
                                    }
                                </li>
                            }
                        </ul>

                        @if (o.AfterSalesRequests.Count > 0)
                        {
                            <div class="member-order-after-sales">
                                @foreach (var request in o.AfterSalesRequests)
                                {
                                    <span class="badge bg-white text-dark border">
                                        @(request.Type == AfterSalesType.Exchange ? L10n.Text("换货", "Exchange") : L10n.Text("退货", "Return"))
                                        · @L10n.AfterSalesStatusLabel(request.Status)
                                    </span>
                                }
                            </div>
                        }

                        <div class="member-order-footer">
                            <div class="member-order-actions d-flex flex-wrap gap-2 @(o.Status == OrderStatus.Completed ? "member-order-actions--stacked" : "")">
                                @if (o.Status == OrderStatus.PendingShipment)
                                {
                                    <form asp-controller="Orders" asp-action="Cancel" asp-route-id="@o.Id" method="post"
                                          data-confirm="@Loc["ConfirmCancelOrder"]" onsubmit="return confirm(this.dataset.confirm);">
                                        <button type="submit" class="btn btn-sm btn-outline-dark">@Loc["CancelOrder"]</button>
                                    </form>
                                }
                                else if (o.Status == OrderStatus.Shipped)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-dark" onclick="openTrackingModal(@o.Id, '@o.OrderNo')">@L10n.Text("查看物流", "Track parcel")</button>
                                }
                                else if (o.Status == OrderStatus.Delivered)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-dark" onclick="openTrackingModal(@o.Id, '@o.OrderNo')">@L10n.Text("查看物流", "Track parcel")</button>
                                    <button type="button" class="btn btn-sm btn-outline-dark" onclick="confirmReceipt(@o.Id, '@o.OrderNo')">@L10n.Text("确认收货", "Confirm receipt")</button>
                                }
                                else if (o.Status == OrderStatus.Completed)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-dark" onclick="openAfterSalesModal(@o.Id)">@L10n.Text("申请售后", "Return / Exchange")</button>
                                }
                                @if (o.Status is OrderStatus.Completed or OrderStatus.Cancelled or OrderStatus.Refunded
                                    && o.AfterSalesRequests.All(a => a.Status is AfterSalesStatus.Completed or AfterSalesStatus.Rejected))
                                {
                                    <form asp-controller="Orders" asp-action="Delete" asp-route-id="@o.Id" method="post"
                                          data-confirm="@L10n.Text("确定从订单列表删除这条订单吗？", "Remove this order from your list?")"
                                          onsubmit="return confirm(this.dataset.confirm);">
                                        <button type="submit" class="btn btn-sm btn-outline-dark">@L10n.Text("删除订单", "Delete order")</button>
                                    </form>
                                }
                                @if (o.Status == OrderStatus.Completed)
                                {
                                    var reviewItem = o.Items.FirstOrDefault(item => !myReviews.ContainsKey($"{o.Id}:{item.ProductId}"));
                                    if (reviewItem is not null)
                                    {
                                        <a asp-controller="Products" asp-action="Details" asp-route-id="@reviewItem.ProductId" asp-route-orderId="@o.Id" asp-fragment="write-review" class="btn btn-sm btn-outline-dark member-order-review-link">
                                            @Loc["WriteReview"]
                                        </a>
                                    }
                                }
                            </div>
                            <span class="member-order-total">@Loc["Total"]：<span class="text-danger">¥@o.Total.ToString("F2")</span></span>
                        </div>
                        @if (o.Status == OrderStatus.Delivered && o.AutoConfirmAt.HasValue)
                        {
                            <div class="member-order-confirmation">
                                <i class="bi bi-clock" aria-hidden="true"></i>
                                <span>@L10n.Text("等待买家确认收货", "Awaiting buyer confirmation")</span>
                                <strong data-auto-confirm-at="@DateTime.SpecifyKind(o.AutoConfirmAt.Value, DateTimeKind.Utc).ToString("O")"></strong>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

<div class="modal fade" id="trackingModal" tabindex="-1" aria-labelledby="trackingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title fs-5 fw-bold" id="trackingModalLabel">@L10n.Text("物流进度", "Delivery progress")</h2>
                    <div class="text-muted small mt-1">
                        <span id="trackingCarrier"></span> · <span id="trackingNumber" class="font-monospace"></span>
                    </div>
                    <div class="live-update-indicator mt-1">
                        <span aria-hidden="true"></span>@L10n.Text("每秒实时更新", "Live updates every second")
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Loc["Cancel"]"></button>
            </div>
            <div class="modal-body">
                <div id="trackingTimeline" class="order-tracking-timeline"></div>
                <div id="trackingConfirmationPanel" class="member-order-confirmation" hidden>
                    <i class="bi bi-clock" aria-hidden="true"></i>
                    <span>@L10n.Text("等待买家确认收货", "Awaiting buyer confirmation")</span>
                    <strong id="trackingAutoConfirmCountdown"></strong>
                    <button type="button" class="btn btn-sm btn-outline-dark" id="trackingConfirmButton">
                        @L10n.Text("确认收货", "Confirm receipt")
                    </button>
                </div>
                <a id="officialTrackingLink" href="#" target="_blank" rel="noopener" class="btn btn-outline-dark w-100 mt-3">@L10n.Text("官方物流查询", "Official tracking")</a>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="afterSalesModal" tabindex="-1" aria-labelledby="afterSalesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-controller="Orders" asp-action="RequestAfterSales" method="post">
                <input type="hidden" name="orderId" id="afterSalesOrderId" />
                <div class="modal-header">
                    <h2 class="modal-title fs-5 fw-bold" id="afterSalesModalLabel">@L10n.Text("申请售后", "Request after-sales")</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Loc["Cancel"]"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">@L10n.Text("售后类型", "Type")</label>
                        <select name="type" class="form-select">
                            <option value="@AfterSalesType.Return">@L10n.Text("退货", "Return")</option>
                            <option value="@AfterSalesType.Exchange">@L10n.Text("换货", "Exchange")</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L10n.Text("原因说明", "Reason")</label>
                        <textarea name="reason" class="form-control" rows="3" required maxlength="1000"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                    <button type="submit" class="btn btn-primary">@L10n.Text("提交申请", "Submit")</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const orderToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        let buyerTrackingPollTimer = null;
        let activeTrackingOrderId = null;
        let activeTrackingOrderNo = '';
        const autoConfirmTemplate = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            L10n.Text("{0} 后自动确认", "Auto-confirms in {0}")));
        const autoConfirmExpired = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            L10n.Text("正在自动确认收货…", "Processing automatic confirmation…")));
        const confirmReceiptPrompt = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            L10n.Text("确认已经收到订单 {0} 的商品吗？", "Have you received order {0}?")));

        function formatAutoConfirmRemaining(target) {
            const milliseconds = Date.parse(target) - Date.now();
            if (!Number.isFinite(milliseconds)) return '';
            if (milliseconds <= 0) return autoConfirmExpired;
            const totalSeconds = Math.floor(milliseconds / 1000);
            const days = Math.floor(totalSeconds / 86400);
            const hours = Math.floor(totalSeconds % 86400 / 3600);
            const minutes = Math.floor(totalSeconds % 3600 / 60);
            const seconds = totalSeconds % 60;
            const value = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                L10n.IsEnglish ? "{0}d {1}h {2}m {3}s" : "{0}天 {1}小时 {2}分 {3}秒"));
            return autoConfirmTemplate.replace('{0}', value
                .replace('{0}', String(days))
                .replace('{1}', String(hours))
                .replace('{2}', String(minutes))
                .replace('{3}', String(seconds)));
        }

        function updateAutoConfirmCountdowns() {
            document.querySelectorAll('[data-auto-confirm-at]').forEach(element => {
                element.textContent = formatAutoConfirmRemaining(element.dataset.autoConfirmAt);
            });
            const trackingCountdown = document.getElementById('trackingAutoConfirmCountdown');
            const panel = document.getElementById('trackingConfirmationPanel');
            if (trackingCountdown && panel && !panel.hidden) {
                trackingCountdown.textContent = formatAutoConfirmRemaining(trackingCountdown.dataset.autoConfirmAt);
            }
        }

        function showOrderAlert(message, success) {
            const el = document.getElementById('orderAlert');
            if (!el) { alert(message); return; }
            el.className = 'alert ' + (success ? 'alert-success' : 'alert-danger');
            el.textContent = message;
            el.classList.remove('d-none');
            window.scrollTo({ top: 0, behavior: 'smooth' });
            setTimeout(() => el.classList.add('d-none'), 2000);
        }

        function loadBuyerTracking(orderId) {
            const timeline = document.getElementById('trackingTimeline');
            return fetch(`/Orders/GetOrderTracking?orderId=${orderId}`)
                .then(r => r.json())
                .then(data => {
                    if (!data.success) { timeline.innerHTML = `<div class="alert alert-warning">${data.message}</div>`; return; }
                    const t = data.tracking;
                    document.getElementById('trackingCarrier').textContent = t.carrier || 'Carrier';
                    document.getElementById('trackingNumber').textContent = t.trackingNumber || 'Pending';
                    document.getElementById('officialTrackingLink').href = t.officialTrackingUrl || '#';
                    const confirmationPanel = document.getElementById('trackingConfirmationPanel');
                    const countdown = document.getElementById('trackingAutoConfirmCountdown');
                    if (t.status === '@OrderStatus.Delivered' && t.autoConfirmAt) {
                        countdown.dataset.autoConfirmAt = t.autoConfirmAt;
                        countdown.textContent = formatAutoConfirmRemaining(t.autoConfirmAt);
                        confirmationPanel.hidden = false;
                    } else {
                        confirmationPanel.hidden = true;
                        countdown.textContent = '';
                        delete countdown.dataset.autoConfirmAt;
                    }
                    timeline.innerHTML = t.nodes.map(node => `
                        <div class="order-tracking-node ${node.isReached ? 'is-reached' : 'is-future'} ${node.isCurrentActive ? 'is-current' : ''}">
                            <div class="order-tracking-dot">${node.isReached ? '✓' : ''}</div>
                            <div class="order-tracking-body">
                                <strong>${node.title}</strong>
                                <span class="text-muted">${node.formattedTime || ''}</span>
                                <p>${node.description}</p>
                            </div>
                        </div>`).join('');
                })
                .catch(() => timeline.innerHTML = '<div class="alert alert-danger">Failed to load tracking.</div>');
        }

        function openTrackingModal(orderId, orderNo) {
            activeTrackingOrderId = orderId;
            activeTrackingOrderNo = orderNo || '';
            const timeline = document.getElementById('trackingTimeline');
            timeline.innerHTML = '<div class="text-center text-muted py-4">Loading…</div>';
            bootstrap.Modal.getOrCreateInstance(document.getElementById('trackingModal')).show();
            loadBuyerTracking(orderId);
            if (buyerTrackingPollTimer) clearInterval(buyerTrackingPollTimer);
            buyerTrackingPollTimer = setInterval(() => loadBuyerTracking(orderId), 1000);
        }

        document.getElementById('trackingModal')?.addEventListener('hidden.bs.modal', function () {
            if (buyerTrackingPollTimer) {
                clearInterval(buyerTrackingPollTimer);
                buyerTrackingPollTimer = null;
            }
            activeTrackingOrderId = null;
            activeTrackingOrderNo = '';
        });

        document.getElementById('trackingConfirmButton')?.addEventListener('click', function () {
            if (activeTrackingOrderId) confirmReceipt(activeTrackingOrderId, activeTrackingOrderNo);
        });

        function confirmReceipt(orderId, orderNo) {
            if (!confirm(confirmReceiptPrompt.replace('{0}', orderNo || ''))) return;
            fetch('/Orders/ConfirmReceipt', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': orderToken },
                body: new URLSearchParams({ orderId })
            }).then(r => r.json()).then(data => {
                showOrderAlert(data.message, data.success);
                if (data.success) setTimeout(() => location.reload(), 700);
            });
        }

        function openAfterSalesModal(orderId) {
            document.getElementById('afterSalesOrderId').value = orderId;
            bootstrap.Modal.getOrCreateInstance(document.getElementById('afterSalesModal')).show();
        }

        updateAutoConfirmCountdowns();
        window.setInterval(updateAutoConfirmCountdowns, 1000);
    </script>
}
