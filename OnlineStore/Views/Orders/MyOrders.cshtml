@model IReadOnlyList<Order>
@{
    ViewData["Title"] = Loc["MyOrders"].Value;
}
@functions {
    string StatusBadge(string status) => status switch
    {
        OrderStatus.PendingShipment => "bg-warning-subtle text-warning",
        OrderStatus.Shipped => "bg-info-subtle text-info",
        OrderStatus.Completed => "bg-success-subtle text-success",
        OrderStatus.Refunded => "bg-danger-subtle text-danger",
        _ => "bg-secondary-subtle text-secondary"
    };
}
<div class="container py-4">
    <h1 class="h4 mb-4">@Loc["MyOrders"]</h1>
    @if (Model.Count == 0)
    {
        <div class="alert alert-light border text-center py-5">
            <i class="bi bi-inbox display-5 d-block mb-3 text-muted"></i>
            <p class="mb-3">@Loc["NoOrders"]</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary">@Loc["ContinueShopping"]</a>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="list-group list-group-flush">
                @foreach (var o in Model)
                {
                    <div class="list-group-item py-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <span class="text-muted small me-2">@Loc["OrderNo"]：@o.OrderNo</span>
                                <span class="text-muted small">@o.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                            </div>
                            <span class="badge @StatusBadge(o.Status)">@L10n.Status(o.Status)</span>
                        </div>
                        <ul class="list-unstyled mb-2">
                            @foreach (var i in o.Items)
                            {
                                <li class="d-flex justify-content-between py-1">
                                    <span>
                                        @L10n.Text(i.ProductName, i.ProductNameEn)
                                        @if (!string.IsNullOrEmpty(i.Color) || !string.IsNullOrEmpty(i.Spec))
                                        {
                                            <small class="text-muted">@L10n.Text(i.Color ?? "", i.ColorEn) @L10n.Text(i.Spec ?? "", i.SpecEn)</small>
                                        }
                                        <small class="text-muted">× @i.Quantity</small>
                                    </span>
                                    <span>¥@i.LineTotal.ToString("F2")</span>
                                </li>
                            }
                        </ul>
                        @if (o.DiscountAmount > 0)
                        {
                            <div class="text-end small text-success">@Loc["Discount"]（@o.CouponCode）：-¥@o.DiscountAmount.ToString("F2")</div>
                        }
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            @if (o.Status == OrderStatus.PendingShipment)
                            {
                                <form asp-controller="Orders" asp-action="Cancel" asp-route-id="@o.Id" method="post" onsubmit="return confirm('@Loc["ConfirmCancelOrder"]');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">@Loc["CancelOrder"]</button>
                                </form>
                            }
                            else
                            {
                                <span></span>
                            }
                            <span class="fw-semibold">@Loc["Total"]：<span class="text-danger">¥@o.Total.ToString("F2")</span></span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
