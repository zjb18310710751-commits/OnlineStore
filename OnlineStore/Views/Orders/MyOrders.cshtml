@model IReadOnlyList<Order>
@{
    ViewData["Title"] = Loc["MyOrders"].Value;
}
@functions {
    string StatusBadge(string status) => status switch
    {
        OrderStatus.PendingShipment => "bg-warning-subtle text-warning",
        OrderStatus.Shipped => "bg-info-subtle text-info",
        OrderStatus.Completed => "bg-success-subtle text-success",
        OrderStatus.Refunded => "bg-danger-subtle text-danger",
        _ => "bg-secondary-subtle text-secondary"
    };
}
<div class="container coupon-wallet-page member-orders-page">
    <header class="coupon-wallet-header">
        <div>
            <p class="coupon-wallet-eyebrow">@L10n.Text("账户中心", "Member account")</p>
            <h1>@Loc["MyOrders"]</h1>
            <p>@L10n.Text("查看你的订单记录与配送状态。", "Review your orders and delivery status.")</p>
        </div>
        <div class="coupon-wallet-count">
            <strong>@Model.Count</strong>
            <span>@L10n.Text("笔订单", "orders")</span>
        </div>
    </header>
    @if (Model.Count == 0)
    {
        <section class="coupon-wallet-empty">
            <i class="bi bi-inbox"></i>
            <h2>@Loc["NoOrders"]</h2>
            <p>@L10n.Text("还没有订单记录，去看看今天的精选商品。", "You have no orders yet. Explore today's picks.")</p>
            <a asp-controller="Products" asp-action="Index" class="sf-button">@Loc["ContinueShopping"]</a>
        </section>
    }
    else
    {
        <div class="card member-orders-card">
            <div class="list-group list-group-flush">
                @foreach (var o in Model)
                {
                    <div class="list-group-item member-order-item">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <span class="text-muted member-order-meta me-2">@Loc["OrderNo"]：@o.OrderNo</span>
                                <span class="text-muted member-order-meta">@o.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                            </div>
                            <span class="badge member-order-status @StatusBadge(o.Status)">@L10n.Status(o.Status)</span>
                        </div>
                        <ul class="list-unstyled member-order-lines mb-2">
                            @foreach (var i in o.Items)
                            {
                                <li class="d-flex justify-content-between member-order-line">
                                    <span>
                                        @L10n.Text(i.ProductName, i.ProductNameEn)
                                        @if (!string.IsNullOrEmpty(i.Color) || !string.IsNullOrEmpty(i.Spec))
                                        {
                                            <small class="text-muted member-order-detail">@L10n.Text(i.Color ?? "", i.ColorEn) @L10n.Text(i.Spec ?? "", i.SpecEn)</small>
                                        }
                                        <small class="text-muted member-order-detail">× @i.Quantity</small>
                                    </span>
                                    <span>¥@i.LineTotal.ToString("F2")</span>
                                </li>
                            }
                        </ul>
                        @if (!string.IsNullOrWhiteSpace(o.CouponName))
                        {
                            <div class="text-end text-success member-order-discount">@Loc["Discount"]（@o.CouponName）：-¥@o.DiscountAmount.ToString("F2")</div>
                        }
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            @if (o.Status == OrderStatus.PendingShipment)
                            {
                                <form asp-controller="Orders" asp-action="Cancel" asp-route-id="@o.Id" method="post" data-confirm="@Loc["ConfirmCancelOrder"]" onsubmit="return confirm(this.dataset.confirm);">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">@Loc["CancelOrder"]</button>
                                </form>
                            }
                            else
                            {
                                <span></span>
                            }
                            <span class="member-order-total">@Loc["Total"]：<span class="text-danger">¥@o.Total.ToString("F2")</span></span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
