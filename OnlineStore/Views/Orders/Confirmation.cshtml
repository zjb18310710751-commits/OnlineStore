@model Order
@{
    ViewData["Title"] = Loc["OrderPlaced"].Value;
}
<div class="container py-5">
    <div class="text-center mb-4">
        <i class="bi bi-check-circle-fill display-1 text-success"></i>
        <h1 class="h3 mt-2">@Loc["OrderPlaced"]</h1>
        <p class="text-muted">@Loc["OrderNo"]：@Model.OrderNo</p>
    </div>
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <dl class="row mb-3">
                        <dt class="col-sm-3 text-muted">@Loc["Receiver"]</dt><dd class="col-sm-9">@Model.UserName · @Model.Phone</dd>
                        <dt class="col-sm-3 text-muted">@Loc["Address"]</dt><dd class="col-sm-9">@Model.Address</dd>
                        <dt class="col-sm-3 text-muted">@Loc["OrderStatus"]</dt><dd class="col-sm-9"><span class="badge bg-warning-subtle text-warning">@L10n.Status(Model.Status)</span></dd>
                    </dl>
                    <table class="table table-sm align-middle">
                        <thead class="table-light">
                            <tr><th>@Loc["Name"]</th><th>@Loc["Quantity"]</th><th class="text-end">@Loc["Subtotal"]</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var i in Model.Items)
                            {
                                <tr>
                                    <td>
                                        @L10n.Text(i.ProductName, i.ProductNameEn)
                                        @if (!string.IsNullOrEmpty(i.Color) || !string.IsNullOrEmpty(i.Spec))
                                        {
                                            <small class="text-muted">@L10n.Text(i.Color ?? "", i.ColorEn) @L10n.Text(i.Spec ?? "", i.SpecEn)</small>
                                        }
                                    </td>
                                    <td>× @i.Quantity</td>
                                    <td class="text-end">¥@i.LineTotal.ToString("F2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (!string.IsNullOrWhiteSpace(Model.CouponName))
                    {
                        <div class="text-end small text-muted">@Loc["Subtotal"]：¥@((Model.Total + Model.DiscountAmount).ToString("F2"))</div>
                        <div class="text-end small text-success">@Loc["Discount"]（@Model.CouponName）：-¥@Model.DiscountAmount.ToString("F2")</div>
                    }
                    <div class="text-end fw-bold">@Loc["Total"]：<span class="text-danger">¥@Model.Total.ToString("F2")</span></div>
                    <div class="mt-3">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">@Loc["ContinueShopping"]</a>
                        <a asp-controller="Orders" asp-action="MyOrders" class="btn btn-outline-secondary">@Loc["MyOrders"]</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
