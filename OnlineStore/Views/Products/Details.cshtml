@model Product
@{
    ViewData["Title"] = Model.Name;
    var skus = Model.Skus.Where(s => s.IsActive).ToList();
    var colors = skus.Select(s => s.Color).Where(c => !string.IsNullOrWhiteSpace(c)).Distinct().ToList();
    var specs = skus.Select(s => s.Spec).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().ToList();
    var reviews = Model.Reviews.OrderByDescending(r => r.CreatedAt).ToList();
    var avgRating = reviews.Count > 0 ? Math.Round(reviews.Average(r => r.Rating), 1) : 0;
    var hasSku = skus.Count > 0;
    var skusJson = System.Text.Json.JsonSerializer.Serialize(
        skus.Select(s => new { s.Id, s.Color, s.Spec, s.Price, s.Stock, s.ImageUrl }));
    var images = Model.Images.OrderBy(i => i.SortOrder).Select(i => i.ImageUrl).ToList();
    if (images.Count == 0 && !string.IsNullOrEmpty(Model.ImageUrl)) images.Add(Model.ImageUrl);
    var isFavorite = ViewData["IsFavorite"] as bool? ?? false;
}
<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">@Loc["Home"]</a></li>
            <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index">@Loc["Products"]</a></li>
            @foreach (var c in Model.Categories)
            {
                <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index" asp-route-categoryId="@c.Id">@c.Name</a></li>
            }
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row g-4">
        <div class="col-lg-4 order-lg-2">
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3">
                        <div class="shop-avatar"><i class="bi bi-shop"></i></div>
                        <div>
                            <div class="fw-semibold">@(Model.Shop?.Name ?? "—")</div>
                            <div class="text-warning small">
                                @(new string('★', (int)Math.Round(Model.Shop?.Rating ?? 0)))
                                <span class="text-dark ms-1">@(Model.Shop?.Rating.ToString("0.0") ?? "—")</span>
                            </div>
                            <div class="text-muted small">@Loc["SoldCount", Model.Shop?.SalesCount ?? 0]</div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Shop?.Description))
                    {
                        <p class="text-muted small mt-2 mb-2">@Model.Shop.Description</p>
                    }
                    <a asp-controller="Shops" asp-action="Index" asp-route-id="@Model.Shop?.Id" class="btn btn-sm btn-outline-primary w-100">@Loc["VisitShop"]</a>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-white fw-semibold">@Loc["Parameters"]</div>
                <div class="card-body">
                    @if (Model.Specs.Count == 0)
                    {
                        <span class="text-muted small">@Loc["NoSpecs"]</span>
                    }
                    else
                    {
                        <dl class="mb-0">
                            @foreach (var s in Model.Specs.OrderBy(x => x.DisplayOrder))
                            {
                                <div class="spec-row"><dt>@s.Name</dt><dd>@s.Value</dd></div>
                            }
                        </dl>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-8 order-lg-1">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="product-detail-thumb d-flex align-items-center justify-content-center mb-2">
                                @if (images.Count > 0)
                                {
                                    <img id="mainImage" src="@images[0]" data-current="@images[0]" alt="@Model.Name" />
                                }
                                else
                                {
                                    <i class="bi bi-image" style="font-size:5rem;color:#cbd2dc"></i>
                                }
                            </div>
                            @if (images.Count > 1)
                            {
                                <div class="d-flex gap-2 flex-wrap" id="galleryStrip">
                                    @for (var i = 0; i < images.Count; i++)
                                    {
                                        <button type="button" class="gallery-thumb @(i == 0 ? "active" : "")" onclick="switchImage(this, '@images[i]')">
                                            <img src="@images[i]" alt="" />
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                        <div class="col-md-6">
                            <h1 class="h5 mb-2">@Model.Name</h1>
                            <div class="d-flex align-items-baseline gap-2 mb-1">
                                <span class="fs-3 fw-bold text-danger">¥<span id="priceText">@Model.Price.ToString("F2")</span></span>
                                @if (Model.IsOnSale)
                                {
                                    <span id="originalPriceBox" class="d-flex align-items-baseline gap-1">
                                        <span class="text-muted text-decoration-line-through">¥@Model.OriginalPrice!.Value.ToString("F2")</span>
                                        <span class="badge bg-danger">@Loc["DiscountPercent", Model.DiscountPercent ?? 0]</span>
                                    </span>
                                }
                                <span class="text-muted small">@Loc["SoldCount", Model.Shop?.SalesCount ?? 0]</span>
                            </div>
                            <div class="text-muted small mb-3" id="stockText">@Loc["StockLeft", Model.Stock]</div>

                            <div class="mb-2">
                                @foreach (var c in Model.Categories)
                                {
                                    <a asp-controller="Products" asp-action="Index" asp-route-categoryId="@c.Id" class="badge bg-light text-dark text-decoration-none me-1">@c.Name</a>
                                }
                            </div>

                            <div class="shipping-box small text-muted mb-3">
                                <i class="bi bi-truck me-1"></i>@Loc["Delivery"]：@(Model.ShippingFrom ?? "—") · @(Model.ShippingFee ?? "—") · @(Model.DeliveryTime ?? "—")
                            </div>

                            @if (hasSku)
                            {
                                <div class="mb-2">
                                    <div class="sku-label">@Loc["Color"]</div>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var c in colors)
                                        {
                                            <button type="button" class="sku-chip" data-dim="color" data-value="@c">@c</button>
                                        }
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <div class="sku-label">@Loc["Spec"]</div>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var s in specs)
                                        {
                                            <button type="button" class="sku-chip" data-dim="spec" data-value="@s">@s</button>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="mb-3">
                                <div class="sku-label">@Loc["Quantity"]</div>
                                <div class="input-group" style="max-width:150px;">
                                    <button type="button" class="btn btn-outline-secondary" onclick="stepQty(this,-1)"><i class="bi bi-dash"></i></button>
                                    <input id="qty" type="number" class="form-control text-center" value="1" min="1" max="@Model.Stock" aria-label="@Loc["Quantity"].Value" />
                                    <button type="button" class="btn btn-outline-secondary" onclick="stepQty(this,1)"><i class="bi bi-plus"></i></button>
                                </div>
                            </div>

                            <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex gap-2">
                                <input type="hidden" name="productId" value="@Model.Id" />
                                <input type="hidden" name="skuId" id="skuIdInput" value="" />
                                <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                                <button type="submit" class="btn btn-danger btn-lg flex-grow-1"><i class="bi bi-cart-plus me-1"></i>@Loc["AddToCart"]</button>
                                <button type="submit" class="btn btn-warning btn-lg" formaction="@Url.Action("Add", "Cart", new { buyNow = true })">@Loc["BuyNow"]</button>
                            </form>
                            <form asp-controller="Favorites" asp-action="Toggle" method="post" class="mt-2">
                                <input type="hidden" name="productId" value="@Model.Id" />
                                <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                                <button type="submit" class="btn btn-sm w-100 @(isFavorite ? "btn-outline-danger" : "btn-outline-secondary")">
                                    <i class="bi @(isFavorite ? "bi-heart-fill" : "bi-heart") me-1"></i>@(isFavorite ? Loc["Favorited"].Value : Loc["Favorite"].Value)
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-white fw-semibold">
                    @Loc["Reviews"]
                    @if (reviews.Count > 0)
                    {
                        <span class="text-warning ms-1">@(new string('★', (int)Math.Round(avgRating)))</span>
                        <span class="text-muted small ms-1">@avgRating.ToString("0.0")（@reviews.Count）</span>
                    }
                </div>
                <div class="card-body">
                    @if (reviews.Count > 0)
                    {
                        <div class="d-flex align-items-center gap-4 mb-3 pb-3 border-bottom">
                            <div class="text-center" style="min-width:84px">
                                <div class="fs-2 fw-bold text-danger">@avgRating.ToString("0.0")</div>
                                <div class="text-warning">@(new string('★', (int)Math.Round(avgRating)))</div>
                                <div class="text-muted small">@reviews.Count @Loc["ReviewsCount"]</div>
                            </div>
                            <div class="flex-grow-1">
                                @for (var star = 5; star >= 1; star--)
                                {
                                    var cnt = reviews.Count(r => r.Rating == star);
                                    var pct = reviews.Count > 0 ? (int)Math.Round(cnt * 100.0 / reviews.Count) : 0;
                                    <div class="d-flex align-items-center gap-2 small mb-1">
                                        <span class="text-nowrap text-muted" style="width:28px">@star★</span>
                                        <div class="progress flex-grow-1" style="height:8px"><div class="progress-bar bg-warning" style="width:@pct%"></div></div>
                                        <span class="text-muted" style="width:24px">@cnt</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    @if (reviews.Count == 0)
                    {
                        <p class="text-muted mb-0">@Loc["NoReviews"]</p>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var r in reviews)
                            {
                                <li class="review-item py-3 @(r != reviews.First() ? "border-top" : "")">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="fw-semibold">@r.UserName</span>
                                        <span class="text-muted small">@r.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</span>
                                    </div>
                                    <div class="text-warning small">@(new string('★', r.Rating))</div>
                                    @if (!string.IsNullOrEmpty(r.Comment))
                                    {
                                        <p class="mb-0 text-secondary">@r.Comment</p>
                                    }
                                    @if (!string.IsNullOrEmpty(r.ImageUrl))
                                    {
                                        <img src="@r.ImageUrl" class="review-img mt-2" alt="@r.UserName" loading="lazy" />
                                    }
                                </li>
                            }
                        </ul>
                    }

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Reviews" asp-action="Create" method="post" enctype="multipart/form-data" class="border-top pt-3 mt-3">
                            <input type="hidden" name="productId" value="@Model.Id" />
                            <div class="mb-2">
                                <label class="form-label small fw-semibold">@Loc["YourRating"]</label>
                                <select name="rating" class="form-select form-select-sm" style="max-width:140px;">
                                    <option value="5">★★★★★</option>
                                    <option value="4">★★★★</option>
                                    <option value="3">★★★</option>
                                    <option value="2">★★</option>
                                    <option value="1">★</option>
                                </select>
                            </div>
                            <div class="mb-2">
                                <textarea name="comment" class="form-control" rows="3" placeholder="说说你的使用感受…"></textarea>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small fw-semibold">@Loc["ReviewImage"]</label>
                                <input type="file" name="image" class="form-control form-control-sm" accept=".jpg,.jpeg,.png,.webp,.gif" />
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm">@Loc["SubmitReview"]</button>
                        </form>
                    }
                    else
                    {
                        <p class="text-muted small mb-0 mt-3"><a asp-controller="Account" asp-action="Login">@Loc["Login"]</a> @Loc["LoginToReview"]</p>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="card shadow-sm mt-4">
        <div class="card-header bg-white fw-semibold">@Loc["DetailIntro"]</div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(Model.DetailHtml))
            {
                @Html.Raw(Model.DetailHtml)
            }
            else
            {
                <p class="text-muted mb-0">@Model.Description</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    @if (hasSku)
    {
        <script>
            (function () {
                const skus = @Html.Raw(skusJson);
                const stockTemplate = '@Loc["StockLeft"].Value';
                let selectedColor = null, selectedSpec = null;

                const priceEl = document.getElementById('priceText');
                const stockEl = document.getElementById('stockText');
                const originalBox = document.getElementById('originalPriceBox');
                const mainImg = document.getElementById('mainImage');
                const skuInput = document.getElementById('skuIdInput');
                const qtyInput = document.getElementById('qty');
                const galleryStrip = document.getElementById('galleryStrip');
                const originalGallery = galleryStrip ? galleryStrip.innerHTML : '';

                function findSku() {
                    return skus.find(s => s.Color === selectedColor && s.Spec === selectedSpec) || null;
                }
                function refresh() {
                    const sku = findSku();
                    if (sku) {
                        priceEl.textContent = sku.Price.toFixed(2);
                        stockEl.textContent = stockTemplate.replace('{0}', sku.Stock);
                        skuInput.value = sku.Id;
                        qtyInput.max = sku.Stock;
                        if (originalBox) originalBox.classList.add('d-none');
                        if (sku.ImageUrl) {
                            setMainImage(sku.ImageUrl);
                            if (galleryStrip) {
                                galleryStrip.innerHTML = '<button type="button" class="gallery-thumb active"><img src="' + sku.ImageUrl + '" alt="" /></button>';
                            }
                        } else if (galleryStrip) {
                            galleryStrip.innerHTML = originalGallery;
                        }
                    }
                }
                document.querySelectorAll('.sku-chip').forEach(chip => {
                    chip.addEventListener('click', () => {
                        const dim = chip.dataset.dim, val = chip.dataset.value;
                        if (dim === 'color') selectedColor = val; else selectedSpec = val;
                        document.querySelectorAll('.sku-chip[data-dim="' + dim + '"]').forEach(c => c.classList.remove('active'));
                        chip.classList.add('active');
                        refresh();
                    });
                });
                // 默认选中第一组颜色+规格
                const firstColor = document.querySelector('.sku-chip[data-dim="color"]');
                const firstSpec = document.querySelector('.sku-chip[data-dim="spec"]');
                if (firstColor) firstColor.click();
                if (firstSpec) firstSpec.click();
            })();
        </script>
    }
}
