@model Product
@{
    ViewData["Title"] = Model.Name;
}
<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">@Loc["Home"]</a></li>
            <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index">@Loc["Products"]</a></li>
            @if (Model.Category is not null)
            {
                <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index" asp-route-categoryId="@Model.Category.Id">@Model.Category.Name</a></li>
            }
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="product-detail-thumb d-flex align-items-center justify-content-center">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="img-fluid" alt="@Model.Name" />
                }
                else
                {
                    <i class="bi bi-image product-thumb-placeholder"></i>
                }
            </div>
        </div>
        <div class="col-md-6">
            <h1 class="h3">@Model.Name</h1>
            <p class="text-muted">@Loc["Category"]：@Model.Category?.Name · @Loc["Sku"]：@(Model.Sku ?? "—")</p>
            <div class="price fs-2 fw-bold my-3">¥@Model.Price.ToString("F2")</div>
            <p class="mb-1">
                @Loc["Stock"]：
                <span class="badge @(Model.Stock > 0 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                    @(Model.Stock > 0 ? Loc["InStockCount", Model.Stock].Value : Loc["OutOfStock"].Value)
                </span>
            </p>
            <hr />
            <p class="text-secondary">@Model.Description</p>
            @if (Model.Stock > 0)
            {
                <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex flex-wrap gap-2 align-items-stretch">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                    <div class="input-group" style="max-width: 150px;">
                        <button type="button" class="btn btn-outline-secondary" onclick="stepQty(this, -1)"><i class="bi bi-dash"></i></button>
                        <input type="number" name="quantity" id="detailQty" class="form-control text-center" value="1" min="1" max="@Model.Stock" aria-label="@Loc["Quantity"].Value" />
                        <button type="button" class="btn btn-outline-secondary" onclick="stepQty(this, 1)"><i class="bi bi-plus"></i></button>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg flex-grow-1"><i class="bi bi-cart-plus me-1"></i>@Loc["AddToCart"]</button>
                </form>
            }
            else
            {
                <button class="btn btn-secondary btn-lg" disabled>@Loc["OutOfStock"]</button>
            }
        </div>
    </div>
</div>
