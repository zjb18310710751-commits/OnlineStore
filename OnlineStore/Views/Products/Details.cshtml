@model Product
@{
    ViewData["Title"] = L10n.Name(Model);
    var skus = Model.Skus.Where(s => s.IsActive).ToList();
    var colors = skus.Select(s => s.Color).Where(c => !string.IsNullOrWhiteSpace(c)).Distinct().ToList();
    var specs = skus.Select(s => s.Spec).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().ToList();
    var colorEn = skus.Where(s => s.ColorEn != null).GroupBy(s => s.Color).ToDictionary(g => g.Key, g => g.First().ColorEn);
    var specEn = skus.Where(s => s.SpecEn != null).GroupBy(s => s.Spec).ToDictionary(g => g.Key, g => g.First().SpecEn);
    var hasSku = skus.Count > 0;
    var skusJson = System.Text.Json.JsonSerializer.Serialize(
        skus.Select(s => new { s.Id, s.Color, s.Spec, s.Price, s.Stock, s.ImageUrl }));
    var images = Model.Images.OrderBy(i => i.SortOrder).Select(i => i.ImageUrl).ToList();
    if (images.Count == 0 && !string.IsNullOrEmpty(Model.ImageUrl)) images.Add(Model.ImageUrl);
    var isFavorite = ViewData["IsFavorite"] as bool? ?? false;
}
<div class="sf-container pd-product-page">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">@Loc["Home"]</a></li>
            <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index">@Loc["Products"]</a></li>
            @foreach (var c in Model.Categories)
            {
                <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index" asp-route-categoryId="@c.Id">@L10n.Name(c)</a></li>
            }
            <li class="breadcrumb-item active" aria-current="page">@L10n.Name(Model)</li>
        </ol>
    </nav>

    <div class="row g-4" id="product-overview">
        <div class="col-lg-4 order-lg-2">
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3">
                        <div class="shop-avatar shop-avatar--logo">
                            @if (!string.IsNullOrWhiteSpace(Model.Shop?.LogoUrl))
                            {
                                <img src="@Model.Shop.LogoUrl" alt="@L10n.Name(Model.Shop)" />
                            }
                            else
                            {
                                <i class="bi bi-shop"></i>
                            }
                        </div>
                        <div>
                            <div class="fw-semibold">@(Model.Shop is null ? "—" : L10n.Name(Model.Shop))</div>
                            <div class="text-warning small">
                                @(new string('★', (int)Math.Round(Model.Shop?.Rating ?? 0)))
                                <span class="text-dark ms-1">@(Model.Shop?.Rating.ToString("0.0") ?? "—")</span>
                            </div>
                            <div class="text-muted small">@Loc["SoldCount", Model.Shop?.SalesCount ?? 0]</div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Shop?.Description))
                    {
                        <p class="text-muted small mt-2 mb-2">@L10n.Description(Model.Shop)</p>
                    }
                    <a asp-controller="Shops" asp-action="Index" asp-route-id="@Model.Shop?.Id" class="btn btn-sm btn-outline-primary w-100">@Loc["VisitShop"]</a>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-white fw-semibold" id="product-specifications">@Loc["Parameters"]</div>
                <div class="card-body">
                    @if (Model.Specs.Count == 0)
                    {
                        <span class="text-muted small">@Loc["NoSpecs"]</span>
                    }
                    else
                    {
                        <dl class="mb-0">
                            @foreach (var s in Model.Specs.OrderBy(x => x.DisplayOrder))
                            {
                                <div class="spec-row"><dt>@L10n.Text(s.Name, s.NameEn)</dt><dd>@L10n.Text(s.Value, s.ValueEn)</dd></div>
                            }
                        </dl>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-8 order-lg-1">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="product-detail-thumb d-flex align-items-center justify-content-center mb-2">
                                @if (images.Count > 0)
                                {
                                    <img id="mainImage" src="@images[0]" data-current="@images[0]" alt="@L10n.Name(Model)" />
                                }
                                else
                                {
                                    <i class="bi bi-image" style="font-size:5rem;color:#cbd2dc"></i>
                                }
                            </div>
                            @if (images.Count > 1)
                            {
                                <div class="d-flex gap-2 flex-wrap" id="galleryStrip">
                                    @for (var i = 0; i < images.Count; i++)
                                    {
                                        <button type="button" class="gallery-thumb @(i == 0 ? "active" : "")" onclick="switchImage(this, '@images[i]')">
                                            <img src="@images[i]" alt="" />
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                        <div class="col-md-6">
                            <h1 class="h5 mb-2">@L10n.Name(Model)</h1>
                            <div class="d-flex align-items-baseline gap-2 mb-1">
                                <span class="fs-3 fw-bold text-danger">¥<span id="priceText">@Model.Price.ToString("F2")</span></span>
                                @if (Model.IsOnSale)
                                {
                                    <span id="originalPriceBox" class="d-flex align-items-baseline gap-1">
                                        <span class="text-muted text-decoration-line-through">¥@Model.OriginalPrice!.Value.ToString("F2")</span>
                                        <span class="badge bg-danger">@Loc["DiscountPercent", Model.DiscountPercent ?? 0]</span>
                                    </span>
                                }
                                <span class="text-muted small">@Loc["SoldCount", Model.Shop?.SalesCount ?? 0]</span>
                            </div>
                            <div class="text-muted small mb-3" id="stockText">@Loc["StockLeft", Model.Stock]</div>

                            <div class="mb-2">
                                @foreach (var c in Model.Categories)
                                {
                                    <a asp-controller="Products" asp-action="Index" asp-route-categoryId="@c.Id" class="badge bg-light text-dark text-decoration-none me-1">@L10n.Name(c)</a>
                                }
                            </div>

                            <div class="pd-shipping-panel mb-3">
                                <div class="pd-shipping-title">
                                    <i class="bi bi-truck" aria-hidden="true"></i>
                                    @L10n.Text("配送与发货", "Shipping information")
                                </div>
                                <div class="pd-shipping-grid">
                                    <div>
                                        <span>@L10n.Text("发货地", "Ships from")</span>
                                        <strong>@L10n.Text(Model.ShippingFrom ?? "—", Model.ShippingFromEn)</strong>
                                    </div>
                                    <div>
                                        <span>@L10n.Text("运费", "Shipping fee")</span>
                                        <strong>@L10n.Text(Model.ShippingFee ?? "—", Model.ShippingFeeEn)</strong>
                                    </div>
                                    <div>
                                        <span>@L10n.Text("发货时效", "Dispatch time")</span>
                                        <strong>@L10n.Text(Model.DeliveryTime ?? "—", Model.DeliveryTimeEn)</strong>
                                    </div>
                                </div>
                                <p>@L10n.Text("发货后可在“我的订单”中查看物流进度。", "Track delivery progress from My Orders after dispatch.")</p>
                            </div>

                            @if (hasSku)
                            {
                                <div class="mb-2">
                                    <div class="sku-label">@Loc["Color"]</div>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var c in colors)
                                        {
                                            <button type="button" class="sku-chip" data-dim="color" data-value="@c">@L10n.Text(c, colorEn.GetValueOrDefault(c))</button>
                                        }
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <div class="sku-label">@Loc["Spec"]</div>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var s in specs)
                                        {
                                            <button type="button" class="sku-chip" data-dim="spec" data-value="@s">@L10n.Text(s, specEn.GetValueOrDefault(s))</button>
                                        }
                                    </div>
                                </div>
                            }

                            <form id="addToCartForm" asp-controller="Cart" asp-action="Add" method="post">
                                <input type="hidden" name="productId" value="@Model.Id" />
                                <input type="hidden" name="skuId" id="skuIdInput" value="" />
                                <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                                <div class="mb-3">
                                    <div class="sku-label">@Loc["Quantity"]</div>
                                    <div class="input-group pd-quantity-stepper">
                                        <button type="button" class="pd-qty-btn" onclick="stepQty(this,-1)" aria-label="@L10n.Text("减少数量", "Decrease quantity")"><i class="bi bi-dash"></i></button>
                                        <input id="qty" name="quantity" type="number" class="form-control text-center pd-qty-input" value="1"
                                               min="1" max="@Model.Stock" inputmode="numeric" required aria-label="@Loc["Quantity"].Value" />
                                        <button type="button" class="pd-qty-btn" onclick="stepQty(this,1)" aria-label="@L10n.Text("增加数量", "Increase quantity")"><i class="bi bi-plus"></i></button>
                                    </div>
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-amazon btn-lg flex-grow-1"><i class="bi bi-cart-plus me-1"></i>@Loc["AddToCart"]</button>
                                    <button type="submit" class="btn btn-buy-now btn-lg" formaction="@Url.Action("Add", "Cart", new { buyNow = true })">@Loc["BuyNow"]</button>
                                </div>
                            </form>
                            <form asp-controller="Favorites" asp-action="Toggle" method="post" class="mt-2">
                                <input type="hidden" name="productId" value="@Model.Id" />
                                <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                                <button type="submit" class="btn btn-sm w-100 @(isFavorite ? "btn-outline-danger" : "btn-outline-secondary")">
                                    <i class="bi @(isFavorite ? "bi-heart-fill" : "bi-heart") me-1"></i>@(isFavorite ? Loc["Favorited"].Value : Loc["Favorite"].Value)
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
    <nav class="pd-section-nav" aria-label="@L10n.Text("商品信息", "Product information")">
        <div class="pd-section-links">
            <a href="#product-reviews">@Loc["Reviews"] <span>@Model.Reviews.Count</span></a>
            <a href="#product-story">@Loc["DetailIntro"]</a>
        </div>
        <a class="pd-back-to-product" href="#product-overview">@L10n.Text("返回商品", "Back to product") <i class="bi bi-arrow-up" aria-hidden="true"></i></a>
    </nav>
    <partial name="_ProductReviews" model="Model" />
    <partial name="_ProductStory" model="Model" />
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/product-reviews.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/product-story.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/product-reviews.js" asp-append-version="true"></script>
    @if (hasSku)
    {
        <script>
            (function () {
                const skus = @Html.Raw(skusJson);
                const stockTemplate = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc["StockLeft"].Value));
                let selectedColor = null, selectedSpec = null;

                const priceEl = document.getElementById('priceText');
                const stockEl = document.getElementById('stockText');
                const originalBox = document.getElementById('originalPriceBox');
                const mainImg = document.getElementById('mainImage');
                const skuInput = document.getElementById('skuIdInput');
                const qtyInput = document.getElementById('qty');
                const purchaseButtons = document.getElementById('addToCartForm').querySelectorAll('button[type="submit"]');
                const galleryStrip = document.getElementById('galleryStrip');
                const originalGallery = galleryStrip ? galleryStrip.innerHTML : '';

                function findSku() {
                    return skus.find(s => s.Color === selectedColor && s.Spec === selectedSpec) || null;
                }
                function refresh() {
                    const sku = findSku();
                    const available = sku && sku.Stock > 0;
                    skuInput.value = sku ? sku.Id : '';
                    qtyInput.max = sku ? sku.Stock : 0;
                    purchaseButtons.forEach(button => { button.disabled = !available; });
                    priceEl.textContent = sku ? sku.Price.toFixed(2) : '—';
                    stockEl.textContent = stockTemplate.replace('{0}', sku ? sku.Stock : 0);
                    if (originalBox) originalBox.classList.add('d-none');
                    if (sku) {
                        if (available) qtyInput.value = Math.min(Math.max(parseInt(qtyInput.value, 10) || 1, 1), sku.Stock);
                        if (sku.ImageUrl) {
                            setMainImage(sku.ImageUrl);
                            if (galleryStrip) {
                                galleryStrip.innerHTML = '<button type="button" class="gallery-thumb active"><img src="' + sku.ImageUrl + '" alt="" /></button>';
                            }
                        } else if (galleryStrip) {
                            galleryStrip.innerHTML = originalGallery;
                        }
                    }
                }
                document.querySelectorAll('.sku-chip').forEach(chip => {
                    chip.addEventListener('click', () => {
                        const dim = chip.dataset.dim, val = chip.dataset.value;
                        if (dim === 'color') selectedColor = val; else selectedSpec = val;
                        document.querySelectorAll('.sku-chip[data-dim="' + dim + '"]').forEach(c => c.classList.remove('active'));
                        chip.classList.add('active');
                        refresh();
                    });
                });
                const firstColor = document.querySelector('.sku-chip[data-dim="color"]');
                const firstSpec = document.querySelector('.sku-chip[data-dim="spec"]');
                if (firstColor) firstColor.click();
                if (firstSpec) firstSpec.click();
            })();
        </script>
    }
}
