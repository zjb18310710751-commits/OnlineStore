@model Product
@{
    var summary = ViewData["ReviewSummary"] as ReviewSummary ?? new ReviewSummary(0, 0, 0, new Dictionary<int, int>());
    var reviews = ViewData["LatestReviews"] as IReadOnlyList<Review> ?? Array.Empty<Review>();
    var canReview = ViewData["CanReview"] as bool? == true;
    var reviewOrderId = ViewData["ReviewOrderId"] as int?;
    var average = summary.Average;
    var averageFill = (Math.Clamp(average, 0, 5) * 20).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}#write-review";
    var ratingLabel = L10n.Text("{0} 分，满分 5 分", "{0} out of 5 stars");
}
<section class="sf-reviews" id="product-reviews" aria-labelledby="product-reviews-title">
    <div class="sf-reviews-layout">
        <div class="sf-reviews-rail">
            <header class="sf-reviews-heading">
                <div>
                    <p class="sf-reviews-eyebrow">@L10n.Text("来自日常的真实感受", "THE EVERYDAY PERSPECTIVE")</p>
                    <h2 id="product-reviews-title">@Loc["Reviews"]<span class="sf-reviews-total">(@summary.TotalCount)</span></h2>
                </div>
                <p>@L10n.Text("看看大家怎么说，分享你的使用体验。", "Read their experience. Share your own.")</p>
            </header>
            <aside class="sf-reviews-overview" aria-label="@L10n.Text("评分概览", "Rating overview")">
                <div class="sf-review-score">
                    <span class="sf-review-score-value">@(summary.TotalCount > 0 ? average.ToString("0.0") : "—")</span>
                    <span class="sf-review-score-scale">/ 5</span>
                </div>
                <div class="sf-review-stars" role="img" aria-label="@(summary.TotalCount > 0 ? string.Format(ratingLabel, average.ToString("0.0")) : L10n.Text("暂无评分", "No ratings yet"))">
                    <span class="sf-review-average-stars" style="--review-rating-fill: @(averageFill)%;" aria-hidden="true"><span class="sf-review-stars-empty">★★★★★</span><span class="sf-review-average-stars-fill">★★★★★</span></span>
                </div>
                <p class="sf-review-count">@L10n.Text($"基于 {summary.TotalCount} 条评价", $"Based on {summary.TotalCount} {(summary.TotalCount == 1 ? "review" : "reviews")}")</p>
                <div class="sf-review-distribution">
                    @for (var star = 5; star >= 1; star--)
                    {
                        var count = summary.RatingCounts.GetValueOrDefault(star);
                        <div class="sf-review-distribution-row">
                            <span aria-hidden="true">@star <span class="sf-review-distribution-star">★</span></span>
                            <progress value="@count" max="@Math.Max(summary.TotalCount, 1)" aria-label="@L10n.Text($"{star} 星：{count} 条评价", $"{star} stars: {count} reviews")">@count</progress>
                            <span class="sf-review-distribution-count" aria-hidden="true">@count</span>
                        </div>
                    }
                </div>
                @if (canReview && reviewOrderId.HasValue)
                {
                    <a class="sf-button sf-review-write-link" href="#write-review">@L10n.Text("写下评价", "Write a review")</a>
                }
                else if (User.Identity?.IsAuthenticated != true)
                {
                    <a class="sf-button sf-review-write-link" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl">@L10n.Text("登录并评价", "Sign in to review")</a>
                }
                else
                {
                    <p class="sf-review-purchase-note">@L10n.Text("购买并完成订单后才可以评价。", "You can review this product after a completed purchase.")</p>
                }
                @if (summary.TotalCount > 0)
                {
                    <a class="sf-review-all-link"
                       asp-controller="Products" asp-action="Reviews" asp-route-id="@Model.Id"
                       data-review-archive-open aria-haspopup="dialog" aria-controls="allReviewsDialog">
                        @L10n.Text("全部评价", "All reviews") <span>(@summary.TotalCount)</span>
                    </a>
                }
            </aside>
        </div>
        <div class="sf-reviews-content">
            @if (reviews.Count > 0)
            {
                <div class="sf-review-list">
                    @foreach (var review in reviews)
                    {
                        var name = L10n.Text(review.UserName, review.UserNameEn);
                        var initial = string.IsNullOrWhiteSpace(name) ? "?" : System.Globalization.StringInfo.GetNextTextElement(name.Trim()).ToUpperInvariant();
                        var comment = L10n.Text(review.Comment ?? string.Empty, review.CommentEn);
                        var photoLabel = L10n.Text($"查看 {name} 的评价图片", $"View review photo from {name}");
                        <article class="sf-review-row">
                            <header class="sf-review-row-header">
                                <div class="sf-review-person">
                                    <span class="sf-review-avatar" aria-hidden="true">@initial</span>
                                    <span class="sf-review-name">@name</span>
                                </div>
                                <time datetime="@review.CreatedAt.ToString("O")">@review.CreatedAt.ToLocalTime().ToString(L10n.IsEnglish ? "dd MMM yyyy" : "yyyy年M月d日")</time>
                            </header>
                            <div class="sf-review-stars sf-review-row-stars" role="img" aria-label="@string.Format(ratingLabel, review.Rating)">
                                <span aria-hidden="true">@(new string('★', Math.Clamp(review.Rating, 0, 5)))<span class="sf-review-stars-empty">@(new string('★', 5 - Math.Clamp(review.Rating, 0, 5)))</span></span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(comment))
                            {
                                <p class="sf-review-comment">@comment</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(review.ImageUrl))
                            {
                                <a class="sf-review-photo" href="@review.ImageUrl" data-review-photo aria-label="@photoLabel">
                                    <img src="@review.ImageUrl" alt="@photoLabel" loading="lazy" width="104" height="104" />
                                </a>
                            }
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="sf-reviews-empty">
                    <span class="sf-reviews-empty-mark" aria-hidden="true">“</span>
                    <h3>@L10n.Text("第一份感受，等你分享。", "Be the first to share.")</h3>
                    <p>@L10n.Text("你的使用体验，可以帮助更多人找到适合自己的选择。", "Your everyday experience can help someone find their fit.")</p>
                </div>
            }
            @if (canReview && reviewOrderId.HasValue)
            {
                <details class="sf-review-compose" id="write-review">
                    <summary><span>@L10n.Text("分享你的体验", "Share your experience")</span><span class="sf-review-compose-icon" aria-hidden="true">+</span></summary>
                    <div class="sf-review-compose-body">
                        <form asp-controller="Reviews" asp-action="Create" method="post" enctype="multipart/form-data" class="sf-review-form" data-review-form>
                            <input type="hidden" name="productId" value="@Model.Id" />
                            <input type="hidden" name="orderId" value="@reviewOrderId" />
                            <fieldset class="sf-review-rating">
                                <legend>@Loc["YourRating"]</legend>
                                <div class="sf-review-rating-options">
                                    @for (var star = 1; star <= 5; star++)
                                    {
                                        <label class="sf-review-rating-option">
                                            <input type="radio" name="rating" value="@star" checked="@(star == 5)" required aria-label="@string.Format(ratingLabel, star)" />
                                            <span aria-hidden="true">★</span>
                                        </label>
                                    }
                                </div>
                            </fieldset>
                            <div class="sf-review-field">
                                <label for="review-comment">@L10n.Text("你的评价", "Your review") <span>@L10n.Text("（选填）", "(optional)")</span></label>
                                <textarea id="review-comment" name="comment" rows="4" maxlength="1000" placeholder="@L10n.Text("聊聊使用感受、做工或你最喜欢的细节。", "Tell us about the feel, the quality, or your favorite detail.")" aria-describedby="review-comment-count" data-review-comment></textarea>
                                <span class="sf-review-character-count" id="review-comment-count" data-review-character-count aria-live="polite" aria-atomic="true">0 / 1000</span>
                            </div>
                            <div class="sf-review-upload">
                                <label for="review-image">@Loc["ReviewImage"]</label>
                                <div class="sf-review-file-control">
                                    <input class="sf-review-file-input" type="file" id="review-image" name="image" accept=".jpg,.jpeg,.png,.webp,.gif" aria-describedby="review-image-help review-image-error" data-review-image data-no-file="@L10n.Text("未选择文件", "No file chosen")" data-size-error="@L10n.Text("请选择不超过 5 MB 的图片。", "Choose an image under 5 MB.")" data-type-error="@L10n.Text("请选择 JPG、PNG、WebP 或 GIF 格式的图片。", "Choose a JPG, PNG, WebP, or GIF image.")" />
                                    <label class="sf-review-file-button" for="review-image">@L10n.Text("选择文件", "Choose file")</label>
                                    <span class="sf-review-file-name" data-review-file-name>@L10n.Text("未选择文件", "No file chosen")</span>
                                </div>
                                <p class="sf-review-field-help" id="review-image-help">JPG, PNG, WebP, GIF · @L10n.Text("最大 5 MB", "Up to 5 MB")</p>
                                <p class="sf-review-field-error" id="review-image-error" data-review-image-error role="alert" hidden></p>
                                <div class="sf-review-image-preview" data-review-image-preview hidden>
                                    <img alt="@L10n.Text("待上传的评价图片", "Review photo preview")" width="104" height="104" />
                                    <button type="button" data-review-image-remove>@L10n.Text("移除图片", "Remove photo")</button>
                                </div>
                            </div>
                            <div class="sf-review-form-footer">
                                <p>@L10n.Text("分享真实感受，让每一次选择更有依据。", "A little detail makes your review more helpful.")</p>
                                <button type="submit" class="sf-button">@L10n.Text("发布评价", "Submit review")</button>
                            </div>
                        </form>
                    </div>
                </details>
            }
        </div>
    </div>
    <dialog class="sf-review-archive-dialog ui-dialog-surface" id="allReviewsDialog" data-review-archive-dialog aria-labelledby="allReviewsDialogTitle">
        <div class="sf-review-archive-shell">
            <header class="sf-review-archive-bar">
                <div>
                    <span>@L10n.Text("商品评价", "PRODUCT REVIEWS")</span>
                    <strong id="allReviewsDialogTitle">@L10n.Name(Model)</strong>
                </div>
                <button type="button" class="ui-dialog-close" data-review-archive-close aria-label="@L10n.Text("关闭全部评价", "Close all reviews")">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </header>
            <div class="sf-review-archive-body" data-review-archive-body
                 data-load-error="@L10n.Text("全部评价暂时无法加载，请稍后重试。", "All reviews could not be loaded. Please try again.")">
                <div class="sf-review-archive-loading" role="status">
                    <span aria-hidden="true"></span>
                    @L10n.Text("正在加载全部评价…", "Loading all reviews…")
                </div>
            </div>
        </div>
    </dialog>
</section>
