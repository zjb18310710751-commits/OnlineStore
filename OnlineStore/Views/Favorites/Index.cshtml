@model IReadOnlyList<Product>
@{
    ViewData["Title"] = Loc["MyFavorites"].Value;
}
<div class="container py-4">
    <h1 class="h4 mb-4">@Loc["MyFavorites"]</h1>
    @if (Model.Count == 0)
    {
        <div class="alert alert-light border text-center py-5">
            <i class="bi bi-heart display-5 d-block mb-3 text-muted"></i>
            <p class="mb-3">@Loc["NoFavorites"]</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary">@Loc["ContinueShopping"]</a>
        </div>
    }
    else
    {
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
            @foreach (var p in Model)
            {
                <partial name="_FavoriteCard" model="@p" />
            }
        </div>
    }
</div>
