@model ProductSpec
<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="ProductId" />
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row g-3">
    <div class="col-md-5 mb-3">
        <label asp-for="Name" class="form-label">@Loc["ParamName"]</label>
        <input asp-for="Name" class="form-control" placeholder="@Loc["SpecNamePlaceholder"]" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-md-5 mb-3">
        <label asp-for="Value" class="form-label">@Loc["ParamValue"]</label>
        <input asp-for="Value" class="form-control" placeholder="@Loc["SpecValuePlaceholder"]" />
        <span asp-validation-for="Value" class="text-danger small"></span>
    </div>
    <div class="col-md-2 mb-3">
        <label asp-for="DisplayOrder" class="form-label">@Loc["DisplayOrder"]</label>
        <input asp-for="DisplayOrder" class="form-control" type="number" min="0" />
        <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
    </div>
</div>
<div class="row g-3">
    <div class="col-md-5 mb-3">
        <label asp-for="NameEn" class="form-label">@Loc["SpecNameEn"]</label>
        <input asp-for="NameEn" class="form-control" />
        <span asp-validation-for="NameEn" class="text-danger small"></span>
    </div>
    <div class="col-md-5 mb-3">
        <label asp-for="ValueEn" class="form-label">@Loc["SpecValueEn"]</label>
        <input asp-for="ValueEn" class="form-control" />
        <span asp-validation-for="ValueEn" class="text-danger small"></span>
    </div>
</div>
