@model IReadOnlyList<ProductSpec>
@{
    var product = (Product)ViewBag.Product;
    ViewData["Title"] = Loc["SpecManagement"].Value;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h5 mb-0">@Loc["SpecManagement"] <span class="text-muted">· @L10n.Name(product)</span></h1>
    <a asp-action="Create" asp-route-productId="@product.Id" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>@Loc["AddSpec"]</a>
</div>
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:70px">@Loc["DisplayOrder"]</th>
                    <th>@Loc["ParamName"]</th>
                    <th>@Loc["ParamValue"]</th>
                    <th class="text-end">@Loc["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">@Loc["NoSpecs"]</td></tr>
                }
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="text-muted">@s.DisplayOrder</td>
                        <td class="fw-semibold">@L10n.Text(s.Name, s.NameEn)</td>
                        <td>@L10n.Text(s.Value, s.ValueEn)</td>
                        <td class="text-end text-nowrap">
                            <div class="admin-icon-actions">
                                <a asp-action="Edit" asp-route-id="@s.Id"
                                   class="admin-icon-action" title="@Loc["Edit"]" aria-label="@Loc["Edit"]">
                                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@s.Id" method="post"
                                      class="d-inline" data-confirm="@Loc["ConfirmDeleteSpec"]"
                                      onsubmit="return confirm(this.dataset.confirm);">
                                    <button type="submit" class="admin-icon-action is-danger"
                                            title="@Loc["Delete"]" aria-label="@Loc["Delete"]">
                                        <i class="bi bi-trash3" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<div class="mt-3">
    <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary btn-sm">@Loc["Back"]</a>
</div>
