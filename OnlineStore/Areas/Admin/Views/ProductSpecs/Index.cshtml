@model IReadOnlyList<ProductSpec>
@{
    var product = (Product)ViewBag.Product;
    ViewData["Title"] = Loc["SpecManagement"].Value;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h5 mb-0">@Loc["SpecManagement"] <span class="text-muted">· @product.Name</span></h1>
    <a asp-action="Create" asp-route-productId="@product.Id" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>@Loc["AddSpec"]</a>
</div>
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:70px">@Loc["DisplayOrder"]</th>
                    <th>@Loc["ParamName"]</th>
                    <th>@Loc["ParamValue"]</th>
                    <th class="text-end">@Loc["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">@Loc["NoSpecs"]</td></tr>
                }
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="text-muted">@s.DisplayOrder</td>
                        <td class="fw-semibold">@s.Name</td>
                        <td>@s.Value</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary" title="@Loc["Edit"]"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline" onsubmit="return confirm('@Loc["ConfirmDeleteSpec"]');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="@Loc["Delete"]"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<div class="mt-3">
    <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary btn-sm">@Loc["Back"]</a>
</div>
