@model ProductSpec
@{
    var product = (Product)ViewBag.Product;
    ViewData["Title"] = Loc["EditSpec"].Value;
}
<h1 class="h5 mb-4">@Loc["EditSpec"] <span class="text-muted">· @product.Name</span></h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card card-body shadow-sm">
    <partial name="_SpecForm" model="Model" />
    <div>
        <button type="submit" class="btn btn-primary">@Loc["Save"]</button>
        <a asp-action="Index" asp-route-productId="@product.Id" class="btn btn-outline-secondary">@Loc["Cancel"]</a>
    </div>
</form>
