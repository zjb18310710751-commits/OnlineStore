@functions {
    string Active(string controller) =>
        ViewContext.RouteData.Values["controller"]?.ToString() == controller ? "active" : "";
}
@{
    var isZh = CultureInfo.CurrentUICulture.Name.StartsWith("zh", StringComparison.OrdinalIgnoreCase);
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is null ? Loc["ManagementConsole"].Value : $"{ViewData["Title"]} - {Loc["ManagementConsole"].Value}")</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="admin-wrapper">
        <aside class="admin-sidebar">
            <div class="admin-brand">
                <i class="bi bi-bag-heart-fill me-1"></i>@Loc["Brand"]
                <span class="d-block small text-secondary-emphasis">@Loc["ManagementConsole"]</span>
            </div>
            <nav class="admin-nav">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="admin-nav-link @Active("Dashboard")"><i class="bi bi-speedometer2 me-2"></i>@Loc["Dashboard"]</a>
                <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="admin-nav-link @Active("Products")"><i class="bi bi-box-seam me-2"></i>@Loc["ProductManagement"]</a>
                <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="admin-nav-link @Active("Categories")"><i class="bi bi-tags me-2"></i>@Loc["CategoryManagement"]</a>
                <a asp-area="Admin" asp-controller="Shops" asp-action="Index" class="admin-nav-link @Active("Shops")"><i class="bi bi-shop me-2"></i>@Loc["ShopManagement"]</a>
                <a asp-area="Admin" asp-controller="Reviews" asp-action="Index" class="admin-nav-link @Active("Reviews")"><i class="bi bi-chat-square-text me-2"></i>@Loc["ReviewManagement"]</a>
                <hr />
                <a asp-area="" asp-controller="Home" asp-action="Index" class="admin-nav-link"><i class="bi bi-shop me-2"></i>@Loc["BackToStore"]</a>
                <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="admin-nav-link w-100 text-start border-0 bg-transparent"><i class="bi bi-box-arrow-right me-2"></i>@Loc["Logout"]</button>
                </form>
                <hr />
                <div class="d-flex gap-1 px-1">
                    <form asp-area="" asp-controller="Language" asp-action="Set" method="post" class="flex-fill">
                        <input type="hidden" name="culture" value="zh-CN" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="btn btn-sm w-100 @(isZh ? "btn-primary" : "btn-outline-secondary")">中文</button>
                    </form>
                    <form asp-area="" asp-controller="Language" asp-action="Set" method="post" class="flex-fill">
                        <input type="hidden" name="culture" value="en" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="btn btn-sm w-100 @(isZh ? "btn-outline-secondary" : "btn-primary")">EN</button>
                    </form>
                </div>
            </nav>
        </aside>
        <main class="admin-main">
            @if (TempData["Success"] is string success)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @success
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @error
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
