@model IReadOnlyList<ProductSku>
@{
    var product = (Product)ViewBag.Product;
    ViewData["Title"] = Loc["SkuManagement"].Value;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h5 mb-0">@Loc["SkuManagement"] <span class="text-muted">· @L10n.Name(product)</span></h1>
    <a asp-action="Create" asp-route-productId="@product.Id" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>@Loc["AddSku"]</a>
</div>
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Loc["Color"]</th>
                    <th>@Loc["Spec"]</th>
                    <th>@Loc["Price"]</th>
                    <th>@Loc["Stock"]</th>
                    <th>@Loc["Status"]</th>
                    <th class="text-end">@Loc["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">@Loc["NoSkus"]</td></tr>
                }
                @foreach (var s in Model)
                {
                    <tr>
                        <td>@L10n.Text(s.Color, s.ColorEn)</td>
                        <td>@L10n.Text(s.Spec, s.SpecEn)</td>
                        <td>¥@s.Price.ToString("F2")</td>
                        <td>@s.Stock</td>
                        <td>
                            <span class="badge @(s.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">@(s.IsActive ? Loc["Active"].Value : Loc["Inactive"].Value)</span>
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary" title="@Loc["Edit"]"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline" data-confirm="@Loc["ConfirmDeleteSku"]" onsubmit="return confirm(this.dataset.confirm);">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="@Loc["Delete"]"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<div class="mt-3">
    <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary btn-sm">@Loc["Back"]</a>
</div>
