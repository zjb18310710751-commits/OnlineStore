@model ProductSku
<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="ProductId" />
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row g-3">
    <div class="col-md-4 mb-3">
        <label asp-for="Color" class="form-label">@Loc["Color"]</label>
        <input asp-for="Color" class="form-control" placeholder="如：军绿" />
        <span asp-validation-for="Color" class="text-danger small"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="Spec" class="form-label">@Loc["Spec"]</label>
        <input asp-for="Spec" class="form-control" placeholder="如：3-4 人" />
        <span asp-validation-for="Spec" class="text-danger small"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="Price" class="form-label">@Loc["Price"]</label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
        <span asp-validation-for="Price" class="text-danger small"></span>
    </div>
</div>
<div class="row g-3">
    <div class="col-md-4 mb-3">
        <label asp-for="Stock" class="form-label">@Loc["Stock"]</label>
        <input asp-for="Stock" class="form-control" type="number" min="0" />
        <span asp-validation-for="Stock" class="text-danger small"></span>
    </div>
    <div class="col-md-8 mb-3">
        <label asp-for="ImageUrl" class="form-label">@Loc["ImageUrl"]</label>
        <input asp-for="ImageUrl" class="form-control" placeholder="可选" />
        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
    </div>
</div>
<div class="form-check mb-3">
    <input asp-for="IsActive" class="form-check-input" />
    <label asp-for="IsActive" class="form-check-label">@Loc["IsActive"]</label>
</div>
