@model IReadOnlyList<Product>
@{
    ViewData["Title"] = Loc["ProductManagement"].Value;
    var categories = (IReadOnlyList<Category>)ViewBag.Categories;
    var page = (int)ViewBag.Page;
    var totalPages = (int)ViewBag.TotalPages;
    var total = (int)ViewBag.Total;
    var search = ViewBag.Search as string;
    var categoryId = (int?)ViewBag.CategoryId;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">@Loc["ProductManagement"] <small class="text-muted fs-6">@Loc["TotalItems", total]</small></h1>
    <a asp-area="Admin" asp-controller="Products" asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>@Loc["AddProduct"]</a>
</div>

<form method="get" asp-area="Admin" asp-controller="Products" asp-action="Index" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="search" class="form-control" placeholder="@Loc["SearchPlaceholderAdmin"]" value="@search" />
    </div>
    <div class="col-auto">
        <select name="categoryId" class="form-select">
            <option value="">@Loc["AllCategories"]</option>
            @foreach (var c in categories)
            {
                <option value="@c.Id" selected="@(categoryId == c.Id)">@L10n.Name(c)</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-primary" type="submit"><i class="bi bi-funnel me-1"></i>@Loc["Filter"]</button>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:60px">@Loc["Image"]</th>
                    <th>@Loc["Name"]</th>
                    <th>@Loc["Shop"]</th>
                    <th>@Loc["Category"]</th>
                    <th>@Loc["Price"]</th>
                    <th>@Loc["Stock"]</th>
                    <th>@Loc["Status"]</th>
                    <th class="text-end">@Loc["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">@Loc["NoProducts"]</td></tr>
                }
                @foreach (var p in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(p.ImageUrl))
                            {
                                <img src="@p.ImageUrl" class="admin-product-img" alt="" />
                            }
                            else
                            {
                                <div class="admin-product-img d-inline-flex align-items-center justify-content-center bg-light"><i class="bi bi-image text-secondary"></i></div>
                            }
                        </td>
                        <td>
                            <div class="fw-semibold">@L10n.Name(p)</div>
                            <small class="text-muted">@p.Sku</small>
                        </td>
                        <td>@L10n.Name(p.Shop)</td>
                        <td>@string.Join(" / ", p.Categories.Select(c => L10n.Name(c)))</td>
                        <td>¥@p.Price.ToString("F2")</td>
                        <td>@p.Stock</td>
                        <td>
                            <span class="badge @(p.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">@(p.IsActive ? Loc["Active"].Value : Loc["Inactive"].Value)</span>
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-area="Admin" asp-controller="Products" asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary" title="@Loc["View"]"><i class="bi bi-eye"></i></a>
                            <a asp-area="Admin" asp-controller="Products" asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary" title="@Loc["Edit"]"><i class="bi bi-pencil"></i></a>
                            <a asp-area="Admin" asp-controller="ProductSkus" asp-action="Index" asp-route-productId="@p.Id" class="btn btn-sm btn-outline-info" title="@Loc["SkuManagement"]"><i class="bi bi-palette"></i></a>
                            <a asp-area="Admin" asp-controller="ProductSpecs" asp-action="Index" asp-route-productId="@p.Id" class="btn btn-sm btn-outline-info" title="@Loc["SpecManagement"]"><i class="bi bi-list-ul"></i></a>
                            <form asp-area="Admin" asp-controller="Products" asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('@Loc["ConfirmDeleteProduct"]');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="@Loc["Delete"]"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-area="Admin" asp-controller="Products" asp-action="Index" asp-route-search="@search" asp-route-categoryId="@categoryId" asp-route-page="@(page - 1)">@Loc["Previous"]</a>
            </li>
            @for (var i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == page ? "active" : "")">
                    <a class="page-link" asp-area="Admin" asp-controller="Products" asp-action="Index" asp-route-search="@search" asp-route-categoryId="@categoryId" asp-route-page="@i">@i</a>
                </li>
            }
            <li class="page-item @(page >= totalPages ? "disabled" : "")">
                <a class="page-link" asp-area="Admin" asp-controller="Products" asp-action="Index" asp-route-search="@search" asp-route-categoryId="@categoryId" asp-route-page="@(page + 1)">@Loc["Next"]</a>
            </li>
        </ul>
    </nav>
}
