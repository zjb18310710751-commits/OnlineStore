@model AdminProductListViewModel
@{
    ViewData["Title"] = Loc["ProductManagement"].Value;
    var categories = Model.Categories;
    var page = Model.Page;
    var totalPages = Model.TotalPages;
    var total = Model.Total;
    var search = Model.Search;
    var categoryId = Model.CategoryId;
    var pagination = new AdminPaginationViewModel
    {
        Action = "Index",
        Controller = "Products",
        Page = page,
        TotalPages = totalPages,
        RouteValues = new()
        {
            ["search"] = search,
            ["categoryId"] = categoryId?.ToString()
        }
    };
}
<div class="admin-store-heading">
    <div>
        <p class="admin-store-eyebrow">@L10n.Text("商品与库存", "Catalog and inventory")</p>
        <h1>@Loc["ProductManagement"] <small>@Loc["TotalItems", total]</small></h1>
        <p class="admin-store-intro">@L10n.Text("管理商品信息、价格、库存和上架状态。", "Manage product details, pricing, inventory and visibility.")</p>
    </div>
    <a asp-area="Admin" asp-controller="Products" asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i>@Loc["AddProduct"]</a>
</div>

<form method="get" asp-area="Admin" asp-controller="Products" asp-action="Index" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="search" class="form-control" placeholder="@Loc["SearchPlaceholderAdmin"]" value="@search" />
    </div>
    <div class="col-auto">
        <select name="categoryId" class="form-select">
            <option value="">@Loc["AllCategories"]</option>
            @foreach (var c in categories)
            {
                <option value="@c.Id" selected="@(categoryId == c.Id)">@L10n.Name(c)</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-primary" type="submit"><i class="bi bi-funnel me-1"></i>@Loc["Filter"]</button>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:60px">@Loc["Image"]</th>
                    <th>@Loc["Name"]</th>
                    <th>@Loc["Shop"]</th>
                    <th>@Loc["Category"]</th>
                    <th>@Loc["Price"]</th>
                    <th>@Loc["Stock"]</th>
                    <th>@Loc["Status"]</th>
                    <th class="text-end">@Loc["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Products.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">@Loc["NoProducts"]</td></tr>
                }
                @foreach (var p in Model.Products)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(p.ImageUrl))
                            {
                                <img src="@p.ImageUrl" class="admin-product-img" alt="" />
                            }
                            else
                            {
                                <div class="admin-product-img d-inline-flex align-items-center justify-content-center bg-light"><i class="bi bi-image text-secondary"></i></div>
                            }
                        </td>
                        <td>
                            <div class="fw-semibold">@L10n.Name(p)</div>
                            <small class="text-muted">@p.Sku</small>
                        </td>
                        <td>@L10n.Name(p.Shop)</td>
                        <td>@string.Join(" / ", p.Categories.Select(L10n.Name))</td>
                        <td>¥@p.Price.ToString("F2")</td>
                        <td>@p.Stock</td>
                        <td>
                            <span class="badge @(p.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">@(p.IsActive ? Loc["Active"].Value : Loc["Inactive"].Value)</span>
                        </td>
                        <td class="text-end text-nowrap">
                            <div class="admin-icon-actions">
                                <a asp-area="Admin" asp-controller="Products" asp-action="Details" asp-route-id="@p.Id"
                                   class="admin-icon-action" title="@Loc["View"]" aria-label="@Loc["View"]">
                                    <i class="bi bi-eye" aria-hidden="true"></i>
                                </a>
                                <a asp-area="Admin" asp-controller="Products" asp-action="Edit" asp-route-id="@p.Id"
                                   class="admin-icon-action" title="@Loc["Edit"]" aria-label="@Loc["Edit"]">
                                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                </a>
                                <a asp-area="Admin" asp-controller="ProductSkus" asp-action="Index" asp-route-productId="@p.Id"
                                   class="admin-icon-action" title="@Loc["SkuManagement"]" aria-label="@Loc["SkuManagement"]">
                                    <i class="bi bi-layers" aria-hidden="true"></i>
                                </a>
                                <a asp-area="Admin" asp-controller="ProductSpecs" asp-action="Index" asp-route-productId="@p.Id"
                                   class="admin-icon-action" title="@Loc["SpecManagement"]" aria-label="@Loc["SpecManagement"]">
                                    <i class="bi bi-sliders" aria-hidden="true"></i>
                                </a>
                                <form asp-area="Admin" asp-controller="Products" asp-action="Delete" asp-route-id="@p.Id"
                                      method="post" class="d-inline" data-confirm="@Loc["ConfirmDeleteProduct"]"
                                      onsubmit="return confirm(this.dataset.confirm);">
                                    <button type="submit" class="admin-icon-action is-danger"
                                            title="@Loc["Delete"]" aria-label="@Loc["Delete"]">
                                        <i class="bi bi-trash3" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_AdminPagination" model="pagination" />
