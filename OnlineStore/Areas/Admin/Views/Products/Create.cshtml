@model ProductFormViewModel
@{
    ViewData["Title"] = Loc["CreateProduct"].Value;
}
<h1 class="h4 mb-4">@Loc["CreateProduct"]</h1>
<form asp-area="Admin" asp-controller="Products" asp-action="Create" method="post" enctype="multipart/form-data" class="card card-body shadow-sm">
    <partial name="_ProductForm" model="Model" />
    <div>
        <button type="submit" class="btn btn-primary">@Loc["Save"]</button>
        <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">@Loc["Cancel"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
