@model ProductFormViewModel
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="mb-3">
    <label asp-for="Name" class="form-label">@Loc["ProductName"]</label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger small"></span>
</div>
<div class="row g-3">
    <div class="col-md-6 mb-3">
        <label asp-for="ShopId" class="form-label">@Loc["Shop"]</label>
        <select asp-for="ShopId" asp-items="Model.Shops" class="form-select">
            <option value="">@Loc["SelectShop"]</option>
        </select>
        <span asp-validation-for="ShopId" class="text-danger small"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="CategoryIds" class="form-label">@Loc["Category"]</label>
        <select asp-for="CategoryIds" asp-items="Model.Categories" class="form-select" multiple size="5"></select>
        <div class="form-text">@Loc["MultiSelectHint"]</div>
        <span asp-validation-for="CategoryIds" class="text-danger small"></span>
    </div>
</div>
<div class="row g-3">
    <div class="col-md-6 mb-3">
        <label asp-for="Price" class="form-label">@Loc["Price"]</label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger small"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Stock" class="form-label">@Loc["Stock"]</label>
        <input asp-for="Stock" class="form-control" />
        <span asp-validation-for="Stock" class="text-danger small"></span>
    </div>
</div>
<div class="mb-3">
    <label asp-for="Sku" class="form-label">@Loc["Sku"]</label>
    <input asp-for="Sku" class="form-control" />
    <span asp-validation-for="Sku" class="text-danger small"></span>
</div>
<div class="mb-3">
    <label asp-for="ImageUrl" class="form-label">@Loc["ImageUrl"]</label>
    <input asp-for="ImageUrl" class="form-control" placeholder="/uploads/… 或 https://…" />
    <span asp-validation-for="ImageUrl" class="text-danger small"></span>
</div>
<div class="mb-3">
    <label asp-for="ImageFile" class="form-label">@Loc["UploadImage"]</label>
    <input asp-for="ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif" />
    <div class="form-text">@Loc["UploadImageHint"]</div>
    <span asp-validation-for="ImageFile" class="text-danger small"></span>
</div>
@if (!string.IsNullOrEmpty(Model.ImageUrl))
{
    <div class="mb-3">
        <img src="@Model.ImageUrl" alt="@Loc["Image"]" class="img-thumbnail" style="max-height: 120px;" />
    </div>
}
<div class="row g-3">
    <div class="col-md-4 mb-3">
        <label asp-for="ShippingFrom" class="form-label">@Loc["ShippingFrom"]</label>
        <input asp-for="ShippingFrom" class="form-control" placeholder="如：广东深圳" />
        <span asp-validation-for="ShippingFrom" class="text-danger small"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="ShippingFee" class="form-label">@Loc["ShippingFee"]</label>
        <input asp-for="ShippingFee" class="form-control" placeholder="如：包邮 / 运费 ¥8" />
        <span asp-validation-for="ShippingFee" class="text-danger small"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="DeliveryTime" class="form-label">@Loc["DeliveryTime"]</label>
        <input asp-for="DeliveryTime" class="form-control" placeholder="如：48小时内发货" />
        <span asp-validation-for="DeliveryTime" class="text-danger small"></span>
    </div>
</div>
<div class="mb-3">
    <label asp-for="Description" class="form-label">@Loc["Description"]</label>
    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
    <span asp-validation-for="Description" class="text-danger small"></span>
</div>
<div class="mb-3">
    <label asp-for="DetailHtml" class="form-label">@Loc["DetailIntro"]</label>
    <div id="detailEditor" class="detail-editor" contenteditable="true"
         data-placeholder="@Loc["DetailIntroPlaceholder"]"
         data-upload-url="@Url.Action("Upload", "Images", new { area = "Admin" })">@Html.Raw(Model.DetailHtml)</div>
    <input type="hidden" asp-for="DetailHtml" id="DetailHtmlInput" />
    <div class="form-text">@Loc["DetailIntroHint"]</div>
    <span asp-validation-for="DetailHtml" class="text-danger small"></span>
</div>
<script>
    (function () {
        var editor = document.getElementById('detailEditor');
        var hidden = document.getElementById('DetailHtmlInput');
        if (!editor || !hidden) return;

        // 提交前把编辑器内容写回隐藏字段
        var form = editor.closest('form');
        if (form) {
            form.addEventListener('submit', function () {
                hidden.value = editor.innerHTML;
            });
        }

        // 粘贴图片：拦截后上传，再插入 <img>
        editor.addEventListener('paste', function (e) {
            var items = (e.clipboardData || window.clipboardData).items;
            if (!items) return;
            for (var i = 0; i < items.length; i++) {
                if (items[i].type.indexOf('image') === 0) {
                    e.preventDefault();
                    uploadImage(items[i].getAsFile());
                    return;
                }
            }
        });

        function uploadImage(file) {
            if (!file) return;
            var fd = new FormData();
            fd.append('file', file);
            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            fetch(editor.getAttribute('data-upload-url'), {
                method: 'POST',
                body: fd,
                headers: { 'RequestVerificationToken': token ? token.value : '' }
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.url) {
                    var img = document.createElement('img');
                    img.src = data.url;
                    img.className = 'img-fluid rounded my-1';
                    editor.appendChild(img);
                    editor.appendChild(document.createElement('br'));
                }
            })
            .catch(function () { /* 上传失败静默处理 */ });
        }
    })();
</script>
<div class="form-check mb-3">
    <input asp-for="IsActive" class="form-check-input" />
    <label asp-for="IsActive" class="form-check-label">@Loc["IsActive"]</label>
</div>
