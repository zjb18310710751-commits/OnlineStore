@using System.Text.Json
@model AdminDashboardData
@{
    ViewData["Title"] = Loc["Dashboard"].Value;
    var revenueDelta = Model.YesterdayRevenue == 0m
        ? 0m
        : (Model.TodayRevenue - Model.YesterdayRevenue) / Model.YesterdayRevenue * 100m;
    var revenueIsUp = revenueDelta >= 0m;
    var statusKeys = new[] { "待发货", "已发货", "已完成", "已取消", "已退款" };
    var statusLabels = statusKeys.Select(L10n.Status).ToList();
    var statusValues = statusKeys
        .Select(key => Model.OrderStatusCounts.GetValueOrDefault(key))
        .ToList();
}

<div class="dashboard-page">
    <div class="dashboard-page-heading">
        <div>
            <h1 class="h3 mb-1">@Loc["Dashboard"]</h1>
            <p class="text-muted small mb-0">@Loc["DashboardRevenueSubtitle"]</p>
        </div>
        <span class="dashboard-live-label"><span></span>@Loc["ComparedToYesterday"]</span>
    </div>

    <div class="row g-3">
        <div class="col-sm-6 col-xl-3">
            <div class="card dashboard-kpi shadow-sm h-100">
                <div class="card-body">
                    <div class="dashboard-kpi-label">@Loc["TodayRevenue"]</div>
                    <div class="dashboard-kpi-value">¥@Model.TodayRevenue.ToString("N2")</div>
                    <div class="dashboard-kpi-delta @(revenueIsUp ? "is-up" : "is-down")">
                        <i class="bi @(revenueIsUp ? "bi-arrow-up-right" : "bi-arrow-down-right")"></i>
                        @revenueDelta.ToString("0.0")% <span>@Loc["ComparedToYesterday"]</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card dashboard-kpi shadow-sm h-100">
                <div class="card-body">
                    <div class="dashboard-kpi-label">@Loc["TodayOrders"]</div>
                    <div class="dashboard-kpi-value">@Model.TodayOrderCount</div>
                    <div class="dashboard-kpi-note"><i class="bi bi-receipt me-1"></i>@Loc["OrderManagement"]</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card dashboard-kpi shadow-sm h-100">
                <div class="card-body">
                    <div class="dashboard-kpi-label">@Loc["AverageOrderValue"]</div>
                    <div class="dashboard-kpi-value">¥@Model.TodayAverageOrderValue.ToString("N2")</div>
                    <div class="dashboard-kpi-note"><i class="bi bi-people me-1"></i>@Loc["Today"]</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card dashboard-kpi shadow-sm h-100">
                <div class="card-body">
                    <div class="dashboard-kpi-label">@Loc["TodayRefund"]</div>
                    <div class="dashboard-kpi-value text-danger">¥@Model.TodayRefundAmount.ToString("N2")</div>
                    <div class="dashboard-kpi-note"><i class="bi bi-arrow-counterclockwise me-1"></i>@Loc["Refund"]</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-lg-8">
            <div class="card dashboard-chart-card shadow-sm h-100">
                <div class="card-header bg-white fw-semibold">@Loc["RevenueTrend"]</div>
                <div class="card-body">
                    <div class="dashboard-chart-box"><canvas id="revenueTrendChart"></canvas></div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card dashboard-chart-card shadow-sm h-100">
                <div class="card-header bg-white fw-semibold">@Loc["OrderStatusDistribution"]</div>
                <div class="card-body">
                    <div class="dashboard-chart-box"><canvas id="orderStatusChart"></canvas></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-lg-7">
            <div class="card dashboard-chart-card shadow-sm h-100">
                <div class="card-header bg-white fw-semibold">@Loc["CategoryRevenue"]</div>
                <div class="card-body">
                    <div class="dashboard-chart-box"><canvas id="categoryRevenueChart"></canvas></div>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-semibold">@Loc["NeedsAttention"]</div>
                <div class="list-group list-group-flush">
                    <a asp-area="Admin" asp-controller="Orders" asp-action="Index"
                       class="list-group-item list-group-item-action dashboard-task">
                        <span class="dashboard-task-icon bg-warning-subtle text-warning"><i class="bi bi-box-seam"></i></span>
                        <span class="dashboard-task-body">
                            <strong>@Model.PendingShipmentCount</strong>
                            <span>@Loc["PendingShipment"]</span>
                        </span>
                        <i class="bi bi-chevron-right"></i>
                    </a>
                    <a asp-area="Admin" asp-controller="Products" asp-action="Index"
                       class="list-group-item list-group-item-action dashboard-task">
                        <span class="dashboard-task-icon bg-danger-subtle text-danger"><i class="bi bi-exclamation-triangle"></i></span>
                        <span class="dashboard-task-body">
                            <strong>@Model.LowStockCount</strong>
                            <span>@Loc["LowStock"]</span>
                        </span>
                        <i class="bi bi-chevron-right"></i>
                    </a>
                    <a asp-area="Admin" asp-controller="Orders" asp-action="Index"
                       class="list-group-item list-group-item-action dashboard-task">
                        <span class="dashboard-task-icon bg-info-subtle text-info"><i class="bi bi-arrow-counterclockwise"></i></span>
                        <span class="dashboard-task-body">
                            <strong>¥@Model.TodayRefundAmount.ToString("N2")</strong>
                            <span>@Loc["TodayRefund"]</span>
                        </span>
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const trendLabels = @Html.Raw(JsonSerializer.Serialize(Model.Trend.Select(p => p.Label)));
            const trendData = @Html.Raw(JsonSerializer.Serialize(Model.Trend.Select(p => p.Revenue)));
            const statusLabels = @Html.Raw(JsonSerializer.Serialize(statusLabels));
            const statusData = @Html.Raw(JsonSerializer.Serialize(statusValues));
            const categoryLabels = @Html.Raw(JsonSerializer.Serialize(Model.CategoryRevenues.Select(p => p.Name)));
            const categoryData = @Html.Raw(JsonSerializer.Serialize(Model.CategoryRevenues.Select(p => p.Revenue)));

            const currency = value => '¥' + Number(value).toFixed(2);

            new Chart(document.getElementById('revenueTrendChart'), {
                type: 'line',
                data: {
                    labels: trendLabels,
                    datasets: [{
                        label: '@Loc["TodayRevenue"]',
                        data: trendData,
                        borderColor: '#ff9900',
                        backgroundColor: 'rgba(255, 153, 0, .12)',
                        fill: true,
                        tension: .35,
                        pointRadius: 0,
                        pointHoverRadius: 4,
                        borderWidth: 2.5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        legend: { display: false },
                        tooltip: { callbacks: { label: ctx => currency(ctx.parsed.y) } }
                    },
                    scales: {
                        x: { grid: { display: false }, ticks: { maxTicksLimit: 10 } },
                        y: { beginAtZero: true, ticks: { callback: v => currency(v) } }
                    }
                }
            });

            new Chart(document.getElementById('orderStatusChart'), {
                type: 'doughnut',
                data: {
                    labels: statusLabels,
                    datasets: [{
                        data: statusData,
                        backgroundColor: ['#f6c343', '#17a2b8', '#28a745', '#9aa4b2', '#dc3545'],
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '68%',
                    plugins: {
                        legend: { position: 'bottom', labels: { usePointStyle: true, padding: 14 } },
                        tooltip: { callbacks: { label: ctx => `${ctx.label}: ${ctx.raw}` } }
                    }
                }
            });

            new Chart(document.getElementById('categoryRevenueChart'), {
                type: 'bar',
                data: {
                    labels: categoryLabels,
                    datasets: [{
                        label: '@Loc["TodayRevenue"]',
                        data: categoryData,
                        backgroundColor: 'rgba(255, 153, 0, .78)',
                        borderColor: '#ff9900',
                        borderRadius: 6,
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    indexAxis: 'y',
                    plugins: {
                        legend: { display: false },
                        tooltip: { callbacks: { label: ctx => currency(ctx.parsed.x) } }
                    },
                    scales: {
                        x: { beginAtZero: true, ticks: { callback: v => currency(v) } },
                        y: { grid: { display: false } }
                    }
                }
            });
        });
    </script>
}
