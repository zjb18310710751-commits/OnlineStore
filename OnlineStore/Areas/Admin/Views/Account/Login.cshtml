@model LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = Loc["AdminLogin"].Value;
    var returnUrl = ViewData["ReturnUrl"] as string;
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Loc["AdminLogin"].Value - @Loc["ManagementConsole"].Value</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex align-items-center min-vh-100 bg-dark">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div class="card shadow-lg border-0">
                    <div class="card-body p-4">
                        <div class="text-center mb-4">
                            <i class="bi bi-shield-lock display-5 text-brand"></i>
                            <h1 class="h4 mt-2 mb-0">@Loc["AdminLogin"]</h1>
                            <div class="text-muted small">@Loc["ManagementConsole"]</div>
                        </div>
                        <form method="post" asp-area="Admin" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label">@Loc["Email"]</label>
                                <input asp-for="Email" class="form-control" autocomplete="username" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Password" class="form-label">@Loc["Password"]</label>
                                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="form-check mb-3">
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label">@Loc["RememberMe"]</label>
                            </div>
                            <div class="form-check mb-3">
                                <input asp-for="RememberCredentials" class="form-check-input" />
                                <label asp-for="RememberCredentials" class="form-check-label">@Loc["RememberCredentials"]</label>
                            </div>
                            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-box-arrow-in-right me-1"></i>@Loc["Login"]</button>
                        </form>
                    </div>
                </div>
                <p class="text-center small mt-3 text-secondary">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="text-secondary"><i class="bi bi-shop me-1"></i>@Loc["BackToStore"]</a>
                </p>
                <p class="text-center text-secondary small mt-2">@Loc["LoginHint"]</p>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
