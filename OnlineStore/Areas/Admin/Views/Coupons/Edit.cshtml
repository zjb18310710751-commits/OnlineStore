@model CouponFormViewModel
@{
    ViewData["Title"] = Loc["EditCoupon"].Value;
}
<h1 class="h4 mb-4">@Loc["EditCoupon"]</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card card-body shadow-sm">
    <input type="hidden" asp-for="Id" />
    <partial name="_CouponForm" model="Model" />
    <div>
        <button type="submit" class="btn btn-primary">@Loc["Save"]</button>
        <a asp-action="Index" class="btn btn-outline-secondary">@Loc["Cancel"]</a>
    </div>
</form>
