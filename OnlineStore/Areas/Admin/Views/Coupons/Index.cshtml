@model PagedResult<Coupon>
@{
    ViewData["Title"] = Loc["CouponManagement"].Value;
    var pagination = new AdminPaginationViewModel { Action = "Index", Controller = "Coupons", Page = Model.Page, TotalPages = Model.TotalPages };
}

<div class="coupon-admin-page">
    <div class="coupon-admin-heading">
        <div>
            <p class="coupon-admin-eyebrow">@L10n.Text("促销与客户", "Promotions and customers")</p>
            <h1>@Loc["CouponManagement"]</h1>
            <p>@L10n.Text("管理活动优惠、适用范围与使用限制。", "Manage campaign offers, eligibility and usage limits.")</p>
        </div>
        <div class="coupon-admin-actions">
            <a asp-action="Export" class="btn btn-outline-secondary"><i class="bi bi-download"></i>@Loc["ExportCoupons"]</a>
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i>@Loc["AddCoupon"]</a>
        </div>
    </div>

    @if (Model.TotalCount == 0)
    {
        <div class="card coupon-admin-empty">
            <i class="bi bi-ticket-perforated"></i>
            <h2>@Loc["NoCoupons"]</h2>
            <p>@L10n.Text("创建第一张优惠券，或复制已有活动作为批次模板。", "Create your first coupon or duplicate an existing campaign as a batch template.")</p>
            <a asp-action="Create" class="btn btn-primary">@Loc["AddCoupon"]</a>
        </div>
    }
    else
    {
        <div class="card coupon-table-card">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>@Loc["CouponName"]</th>
                            <th>@Loc["CouponType"]</th>
                            <th>@L10n.Text("规则", "Rules")</th>
                            <th>@L10n.Text("使用情况", "Usage")</th>
                            <th>@Loc["CouponValidity"]</th>
                            <th>@Loc["Status"]</th>
                            <th class="text-end">@Loc["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var coupon in Model.Items)
                        {
                            var status = !coupon.IsActive
                                ? Loc["Disabled"].Value
                                : DateTime.UtcNow < coupon.StartDate
                                    ? Loc["CouponScheduled"].Value
                                    : DateTime.UtcNow > coupon.EndDate
                                        ? Loc["CouponExpired"].Value
                                        : coupon.UsageLimit.HasValue && coupon.UsedCount >= coupon.UsageLimit.Value
                                            ? Loc["CouponExhausted"].Value
                                            : Loc["Enabled"].Value;
                            var statusClass = status == Loc["Enabled"].Value
                                ? "is-active"
                                : status == Loc["CouponScheduled"].Value
                                    ? "is-scheduled"
                                    : "is-muted";
                            <tr>
                                <td>
                                    <strong class="coupon-name-cell">@CouponDisplayName(coupon)</strong>
                                </td>
                                <td>
                                    <div class="coupon-benefit">
                                        @if (coupon.DiscountType == CouponDiscountType.FreeShipping)
                                        {
                                            <strong>@Loc["FreeShippingDiscount"]</strong>
                                        }
                                        else
                                        {
                                            <strong>@(coupon.DiscountType == CouponDiscountType.Percent ? $"{coupon.DiscountValue:0.##}%" : $"¥{coupon.DiscountValue:F2}")</strong>
                                        }
                                        <span>@(coupon.MinOrderAmount.HasValue ? Loc["CouponMinOrderShort", coupon.MinOrderAmount.Value.ToString("F2")].Value : Loc["Unlimited"].Value)</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="coupon-rule-list">
                                        <span>@CouponScopeLabel(coupon.Scope)</span>
                                        @if (coupon.MaxDiscountAmount.HasValue)
                                        {
                                            <span>@Loc["CouponMaxDiscountShort", coupon.MaxDiscountAmount.Value.ToString("F2")]</span>
                                        }
                                        @if (coupon.FirstOrderOnly)
                                        {
                                            <span>@Loc["FirstOrderOnly"]</span>
                                        }
                                        @if (coupon.ExcludeDiscountedItems)
                                        {
                                            <span>@Loc["ExcludeDiscountedItems"]</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="coupon-usage">
                                        <strong>@coupon.UsedCount@(coupon.UsageLimit.HasValue ? $"/{coupon.UsageLimit.Value}" : string.Empty)</strong>
                                        <span>@(coupon.PerUserLimit.HasValue ? Loc["PerUserUsageShort", coupon.PerUserLimit.Value].Value : Loc["Unlimited"].Value)</span>
                                    </div>
                                </td>
                                <td class="coupon-validity">
                                    <span>@coupon.StartDate.ToString("yyyy-MM-dd")</span>
                                    <i class="bi bi-arrow-right"></i>
                                    <span>@coupon.EndDate.ToString("yyyy-MM-dd")</span>
                                </td>
                                <td><span class="coupon-admin-status @statusClass"><i></i>@status</span></td>
                                <td class="text-end text-nowrap">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" title="@Loc["BatchGenerate"]"
                                            data-bs-toggle="modal" data-bs-target="#couponBatchModal"
                                            data-coupon-batch="@coupon.Id" data-coupon-name="@CouponDisplayName(coupon)">
                                        <i class="bi bi-collection"></i>
                                    </button>
                                    <a asp-action="Edit" asp-route-id="@coupon.Id" class="btn btn-sm btn-outline-primary" title="@Loc["Edit"]"><i class="bi bi-pencil"></i></a>
                                    <form asp-action="Delete" asp-route-id="@coupon.Id" method="post" class="d-inline" data-confirm="@Loc["ConfirmDeleteCoupon"]" onsubmit="return confirm(this.dataset.confirm);">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="@Loc["Delete"]"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    <partial name="_AdminPagination" model="pagination" />
</div>

<div class="modal fade coupon-batch-modal" id="couponBatchModal" tabindex="-1" aria-labelledby="couponBatchTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="GenerateBatch" method="post" class="modal-content">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title h5" id="couponBatchTitle">@Loc["BatchGenerate"]</h2>
                    <p class="text-muted small mb-0" id="couponBatchSubtitle"></p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Loc["Cancel"]"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="CouponId" id="couponBatchId" />
                <div class="mb-3">
                    <label for="couponBatchQuantity" class="form-label">@Loc["BatchQuantity"]</label>
                    <input type="number" class="form-control" id="couponBatchQuantity" name="Quantity" value="5" min="1" max="50" required />
                    <div class="form-text">@Loc["BatchGenerateHint"]</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                <button type="submit" class="btn btn-primary">@Loc["BatchGenerateAction"]</button>
            </div>
        </form>
    </div>
</div>

@functions {
    private string CouponScopeLabel(CouponScope scope) => scope switch
    {
        CouponScope.Categories => Loc["ScopeCategories"].Value,
        CouponScope.Products => Loc["ScopeProducts"].Value,
        _ => Loc["ScopeAllProducts"].Value
    };

    private string CouponDisplayName(Coupon coupon) =>
        string.IsNullOrWhiteSpace(coupon.CampaignName) ? Loc["Coupon"].Value : coupon.CampaignName;
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var batchModal = document.getElementById('couponBatchModal');
            if (!batchModal) return;
            batchModal.addEventListener('show.bs.modal', function (event) {
                var trigger = event.relatedTarget;
                if (!trigger) return;
                var name = trigger.getAttribute('data-coupon-name') || '';
                document.getElementById('couponBatchId').value = trigger.getAttribute('data-coupon-batch') || '';
                document.getElementById('couponBatchSubtitle').textContent = name;
            });
        });
    </script>
}
