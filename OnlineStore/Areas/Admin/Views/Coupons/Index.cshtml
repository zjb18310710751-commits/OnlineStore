@model IReadOnlyList<Coupon>
@{
    ViewData["Title"] = Loc["CouponManagement"].Value;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">@Loc["CouponManagement"]</h1>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>@Loc["AddCoupon"]</a>
</div>
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Loc["CouponCode"]</th>
                    <th>@Loc["CouponType"]</th>
                    <th>@Loc["CouponValue"]</th>
                    <th>@Loc["MinOrderAmount"]</th>
                    <th>@Loc["CouponValidity"]</th>
                    <th>@Loc["UsedCount"]</th>
                    <th>@Loc["Status"]</th>
                    <th class="text-end">@Loc["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">@Loc["NoCoupons"]</td></tr>
                }
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="fw-semibold">@c.Code</td>
                        <td>@(c.DiscountType == CouponDiscountType.Percent ? Loc["PercentDiscount"].Value : Loc["FixedDiscount"].Value)</td>
                        <td>@(c.DiscountType == CouponDiscountType.Percent ? $"{c.DiscountValue:0.##}%" : $"¥{c.DiscountValue:F2}")</td>
                        <td>@(c.MinOrderAmount.HasValue ? $"¥{c.MinOrderAmount.Value:F2}" : Loc["Unlimited"].Value)</td>
                        <td class="text-muted small">@c.StartDate.ToLocalTime().ToString("yyyy-MM-dd") ~ @c.EndDate.ToLocalTime().ToString("yyyy-MM-dd")</td>
                        <td>@(c.UsageLimit.HasValue ? $"{c.UsedCount}/{c.UsageLimit.Value}" : c.UsedCount.ToString())</td>
                        <td><span class="badge @(c.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">@(c.IsActive ? Loc["Enabled"].Value : Loc["Disabled"].Value)</span></td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary" title="@Loc["Edit"]"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" data-confirm="@Loc["ConfirmDeleteCoupon"]" onsubmit="return confirm(this.dataset.confirm);">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="@Loc["Delete"]"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
