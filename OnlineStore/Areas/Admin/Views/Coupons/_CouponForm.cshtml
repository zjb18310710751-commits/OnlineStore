@model CouponFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<section class="coupon-form-section" aria-labelledby="couponBasicsTitle">
    <div class="coupon-form-heading">
        <div>
            <span class="coupon-form-eyebrow">01</span>
            <h2 id="couponBasicsTitle">@L10n.Text("基本信息", "Basics")</h2>
        </div>
        <p>@L10n.Text("用于识别活动和管理后台列表。", "Used to identify the campaign in the admin list.")</p>
    </div>
    @if (Model.Id > 0)
    {
        <div class="coupon-generated-code mb-3">
            <span>@Loc["CouponCode"]</span>
            <strong>@Model.Code</strong>
            <small>@Loc["CouponCodeReadonlyHint"]</small>
        </div>
    }
    else
    {
        <div class="coupon-generated-code mb-3">
            <span>@Loc["CouponCode"]</span>
            <strong>@Loc["AutoGeneratedCouponCode"]</strong>
            <small>@Loc["AutoGeneratedCouponCodeHint"]</small>
        </div>
    }
    <div class="row g-3">
        <div class="col-12">
            <label asp-for="CampaignName" class="form-label">@Loc["CouponCampaign"] <span class="text-muted fw-normal">@L10n.Text("选填", "Optional")</span></label>
            <input asp-for="CampaignName" class="form-control" placeholder="@Loc["CouponCampaignPlaceholder"]" />
            <span asp-validation-for="CampaignName" class="text-danger small"></span>
        </div>
    </div>
</section>

<section class="coupon-form-section" aria-labelledby="couponBenefitTitle">
    <div class="coupon-form-heading">
        <div>
            <span class="coupon-form-eyebrow">02</span>
            <h2 id="couponBenefitTitle">@L10n.Text("优惠规则", "Benefit rules")</h2>
        </div>
        <p>@L10n.Text("百分比券最高只能设置为 100%。", "Percentage coupons are limited to 100%.")</p>
    </div>
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="DiscountType" class="form-label">@Loc["CouponType"]</label>
            <select asp-for="DiscountType" class="form-select" id="couponDiscountType">
                <option value="0">@Loc["PercentDiscount"]</option>
                <option value="1">@Loc["FixedDiscount"]</option>
                <option value="2">@Loc["FreeShippingDiscount"]</option>
            </select>
        </div>
        <div class="col-md-4 coupon-value-field">
            <label asp-for="DiscountValue" class="form-label">@Loc["CouponValue"]</label>
            <input asp-for="DiscountValue" class="form-control" type="number" step="0.01" min="0" />
            <span asp-validation-for="DiscountValue" class="text-danger small"></span>
        </div>
        <div class="col-md-4 coupon-value-field">
            <label asp-for="MaxDiscountAmount" class="form-label">@Loc["MaxDiscountAmount"]</label>
            <input asp-for="MaxDiscountAmount" class="form-control" type="number" step="0.01" min="0" placeholder="@Loc["Unlimited"]" />
            <div class="form-text">@Loc["MaxDiscountAmountHint"]</div>
            <span asp-validation-for="MaxDiscountAmount" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="MinOrderAmount" class="form-label">@Loc["MinOrderAmount"]</label>
            <input asp-for="MinOrderAmount" class="form-control" type="number" step="0.01" min="0" placeholder="@Loc["Unlimited"]" />
            <span asp-validation-for="MinOrderAmount" class="text-danger small"></span>
        </div>
    </div>
</section>

<section class="coupon-form-section" aria-labelledby="couponScopeTitle">
    <div class="coupon-form-heading">
        <div>
            <span class="coupon-form-eyebrow">03</span>
            <h2 id="couponScopeTitle">@L10n.Text("适用范围", "Eligibility")</h2>
        </div>
        <p>@L10n.Text("优惠按符合条件的商品小计计算。", "Discounts use the eligible item subtotal.")</p>
    </div>
    <div class="row g-3">
        <div class="col-md-5">
            <label asp-for="Scope" class="form-label">@Loc["CouponScope"]</label>
            <select asp-for="Scope" class="form-select" id="couponScope">
                <option value="0">@Loc["ScopeAllProducts"]</option>
                <option value="1">@Loc["ScopeCategories"]</option>
                <option value="2">@Loc["ScopeProducts"]</option>
            </select>
        </div>
        <div class="col-md-7">
            <label class="coupon-check-card">
                <input asp-for="ExcludeDiscountedItems" class="form-check-input" />
                <span>
                    <strong>@Loc["ExcludeDiscountedItems"]</strong>
                    <small>@L10n.Text("已有划线价或限时折扣的商品不参与本券计算。", "Items already on sale are excluded.")</small>
                </span>
            </label>
        </div>
        <div class="col-12 coupon-scope-panel" data-scope="1">
            <label asp-for="CategoryIds" class="form-label">@L10n.Text("选择分类", "Choose categories")</label>
            <select asp-for="CategoryIds" asp-items="Model.CategoryOptions" class="form-select" multiple size="6"></select>
            <div class="form-text">@L10n.Text("按住 Ctrl 或 Command 可多选。", "Hold Ctrl or Command to select more than one.")</div>
            <span asp-validation-for="CategoryIds" class="text-danger small"></span>
        </div>
        <div class="col-12 coupon-scope-panel" data-scope="2">
            <label asp-for="ProductIds" class="form-label">@L10n.Text("选择商品", "Choose products")</label>
            <input type="search" class="form-control mb-2" id="couponProductFilter" placeholder="@L10n.Text("搜索商品名称或 SKU", "Search product name or SKU")" />
            <select asp-for="ProductIds" asp-items="Model.ProductOptions" class="form-select" multiple size="10" id="couponProductSelect"></select>
            <div class="form-text">@L10n.Text("按住 Ctrl 或 Command 可多选。", "Hold Ctrl or Command to select more than one.")</div>
            <span asp-validation-for="ProductIds" class="text-danger small"></span>
        </div>
    </div>
</section>

<section class="coupon-form-section" aria-labelledby="couponLimitsTitle">
    <div class="coupon-form-heading">
        <div>
            <span class="coupon-form-eyebrow">04</span>
            <h2 id="couponLimitsTitle">@L10n.Text("时间与使用限制", "Schedule and limits")</h2>
        </div>
        <p>@L10n.Text("结束日期当天仍可使用。", "The coupon remains valid through the end date.")</p>
    </div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="StartDate" class="form-label">@Loc["StartDate"]</label>
            <input asp-for="StartDate" class="form-control" type="date" />
            <span asp-validation-for="StartDate" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="EndDate" class="form-label">@Loc["EndDate"]</label>
            <input asp-for="EndDate" class="form-control" type="date" />
            <span asp-validation-for="EndDate" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="UsageLimit" class="form-label">@Loc["UsageLimit"]</label>
            <input asp-for="UsageLimit" class="form-control" type="number" min="1" placeholder="@Loc["Unlimited"]" />
            <span asp-validation-for="UsageLimit" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="PerUserLimit" class="form-label">@Loc["PerUserLimit"]</label>
            <input asp-for="PerUserLimit" class="form-control" type="number" min="1" placeholder="@Loc["Unlimited"]" />
            <span asp-validation-for="PerUserLimit" class="text-danger small"></span>
        </div>
        <div class="col-md-4 d-flex align-items-center">
            <label class="coupon-check-card w-100">
                <input asp-for="FirstOrderOnly" class="form-check-input" />
                <span>
                    <strong>@Loc["FirstOrderOnly"]</strong>
                    <small>@L10n.Text("只允许完成过 0 笔订单的账户使用。", "Available only to accounts with no previous orders.")</small>
                </span>
            </label>
        </div>
        <div class="col-12">
            <label class="coupon-check-card">
                <input asp-for="IsActive" class="form-check-input" />
                <span>
                    <strong>@Loc["Enabled"]</strong>
                    <small>@L10n.Text("停用后不会出现在结算页的可用优惠券中。", "Disabled coupons never appear at checkout.")</small>
                </span>
            </label>
        </div>
    </div>
</section>

<script>
    (function () {
        var type = document.getElementById('couponDiscountType');
        var scope = document.getElementById('couponScope');
        var panels = document.querySelectorAll('.coupon-scope-panel');
        var valueFields = document.querySelectorAll('.coupon-value-field');
        var productFilter = document.getElementById('couponProductFilter');
        var productSelect = document.getElementById('couponProductSelect');

        function syncType() {
            var freeShipping = type && type.value === '2';
            valueFields.forEach(function (field) { field.hidden = freeShipping; });
        }

        function syncScope() {
            var current = scope ? scope.value : '0';
            panels.forEach(function (panel) {
                panel.hidden = panel.getAttribute('data-scope') !== current;
            });
        }

        type?.addEventListener('change', syncType);
        scope?.addEventListener('change', syncScope);
        syncType();
        syncScope();

        productFilter?.addEventListener('input', function () {
            if (!productSelect) return;
            var query = productFilter.value.trim().toLowerCase();
            Array.from(productSelect.options).forEach(function (option) {
                option.hidden = query.length > 0 && option.text.toLowerCase().indexOf(query) === -1;
            });
        });
    })();
</script>
