@model Coupon
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="mb-3">
    <label asp-for="Code" class="form-label">@Loc["CouponCode"]</label>
    <input asp-for="Code" class="form-control" placeholder="如：SAVE20" />
    <span asp-validation-for="Code" class="text-danger small"></span>
</div>
<div class="row g-3">
    <div class="col-md-4 mb-3">
        <label asp-for="DiscountType" class="form-label">@Loc["CouponType"]</label>
        <select asp-for="DiscountType" class="form-select">
            <option value="0">@Loc["PercentDiscount"]</option>
            <option value="1">@Loc["FixedDiscount"]</option>
        </select>
        <span asp-validation-for="DiscountType" class="text-danger small"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="DiscountValue" class="form-label">@Loc["CouponValue"]</label>
        <input asp-for="DiscountValue" class="form-control" type="number" step="0.01" min="0" />
        <span asp-validation-for="DiscountValue" class="text-danger small"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="MinOrderAmount" class="form-label">@Loc["MinOrderAmount"]</label>
        <input asp-for="MinOrderAmount" class="form-control" type="number" step="0.01" min="0" placeholder="@Loc["Unlimited"]" />
        <span asp-validation-for="MinOrderAmount" class="text-danger small"></span>
    </div>
</div>
<div class="row g-3">
    <div class="col-md-6 mb-3">
        <label asp-for="StartDate" class="form-label">@Loc["StartDate"]</label>
        <input asp-for="StartDate" class="form-control" type="date" />
        <span asp-validation-for="StartDate" class="text-danger small"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="EndDate" class="form-label">@Loc["EndDate"]</label>
        <input asp-for="EndDate" class="form-control" type="date" />
        <span asp-validation-for="EndDate" class="text-danger small"></span>
    </div>
</div>
<div class="row g-3">
    <div class="col-md-6 mb-3">
        <label asp-for="UsageLimit" class="form-label">@Loc["UsageLimit"]</label>
        <input asp-for="UsageLimit" class="form-control" type="number" min="1" placeholder="@Loc["Unlimited"]" />
        <span asp-validation-for="UsageLimit" class="text-danger small"></span>
    </div>
    <div class="col-md-6 mb-3 d-flex align-items-end">
        <div class="form-check">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">@Loc["Enabled"]</label>
        </div>
    </div>
</div>
