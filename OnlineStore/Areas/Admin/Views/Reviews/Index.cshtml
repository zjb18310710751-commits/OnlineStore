@model PagedResult<Review>
@{
    ViewData["Title"] = Loc["ReviewManagement"].Value;
    var pagination = new AdminPaginationViewModel { Action = "Index", Controller = "Reviews", Page = Model.Page, TotalPages = Model.TotalPages };
}
<div class="admin-store-heading">
    <div>
        <p class="admin-store-eyebrow">@L10n.Text("买家反馈", "Customer voice")</p>
        <h1>@Loc["ReviewManagement"] <small>@Loc["TotalItems", Model.TotalCount]</small></h1>
        <p class="admin-store-intro">@L10n.Text("查看并审核商品评价，维护商店内容质量。", "Review product feedback and keep storefront content accurate.")</p>
    </div>
</div>
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Loc["Name"]</th>
                    <th>@Loc["UserName"]</th>
                    <th>@Loc["Rating"]</th>
                    <th>@Loc["ReviewComment"]</th>
                    <th>@Loc["CreatedAt"]</th>
                    <th class="text-end">@Loc["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.TotalCount == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">@Loc["NoReviews"]</td></tr>
                }
                @foreach (var r in Model.Items)
                {
                    var comment = L10n.Text(r.Comment ?? "", r.CommentEn);
                    <tr>
                        <td class="fw-semibold">@L10n.Name(r.Product)</td>
                        <td>@L10n.Text(r.UserName, r.UserNameEn)</td>
                        <td><span class="text-warning">@(new string('★', r.Rating))</span></td>
                        <td class="text-muted">@(comment.Length > 30 ? comment[..30] + "…" : comment)</td>
                        <td class="text-muted small">@r.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end">
                            <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline" data-confirm="@Loc["ConfirmDeleteReview"]" onsubmit="return confirm(this.dataset.confirm);">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="@Loc["Delete"]"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_AdminPagination" model="pagination" />
