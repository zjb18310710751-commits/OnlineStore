@model AdminOrdersViewModel
@{
    ViewData["Title"] = Loc["OrderManagement"].Value;
    var openAfterSales = Model.OpenAfterSalesCount;
    var ordersPagination = new AdminPaginationViewModel
    {
        Action = "Index",
        Controller = "Orders",
        Page = Model.OrdersPage,
        TotalPages = Model.OrdersTotalPages,
        RouteValues = new() { ["section"] = "orders" }
    };
    var afterSalesPagination = new AdminPaginationViewModel
    {
        Action = "Index",
        Controller = "Orders",
        Page = Model.AfterSalesPage,
        TotalPages = Model.AfterSalesTotalPages,
        RouteValues = new() { ["section"] = "after-sales" }
    };
}
@functions {
    string StatusBadge(string status) => status switch
    {
        _ => "bg-white text-dark border"
    };
}
<div class="admin-store-heading">
    <div>
        <p class="admin-store-eyebrow">@L10n.Text("履约与售后", "Fulfillment and after-sales")</p>
        <h1>@Loc["OrderManagement"]</h1>
        <p class="admin-store-intro">@L10n.Text("安排发货、查看物流进度并处理买家的售后申请。", "Dispatch orders, review delivery progress and handle buyer after-sales requests.")</p>
    </div>
</div>
<nav class="admin-order-section-nav" aria-label="@L10n.Text("订单管理分区", "Order management sections")">
    <a asp-action="Index" asp-route-section="orders" class="@(Model.ActiveSection == "orders" ? "is-active" : "")">
        @L10n.Text("订单管理", "Orders") <span>@Model.TotalOrderCount</span>
    </a>
    <a asp-action="Index" asp-route-section="after-sales" class="@(Model.ActiveSection == "after-sales" ? "is-active" : "")">
        @L10n.Text("售后申请", "After-sales")
        @if (openAfterSales > 0)
        {
            <span>@openAfterSales</span>
        }
    </a>
</nav>

@if (Model.ActiveSection == "orders")
{
<div class="card shadow-sm mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" data-admin-order-updates
               data-admin-order-total="@Model.TotalOrderCount"
               data-order-updates-url="@(Url.Action("OrderUpdates") + "?" + string.Join("&", Model.Orders.Select(order => $"ids={order.Id}")))">
            <thead class="table-light">
                <tr>
                    <th>@Loc["OrderNo"]</th>
                    <th>@L10n.Text("商品与规格", "Items and variants")</th>
                    <th>@Loc["Receiver"]</th>
                    <th class="text-end">@Loc["Total"]</th>
                    <th>@Loc["OrderStatus"]</th>
                    <th>@L10n.Text("物流", "Logistics")</th>
                    <th class="text-end">@Loc["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Orders.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">@Loc["NoOrders"]</td></tr>
                }
                @foreach (var o in Model.Orders)
                {
                    var state = AdminOrderUpdateViewModel.FromOrder(o);
                    <tr data-order-id="@o.Id"
                        data-order-status="@o.Status"
                        data-admin-order-state-key="@CustomerOrderUpdateViewModel.CreateStateKey(o)">
                        <td class="fw-semibold">
                            @o.OrderNo
                            @if (o.ReplacementForOrderId.HasValue)
                            {
                                <span class="badge bg-white text-dark border ms-1">@L10n.Text("换货补发", "Exchange replacement")</span>
                            }
                        </td>
                        <td>
                            <ul class="admin-order-product-list">
                                @foreach (var item in o.Items)
                                {
                                    <li class="admin-order-product">
                                        <span class="admin-order-product-media">
                                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl" alt="" loading="lazy" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-image" aria-hidden="true"></i>
                                            }
                                        </span>
                                        <span class="admin-order-product-copy">
                                            <a asp-area="Admin" asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId" class="admin-order-product-name">
                                                @L10n.Text(item.ProductName, item.ProductNameEn)
                                            </a>
                                            <span class="admin-order-product-meta">
                                                @if (!string.IsNullOrWhiteSpace(item.Color))
                                                {
                                                    <span>@L10n.Text("颜色", "Color")：@L10n.Text(item.Color, item.ColorEn)</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.Spec))
                                                {
                                                    <span>@L10n.Text("规格", "Variant")：@L10n.Text(item.Spec, item.SpecEn)</span>
                                                }
                                                <span>× @item.Quantity</span>
                                            </span>
                                        </span>
                                        <span class="admin-order-product-price">¥@item.LineTotal.ToString("F2")</span>
                                    </li>
                                }
                            </ul>
                        </td>
                        <td class="small">
                            @o.UserName<br />
                            <span class="text-muted">@o.Phone</span><br />
                            <span>@Loc["Payment"]：@L10n.PaymentMethod(o.PaymentMethod)</span>
                            @if (!string.IsNullOrWhiteSpace(o.OrderNotes))
                            {
                                <div class="text-muted mt-1">@L10n.Text("备注", "Notes")：@o.OrderNotes</div>
                            }
                        </td>
                        <td class="text-end">
                            @if (o.DiscountAmount > 0)
                            {
                                <span class="text-muted small text-decoration-line-through">¥@((o.Total + o.DiscountAmount).ToString("F2"))</span>
                            }
                            <span class="text-danger fw-semibold ms-1">¥@o.Total.ToString("F2")</span>
                        </td>
                        <td><span class="badge @StatusBadge(o.Status)" data-order-status-label aria-live="polite">@state.StatusLabel</span></td>
                        <td class="small text-muted">
                            @if (!string.IsNullOrWhiteSpace(o.Carrier))
                            {
                                <div>@L10n.Carrier(o.Carrier)</div>
                                <div class="font-monospace">@o.TrackingNumber</div>
                            }
                            else if (o.Status == OrderStatus.PendingShipment && o.ExpectedDispatchAt.HasValue)
                            {
                                <div>@L10n.Text("预计发货", "Dispatch by") @o.ExpectedDispatchAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                                @if (o.ExpectedDispatchAt.Value <= DateTime.UtcNow)
                                {
                                    <span class="badge bg-white text-dark border mt-1">@L10n.Text("已超时", "Overdue")</span>
                                }
                            }
                            else
                            {
                                <span>—</span>
                            }
                            <div class="mt-2 @(state.IsReceiptException ? "text-danger" : null)" data-order-note
                                 hidden="@(state.ReceiptNote is null)">@state.ReceiptNote</div>
                        </td>
                        <td class="text-end text-nowrap">
                            <span data-order-actions-status="@OrderStatus.PendingShipment" hidden="@(o.Status != OrderStatus.PendingShipment)">
                                <button type="button" class="btn btn-sm btn-outline-dark" onclick="openDispatchModal(@o.Id, '@o.OrderNo')">@Loc["Ship"]</button>
                            </span>
                            <span data-order-actions-status="@(OrderStatus.Shipped + "," + OrderStatus.Delivered + "," + OrderStatus.ReceiptException)"
                                  hidden="@(o.Status != OrderStatus.Shipped && o.Status != OrderStatus.Delivered && o.Status != OrderStatus.ReceiptException)">
                                <button type="button" class="btn btn-sm btn-outline-dark" onclick="openAdminTrackingModal(@o.Id)">@L10n.Text("查看物流", "Track")</button>
                            </span>
                            <span data-order-actions-status="@OrderStatus.Delivered" hidden="@(o.Status != OrderStatus.Delivered)">
                                <button type="button" class="btn btn-sm btn-outline-dark"
                                        onclick="openReceiptExceptionModal(@o.Id, '@o.OrderNo')">
                                    @L10n.Text("签收异常", "Receipt exception")
                                </button>
                            </span>
                            <span data-order-actions-status="@OrderStatus.ReceiptException" hidden="@(o.Status != OrderStatus.ReceiptException)">
                                <form asp-action="Refund" asp-route-id="@o.Id" method="post" class="d-inline" data-confirm="@L10n.Text("确定为该异常签收订单退款并恢复库存吗？", "Refund this receipt-exception order and restore stock?")" onsubmit="return confirm(this.dataset.confirm);">
                                    <button type="submit" class="btn btn-sm btn-outline-dark">@Loc["Refund"]</button>
                                </form>
                            </span>
                            <span data-order-actions-status="@OrderStatus.Completed" hidden="@(o.Status != OrderStatus.Completed)">
                                <form asp-action="Refund" asp-route-id="@o.Id" method="post" class="d-inline" data-confirm="@Loc["ConfirmRefundOrder"]" onsubmit="return confirm(this.dataset.confirm);">
                                    <button type="submit" class="btn btn-sm btn-outline-dark">@Loc["Refund"]</button>
                                </form>
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_AdminPagination" model="ordersPagination" />
}
else
{
<h2 class="h5 mb-3">@L10n.Text("售后申请", "After-sales requests")</h2>
<div class="card shadow-sm"
     data-admin-after-sales-updates
     data-after-sales-total="@Model.TotalAfterSalesCount"
     data-after-sales-open="@Model.OpenAfterSalesCount"
     data-after-sales-updates-url="@(Url.Action("AfterSalesUpdates") + "?" + string.Join("&", Model.AfterSales.Select(request => $"ids={request.Id}")))">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Loc["OrderNo"]</th>
                    <th>@L10n.Text("类型", "Type")</th>
                    <th>@L10n.Text("原因", "Reason")</th>
                    <th>@L10n.Text("退货物流", "Return logistics")</th>
                    <th>@L10n.Text("状态", "Status")</th>
                    <th class="text-end">@Loc["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.AfterSales.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">@L10n.Text("暂无售后申请", "No after-sales requests")</td></tr>
                }
                @foreach (var a in Model.AfterSales)
                {
                    var isReturnFlow = a.Type is AfterSalesType.Return or AfterSalesType.Exchange;
                    var hasReturnTracking = isReturnFlow
                        && !string.IsNullOrWhiteSpace(a.ReturnCarrier)
                        && !string.IsNullOrWhiteSpace(a.ReturnTrackingNumber);
                    <tr data-after-sales-id="@a.Id"
                        data-after-sales-state-key="@AfterSalesUpdateViewModel.FromRequest(a).StateKey">
                        <td class="fw-semibold">@a.Order?.OrderNo</td>
                        <td>@L10n.AfterSalesTypeLabel(a.Type)</td>
                        <td class="small" style="max-width:320px;">
                            <div>@a.Reason</div>
                            @if (!string.IsNullOrWhiteSpace(a.AdminNote))
                            {
                                <div class="text-muted mt-1">@L10n.Text("处理备注", "Admin note")：@a.AdminNote</div>
                            }
                        </td>
                        <td class="small">
                            @if (hasReturnTracking)
                            {
                                <div>@L10n.Carrier(a.ReturnCarrier)</div>
                                <div class="font-monospace">@a.ReturnTrackingNumber</div>
                            }
                            else if (isReturnFlow && a.Status == AfterSalesStatus.Approved)
                            {
                                <span class="text-muted">@L10n.Text("等待买家寄回", "Awaiting buyer return")</span>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td><span class="badge bg-white text-dark border">@L10n.AfterSalesStatusLabel(a.Status)</span></td>
                        <td class="text-end text-nowrap">
                            @if (a.Status == AfterSalesStatus.Pending
                                && a.Type == AfterSalesType.TransitCancellation)
                            {
                                <form asp-action="ResolveTransitCancellation" asp-route-id="@a.Id" method="post" class="d-inline-flex gap-2 align-items-center">
                                    <input name="note" class="form-control form-control-sm" maxlength="500"
                                           placeholder="@L10n.Text("处理备注（可选）", "Resolution note (optional)")" style="width:180px;" />
                                    <button type="submit" name="intercepted" value="true" class="btn btn-sm btn-outline-dark">
                                        @L10n.Text("拦截成功并退款", "Intercepted & refund")
                                    </button>
                                    <button type="submit" name="intercepted" value="false" class="btn btn-sm btn-outline-dark">
                                        @L10n.Text("拦截失败", "Interception failed")
                                    </button>
                                </form>
                            }
                            else if (a.Status == AfterSalesStatus.Pending)
                            {
                                <form asp-action="ReviewAfterSales" asp-route-id="@a.Id" method="post" class="d-inline-flex gap-2">
                                    <input type="hidden" name="approved" value="true" />
                                    <input type="hidden" name="note" value="" />
                                    <button type="submit" class="btn btn-sm btn-outline-dark">@L10n.Text("同意", "Approve")</button>
                                </form>
                                <form asp-action="ReviewAfterSales" asp-route-id="@a.Id" method="post" class="d-inline">
                                    <input type="hidden" name="approved" value="false" />
                                    <input type="hidden" name="note" value="" />
                                    <button type="submit" class="btn btn-sm btn-outline-dark">@L10n.Text("拒绝", "Reject")</button>
                                </form>
                            }
                            else if (a.Status == AfterSalesStatus.Approved
                                && isReturnFlow)
                            {
                                <span class="text-muted small">@L10n.Text("等待买家提交退货物流", "Waiting for return tracking")</span>
                            }
                            else if (a.Status == AfterSalesStatus.Returning)
                            {
                                <button type="button" class="btn btn-sm btn-outline-dark"
                                        onclick="openAdminReturnTrackingModal(@a.Id)">
                                    @L10n.Text("查看退货物流", "Track return")
                                </button>
                                <form asp-action="MarkAfterSalesReceived" asp-route-id="@a.Id" method="post" class="d-inline"
                                      data-confirm="@L10n.Text("确认退回商品已经到达并完成验收吗？", "Confirm the returned item has arrived and passed inspection?")">
                                    <button type="submit" class="btn btn-sm btn-outline-dark">
                                        @L10n.Text("标记已收货", "Mark received")
                                    </button>
                                </form>
                            }
                            else if (a.Status == AfterSalesStatus.Received)
                            {
                                @if (hasReturnTracking)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-dark me-2"
                                            onclick="openAdminReturnTrackingModal(@a.Id)">
                                        @L10n.Text("查看退货物流", "Track return")
                                    </button>
                                }
                                <form asp-action="CompleteAfterSales" asp-route-id="@a.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-dark">@L10n.Text("完成售后", "Complete")</button>
                                </form>
                            }
                            else if (a.Status == AfterSalesStatus.Completed && hasReturnTracking)
                            {
                                <button type="button" class="btn btn-sm btn-outline-dark"
                                        onclick="openAdminReturnTrackingModal(@a.Id)">
                                    @L10n.Text("查看退货物流", "Track return")
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_AdminPagination" model="afterSalesPagination" />
}

<div class="modal fade" id="dispatchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="Ship" method="post" class="modal-content">
            <input type="hidden" name="id" id="dispatchOrderId" />
            <div class="modal-header">
                <h2 class="modal-title fs-5 fw-bold">@L10n.Text("订单发货", "Dispatch order")</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Loc["Cancel"]"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">@L10n.Text("承运商", "Carrier")</label>
                    <select name="carrier" class="form-select" required>
                        <option value="">@L10n.Text("请选择承运商", "Select carrier")</option>
                        <option value="顺丰速运">@L10n.Text("顺丰速运", "SF Express")</option>
                        <option value="中通快递">@L10n.Text("中通快递", "ZTO Express")</option>
                        <option value="圆通速递">@L10n.Text("圆通速递", "YTO Express")</option>
                        <option value="邮政 EMS">@L10n.Text("邮政 EMS", "EMS")</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">@L10n.Text("运单号", "Tracking number")</label>
                    <input name="trackingNumber" class="form-control" required maxlength="50" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                <button type="submit" class="btn btn-primary">@L10n.Text("确认发货", "Confirm & dispatch")</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="receiptExceptionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="ReportReceiptException" method="post" class="modal-content">
            <input type="hidden" name="id" id="receiptExceptionOrderId" />
            <div class="modal-header">
                <div>
                    <h2 class="modal-title fs-5 fw-bold">@L10n.Text("记录签收异常", "Record receipt exception")</h2>
                    <p class="text-muted small mb-0" id="receiptExceptionOrderNo"></p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Loc["Cancel"]"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">@L10n.Text("此操作会暂停自动确认，并记录管理员、时间和异常原因。", "This pauses auto-confirmation and records the admin, time and reason.")</p>
                <label for="receiptExceptionReason" class="form-label">@L10n.Text("异常原因", "Exception reason")</label>
                <textarea id="receiptExceptionReason" name="reason" class="form-control" rows="4" maxlength="500" required></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                <button type="submit" class="btn btn-primary">@L10n.Text("确认记录", "Record exception")</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="adminTrackingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title fs-5 fw-bold">@L10n.Text("物流进度", "Delivery progress")</h2>
                    <div class="text-muted small mt-1"><span id="adminTrackingMeta"></span></div>
                    <div class="live-update-indicator mt-1">
                        <span aria-hidden="true"></span>@L10n.Text("每秒实时更新", "Live updates every second")
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Loc["Cancel"]"></button>
            </div>
            <div class="modal-body">
                <div id="adminTrackingTimeline" class="order-tracking-timeline"></div>
                <a id="adminOfficialTrackingLink" href="#" target="_blank" rel="noopener" class="btn btn-outline-primary w-100 mt-3">@L10n.Text("官方物流查询", "Official tracking")</a>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="adminReturnTrackingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title fs-5 fw-bold">@L10n.Text("退货物流", "Return delivery progress")</h2>
                    <div class="text-muted small mt-1"><span id="adminReturnTrackingMeta"></span></div>
                    <div class="live-update-indicator mt-1">
                        <span aria-hidden="true"></span>@L10n.Text("每秒实时更新", "Live updates every second")
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Loc["Cancel"]"></button>
            </div>
            <div class="modal-body">
                <div id="adminReturnTrackingTimeline" class="order-tracking-timeline"></div>
                <a id="adminOfficialReturnTrackingLink" href="#" target="_blank" rel="noopener"
                   class="btn btn-outline-primary w-100 mt-3">
                    @L10n.Text("官方物流查询", "Official tracking")
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-order-updates.js" asp-append-version="true"></script>
    <script src="~/js/admin-after-sales-updates.js" asp-append-version="true"></script>
    <script>
        let adminTrackingPollTimer = null;
        let adminReturnTrackingPollTimer = null;

        function escapeAdminHtml(value) {
            return String(value ?? '').replace(/[&<>"']/g, character => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
            })[character]);
        }

        function openDispatchModal(orderId, orderNo) {
            document.getElementById('dispatchOrderId').value = orderId;
            bootstrap.Modal.getOrCreateInstance(document.getElementById('dispatchModal')).show();
        }

        function openReceiptExceptionModal(orderId, orderNo) {
            document.getElementById('receiptExceptionOrderId').value = orderId;
            document.getElementById('receiptExceptionOrderNo').textContent = orderNo;
            document.getElementById('receiptExceptionReason').value = '';
            bootstrap.Modal.getOrCreateInstance(document.getElementById('receiptExceptionModal')).show();
        }

        function loadAdminTracking(timelineEl, metaEl, linkEl, orderId) {
            return fetch(`/Admin/Orders/OrderTracking?id=${orderId}`)
                .then(r => r.json())
                .then(data => {
                    if (!data.success) { timelineEl.innerHTML = `<div class="alert alert-warning">${escapeAdminHtml(data.message)}</div>`; return; }
                    const t = data.tracking;
                    metaEl.textContent = `${t.carrier} · ${t.trackingNumber}`;
                    linkEl.href = t.officialTrackingUrl || '#';
                    timelineEl.innerHTML = t.nodes.map(node => `
                        <div class="order-tracking-node ${node.isReached ? 'is-reached' : 'is-future'} ${node.isCurrentActive ? 'is-current' : ''}">
                            <div class="order-tracking-dot">${node.isReached ? '✓' : ''}</div>
                            <div class="order-tracking-body">
                                <strong>${escapeAdminHtml(node.title)}</strong>
                                <span class="text-muted">${escapeAdminHtml(node.formattedTime || '')}</span>
                                <p>${escapeAdminHtml(node.description)}</p>
                            </div>
                        </div>`).join('');
                })
                .catch(() => timelineEl.innerHTML = '<div class="alert alert-danger">Failed to load tracking.</div>');
        }

        function openAdminTrackingModal(orderId) {
            const timelineEl = document.getElementById('adminTrackingTimeline');
            const metaEl = document.getElementById('adminTrackingMeta');
            const linkEl = document.getElementById('adminOfficialTrackingLink');
            timelineEl.innerHTML = '<div class="text-center text-muted py-4">Loading…</div>';
            bootstrap.Modal.getOrCreateInstance(document.getElementById('adminTrackingModal')).show();
            loadAdminTracking(timelineEl, metaEl, linkEl, orderId);
            if (adminTrackingPollTimer) clearInterval(adminTrackingPollTimer);
            adminTrackingPollTimer = setInterval(
                () => loadAdminTracking(timelineEl, metaEl, linkEl, orderId),
                1000
            );
        }

        document.getElementById('adminTrackingModal')?.addEventListener('hidden.bs.modal', function () {
            if (adminTrackingPollTimer) {
                clearInterval(adminTrackingPollTimer);
                adminTrackingPollTimer = null;
            }
        });

        function loadAdminReturnTracking(requestId) {
            const timelineEl = document.getElementById('adminReturnTrackingTimeline');
            const metaEl = document.getElementById('adminReturnTrackingMeta');
            const linkEl = document.getElementById('adminOfficialReturnTrackingLink');
            return fetch(`/Admin/Orders/ReturnTracking?id=${requestId}`)
                .then(response => response.json())
                .then(data => {
                    if (!data.success) {
                        timelineEl.innerHTML = `<div class="alert alert-warning">${escapeAdminHtml(data.message)}</div>`;
                        return;
                    }
                    const tracking = data.tracking;
                    metaEl.textContent = `${tracking.carrier} · ${tracking.trackingNumber}`;
                    linkEl.href = tracking.officialTrackingUrl || '#';
                    timelineEl.innerHTML = tracking.nodes.map(node => `
                        <div class="order-tracking-node ${node.isReached ? 'is-reached' : 'is-future'} ${node.isCurrentActive ? 'is-current' : ''}">
                            <div class="order-tracking-dot">${node.isReached ? '✓' : ''}</div>
                            <div class="order-tracking-body">
                                <strong>${escapeAdminHtml(node.title)}</strong>
                                <span class="text-muted">${escapeAdminHtml(node.formattedTime || '')}</span>
                                <p>${escapeAdminHtml(node.description)}</p>
                            </div>
                        </div>`).join('');
                })
                .catch(() => {
                    timelineEl.innerHTML = '<div class="alert alert-danger">Failed to load return tracking.</div>';
                });
        }

        function openAdminReturnTrackingModal(requestId) {
            const timelineEl = document.getElementById('adminReturnTrackingTimeline');
            timelineEl.innerHTML = '<div class="text-center text-muted py-4">Loading…</div>';
            bootstrap.Modal.getOrCreateInstance(document.getElementById('adminReturnTrackingModal')).show();
            loadAdminReturnTracking(requestId);
            if (adminReturnTrackingPollTimer) clearInterval(adminReturnTrackingPollTimer);
            adminReturnTrackingPollTimer = setInterval(
                () => loadAdminReturnTracking(requestId),
                1000
            );
        }

        document.getElementById('adminReturnTrackingModal')?.addEventListener('hidden.bs.modal', function () {
            if (adminReturnTrackingPollTimer) {
                clearInterval(adminReturnTrackingPollTimer);
                adminReturnTrackingPollTimer = null;
            }
        });
    </script>
}
