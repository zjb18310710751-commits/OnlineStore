@model CategoryFormViewModel
@{
    ViewData["Title"] = Loc["CreateCategory"].Value;
}
<h1 class="h4 mb-4">@Loc["CreateCategory"]</h1>
<form asp-area="Admin" asp-controller="Categories" asp-action="Create" method="post" class="card card-body shadow-sm">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label">@Loc["CategoryName"]</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label">@Loc["CategoryDescription"]</label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DisplayOrder" class="form-label">@Loc["DisplayOrder"]</label>
        <input asp-for="DisplayOrder" class="form-control" type="number" />
        <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
    </div>
    <div>
        <button type="submit" class="btn btn-primary">@Loc["Save"]</button>
        <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="btn btn-outline-secondary">@Loc["Cancel"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
