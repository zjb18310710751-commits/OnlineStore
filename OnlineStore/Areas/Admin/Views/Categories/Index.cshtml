@model PagedResult<Category>
@{
    ViewData["Title"] = Loc["CategoryManagement"].Value;
    var pagination = new AdminPaginationViewModel { Action = "Index", Controller = "Categories", Page = Model.Page, TotalPages = Model.TotalPages };
}
<div class="admin-store-heading">
    <div>
        <p class="admin-store-eyebrow">@L10n.Text("商店结构", "Storefront structure")</p>
        <h1>@Loc["CategoryManagement"]</h1>
        <p class="admin-store-intro">@L10n.Text("组织商品分类、展示顺序和分类说明。", "Organize product categories, display order and descriptions.")</p>
    </div>
    <a asp-area="Admin" asp-controller="Categories" asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i>@Loc["AddCategory"]</a>
</div>

<div class="card shadow-sm">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th style="width:80px">@Loc["DisplayOrder"]</th>
                <th>@Loc["Name"]</th>
                <th>@Loc["Description"]</th>
                <th class="text-end">@Loc["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.TotalCount == 0)
            {
                <tr><td colspan="4" class="text-center text-muted py-4">@Loc["NoCategories"]</td></tr>
            }
            @foreach (var c in Model.Items)
            {
                <tr>
                    <td>@c.DisplayOrder</td>
                    <td class="fw-semibold">@L10n.Name(c)</td>
                    <td class="text-muted">@L10n.Description(c)</td>
                    <td class="text-end text-nowrap">
                        <div class="admin-icon-actions">
                            <a asp-area="Admin" asp-controller="Categories" asp-action="Edit" asp-route-id="@c.Id"
                               class="admin-icon-action" title="@Loc["Edit"]" aria-label="@Loc["Edit"]">
                                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                            </a>
                            <form asp-area="Admin" asp-controller="Categories" asp-action="Delete" asp-route-id="@c.Id"
                                  method="post" class="d-inline" data-confirm="@Loc["ConfirmDeleteCategory"]"
                                  onsubmit="return confirm(this.dataset.confirm);">
                                <button type="submit" class="admin-icon-action is-danger"
                                        title="@Loc["Delete"]" aria-label="@Loc["Delete"]">
                                    <i class="bi bi-trash3" aria-hidden="true"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<partial name="_AdminPagination" model="pagination" />
