@model IReadOnlyList<Category>
@{
    ViewData["Title"] = Loc["CategoryManagement"].Value;
}
<div class="admin-store-heading">
    <div>
        <p class="admin-store-eyebrow">@L10n.Text("商店结构", "Storefront structure")</p>
        <h1>@Loc["CategoryManagement"]</h1>
        <p class="admin-store-intro">@L10n.Text("组织商品分类、展示顺序和分类说明。", "Organize product categories, display order and descriptions.")</p>
    </div>
    <a asp-area="Admin" asp-controller="Categories" asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i>@Loc["AddCategory"]</a>
</div>

<div class="card shadow-sm">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th style="width:80px">@Loc["DisplayOrder"]</th>
                <th>@Loc["Name"]</th>
                <th>@Loc["Description"]</th>
                <th class="text-end">@Loc["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="4" class="text-center text-muted py-4">@Loc["NoCategories"]</td></tr>
            }
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.DisplayOrder</td>
                    <td class="fw-semibold">@c.Name</td>
                    <td class="text-muted">@L10n.Description(c)</td>
                    <td class="text-end text-nowrap">
                        <a asp-area="Admin" asp-controller="Categories" asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary" title="@Loc["Edit"]"><i class="bi bi-pencil"></i></a>
                        <form asp-area="Admin" asp-controller="Categories" asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" data-confirm="@Loc["ConfirmDeleteCategory"]" onsubmit="return confirm(this.dataset.confirm);">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="@Loc["Delete"]"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
