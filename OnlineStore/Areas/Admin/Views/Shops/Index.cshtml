@model PagedResult<Shop>
@{
    ViewData["Title"] = Loc["ShopManagement"].Value;
    var pagination = new AdminPaginationViewModel { Action = "Index", Controller = "Shops", Page = Model.Page, TotalPages = Model.TotalPages };
}
<div class="admin-store-heading">
    <div>
        <p class="admin-store-eyebrow">@L10n.Text("品牌与店铺", "Brands and merchants")</p>
        <h1>@Loc["ShopManagement"]</h1>
        <p class="admin-store-intro">@L10n.Text("维护店铺资料、评分和销售信息。", "Maintain store profiles, ratings and sales information.")</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i>@Loc["AddShop"]</a>
</div>
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Loc["ShopName"]</th>
                    <th>@Loc["ShopRating"]</th>
                    <th>@Loc["SalesCount"]</th>
                    <th>@Loc["ShopDescription"]</th>
                    <th class="text-end">@Loc["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.TotalCount == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">@Loc["NoShops"]</td></tr>
                }
                @foreach (var s in Model.Items)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="admin-shop-logo">
                                    @if (!string.IsNullOrWhiteSpace(s.LogoUrl))
                                    {
                                        <img src="@s.LogoUrl" alt="" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-shop"></i>
                                    }
                                </span>
                                <span class="fw-semibold">@L10n.Name(s)</span>
                            </div>
                        </td>
                        <td><span class="text-warning">★</span> @s.Rating.ToString("0.0")</td>
                        <td>@s.SalesCount</td>
                        <td class="text-muted">@L10n.Description(s)</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary" title="@Loc["Edit"]"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline" data-confirm="@Loc["ConfirmDeleteShop"]" onsubmit="return confirm(this.dataset.confirm);">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="@Loc["Delete"]"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_AdminPagination" model="pagination" />
