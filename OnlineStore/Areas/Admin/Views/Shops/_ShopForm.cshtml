@model Shop
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="mb-3">
    <label asp-for="Name" class="form-label">@Loc["ShopName"]</label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger small"></span>
</div>
<div class="mb-3">
    <label asp-for="NameEn" class="form-label">@Loc["ShopNameEn"]</label>
    <input asp-for="NameEn" class="form-control" />
    <span asp-validation-for="NameEn" class="text-danger small"></span>
</div>
<div class="row g-3">
    <div class="col-md-6 mb-3">
        <label asp-for="Rating" class="form-label">@Loc["ShopRating"]</label>
        <input asp-for="Rating" class="form-control" type="number" step="0.1" min="0" max="5" />
        <span asp-validation-for="Rating" class="text-danger small"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="SalesCount" class="form-label">@Loc["SalesCount"]</label>
        <input asp-for="SalesCount" class="form-control" type="number" min="0" />
        <span asp-validation-for="SalesCount" class="text-danger small"></span>
    </div>
</div>
<div class="mb-3">
    <label asp-for="Description" class="form-label">@Loc["ShopDescription"]</label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Description" class="text-danger small"></span>
</div>
<div class="mb-3">
    <label asp-for="DescriptionEn" class="form-label">@Loc["ShopDescriptionEn"]</label>
    <textarea asp-for="DescriptionEn" class="form-control" rows="3"></textarea>
    <span asp-validation-for="DescriptionEn" class="text-danger small"></span>
</div>
